        {
          "refId": "A",
          "expr": "sum by (group) (rate(http_requests_total{instance=~\"$instance\",group!~\"raft|internal|health\"}[$__rate_interval]))",
          "legendFormat": "{{group}}"
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Sign-ins per second, by status",
