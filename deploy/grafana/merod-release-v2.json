{
  "title": "merod (release-v2)",
  "uid": "merod-release-v2",
  "tags": [
    "calimero",
    "merod"
  ],
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "description": "Counts, latency, errors, Raft, disk and process from merod's --metrics-listen. HTTP, build-info, process and storage metrics keep v1's names. No label carries an app, account or org id.",
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "label": "Data source"
      },
      {
        "name": "instance",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": "label_values(calimero_build_info, instance)",
        "includeAll": true,
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "label": "Node",
        "refresh": 2
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Cluster",
      "collapsed": false,
      "gridPos": {
        "w": 24,
        "h": 1,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Nodes",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "w": 4,
        "h": 4,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(calimero_cluster_nodes{instance=~\"$instance\"})",
          "legendFormat": "nodes"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "App instances",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "w": 4,
        "h": 4,
        "x": 4,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(calimero_apps{instance=~\"$instance\"})",
          "legendFormat": "apps"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Accounts",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "w": 4,
        "h": 4,
        "x": 8,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(calimero_accounts{instance=~\"$instance\"})",
          "legendFormat": "accounts"
        }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Organizations",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "w": 4,
        "h": 4,
        "x": 12,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(calimero_orgs{instance=~\"$instance\"})",
          "legendFormat": "orgs"
        }
      ]
    },
    {
      "id": 6,
      "type": "stat",
      "title": "System leaders (must be 1)",
      "description": "Exactly one node should lead the system group.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "w": 4,
        "h": 4,
        "x": 16,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(calimero_group_leader{instance=~\"$instance\",group=\"system\"})",
          "legendFormat": "leaders"
        }
      ]
    },
    {
      "id": 7,
      "type": "stat",
      "title": "Releases running",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "w": 4,
        "h": 4,
        "x": 20,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count by (release) (calimero_build_info{instance=~\"$instance\"})",
          "legendFormat": "{{release}}"
        }
      ]
    },
    {
      "id": 8,
      "type": "row",
      "title": "Usage",
      "collapsed": false,
      "gridPos": {
        "w": 24,
        "h": 1,
        "x": 0,
        "y": 5
      },
      "panels": []
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Calls and views per second, by status",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "w": 12,
        "h": 8,
        "x": 0,
        "y": 6
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status) (rate(http_requests_total{instance=~\"$instance\",group=\"calls\"}[$__rate_interval]))",
          "legendFormat": "calls {{status}}"
        },
        {
          "refId": "B",
          "expr": "sum by (status) (rate(http_requests_total{instance=~\"$instance\",group=\"views\"}[$__rate_interval]))",
          "legendFormat": "views {{status}}"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Requests per second, by route group",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "w": 12,
        "h": 8,
        "x": 12,
        "y": 6
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
