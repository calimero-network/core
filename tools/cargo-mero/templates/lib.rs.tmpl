use calimero_sdk::app;
use calimero_sdk::serde::Serialize;
use calimero_storage::collections::{LwwRegister, UnorderedMap};
use thiserror::Error;

// The app's persisted state. `#[app::state]` makes it the CRDT root; the
// `emits` clause names the event type this app can broadcast. Every field must
// be a CRDT collection so concurrent edits on different nodes converge - here a
// map of keys to last-writer-wins string registers.
#[app::state(emits = for<'a> Event<'a>)]
pub struct {{name_pascal}} {
    items: UnorderedMap<String, LwwRegister<String>>,
}

// Events are broadcast to other nodes and to app subscribers when state
// changes. Borrow (`&'a str`) to avoid cloning into the event.
#[app::event]
pub enum Event<'a> {
    Set { key: &'a str, value: &'a str },
}

// Logic methods return `app::Result<T>`; this is the error side. Deriving
// `Serialize` lets the node surface it to callers.
#[derive(Debug, Error, Serialize)]
#[serde(crate = "calimero_sdk::serde")]
#[serde(tag = "kind", content = "data")]
pub enum Error<'a> {
    #[error("key not found: {0}")]
    NotFound(&'a str),
}

#[app::logic]
impl {{name_pascal}} {
    // `#[app::init]` runs once when the app is first installed on a node.
    #[app::init]
    pub fn init() -> {{name_pascal}} {
        {{name_pascal}} {
            items: UnorderedMap::new(),
        }
    }

    // A mutating method: takes `&mut self`, changes state, and emits an event so
    // peers learn about the change.
    pub fn set(&mut self, key: String, value: String) -> app::Result<()> {
        app::log!("set {:?} = {:?}", key, value);
        app::emit!(Event::Set {
            key: &key,
            value: &value,
        });
        self.items.insert(key, LwwRegister::new(value))?;
        Ok(())
    }

    // `#[app::view]` marks a read-only (`&self`) method the node can serve
    // without a state-changing transaction.
    #[app::view]
    pub fn get(&self, key: &str) -> app::Result<String> {
        app::log!("get {:?}", key);
        let Some(value) = self.items.get(key)? else {
            app::bail!(Error::NotFound(key));
        };
        Ok(value.get().clone())
    }
}

// TestHost drives the app with a native mock host, so state, events, and the
// CRDT collections all behave as they would on a node - under a plain
// `cargo test`, no node required. Read this as the app's teaching example.
#[cfg(test)]
mod tests {
    use calimero_sdk::testing::TestHost;

    use super::*;

    #[test]
    fn set_then_get_returns_the_value() {
        let mut app = TestHost::new({{name_pascal}}::init);

        app.call(|s| s.set("hello".into(), "world".into())).unwrap();

        assert_eq!(
            app.view(|s| s.get("hello")).unwrap(),
            "world".to_owned(),
        );
    }

    #[test]
    fn set_emits_one_event() {
        let mut app = TestHost::new({{name_pascal}}::init);

        app.call(|s| s.set("k".into(), "v".into())).unwrap();

        assert_eq!(app.events().len(), 1);
    }
}
