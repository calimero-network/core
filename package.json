{
  "name": "@calimero-network/mero-js",
  "version": "35.3.0",
  "description": "JavaScript client for Calimero 1.0: attested TEE nodes, a sealed channel, passkeys and API keys",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "browser": "./dist/index.browser.mjs",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs",
      "default": "./dist/index.mjs"
    },
    "./runtime": {
      "types": "./dist/runtime/index.d.ts",
      "browser": "./dist/runtime.browser.mjs",
      "import": "./dist/runtime.mjs",
      "require": "./dist/runtime.cjs",
      "default": "./dist/runtime.mjs"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "dependencies": {
    "@noble/hashes": "2.4.0",
    "@phala/dcap-qvl": "0.5.3",
    "openapi-fetch": "0.17.0"
  },
  "devDependencies": {
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^13.0.0",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^9.2.6",
    "@semantic-release/npm": "^12.0.1",
    "@semantic-release/release-notes-generator": "^12.1.0",
    "@types/node": "^18.19.34",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "conventional-changelog-conventionalcommits": "^9.3.1",
    "esbuild": "^0.28.1",
    "eslint": "^8.57.0",
    "openapi-typescript": "7.13.0",
    "rimraf": "^3.0.0",
    "semantic-release": "^24.2.9",
    "typescript": "5.6.3",
    "vite": "^7.3.7",
    "vitest": "^4.1.12"
  },
  "scripts": {
    "build": "tsc && esbuild src/index.ts --bundle --platform=neutral --external:@phala/dcap-qvl --target=es2020 --format=esm --outfile=dist/index.mjs --sourcemap && esbuild src/index.ts --bundle --platform=neutral --external:@phala/dcap-qvl --target=es2020 --format=cjs --outfile=dist/index.cjs --sourcemap && esbuild src/index.ts --bundle --platform=browser --external:@phala/dcap-qvl --target=es2020 --format=esm --outfile=dist/index.browser.mjs --sourcemap --minify && node scripts/runtime-entries.mjs",
    "prepare": "npm run build",
    "test": "vitest run --passWithNoTests",
    "test:unit": "vitest run --config vitest.config.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "eslint": "eslint .",
    "typecheck": "tsc --noEmit",
    "typecheck:consumer": "tsc --noEmit -p tsconfig.consumer.json",
    "typecheck:tests": "tsc --noEmit -p tsconfig.test.json",
    "tsc": "tsc -b",
    "clean": "pnpm rimraf dist",
    "prepublishOnly": "pnpm clean && pnpm build && pnpm test:unit && pnpm lint && pnpm typecheck && pnpm typecheck:consumer && pnpm typecheck:tests",
    "test:cluster": "vitest run --config vitest.cluster.config.ts",
    "gen:api": "openapi-typescript openapi/core-openapi.json -o src/generated/api.ts && node scripts/gen-methods.mjs",
    "check:api": "pnpm gen:api && git diff --exit-code -- src/generated",
    "refresh:openapi": "scripts/refresh-openapi.sh",
    "refresh:receipt-vectors": "scripts/refresh-receipt-vectors.sh"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "calimero",
    "mero",
    "javascript",
    "tee",
    "confidential-computing",
    "passkeys",
    "sdk"
  ],
  "license": "MIT",
  "author": "Calimero Ltd",
  "repository": {
    "type": "git",
    "url": "https://github.com/calimero-network/mero-js",
    "directory": "mero-js"
  },
  "homepage": "https://github.com/calimero-network/mero-js/blob/master/README.md",
  "bugs": {
    "url": "https://github.com/calimero-network/mero-js/issues"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "packageManager": "pnpm@10.14.0+sha512.ad27a79641b49c3e481a16a805baa71817a04bbe06a38d17e60e2eaee83f6a146c6a688125f5792e48dd5ba30e7da52a5cda4c3992b9ccf333f9ce223af84748",
  "pnpm": {
    "overrides": {
      "handlebars": ">=4.7.10 <5",
      "brace-expansion@<2": ">=1.1.21 <2",
      "flatted": ">=3.4.2 <4",
      "js-yaml@>=4 <5": ">=4.3.2 <5",
      "lodash": ">=4.18.0 <5",
      "lodash-es": ">=4.18.0 <5",
      "minimatch@<3.1.3": ">=3.1.3 <4",
      "nanoid@<4": ">=3.3.12 <4",
      "postcss": ">=8.5.23 <9",
      "undici@>=7 <8": ">=7.30.1 <8",
      "source-map-js": ">=1.2.2 <2",
      "picomatch@<3": ">=2.3.2 <3",
      "picomatch@>=4 <5": ">=4.0.4 <5",
      "rollup": ">=4.59.0 <5"
    }
  }
}
