{
  "name": "44 - A context reports the release it runs, not the latest install (2-node)",
  "description": "Node 2 joins a v1 context, then installs v2 ahead of the admin's upgrade. v1 and v2 share one application id, so the application row now names v2 while the context still runs v1: GET /admin-api/contexts/{id} must say 1.0.0. The admin then cascades the namespace to v2 and node 2 activates it; from then on the context reports 2.0.0.\n",
  "comment": [
    "Migrated from this file's v1 workflow by `merobox cloud port`.",
    "Each of the original scenario's nodes is an account here; see merobox/cloud_v2/port.py for the mapping.",
    "Dropped (no counterpart in this node):",
    "  assert_api_response x3: v1 admin API",
    "  delete_context (unknown) x1: checks what the dropped steps did",
    "  delete_namespace x1: v1 namespace deletion",
    "  script x1: scripts drive v1 node RPC URLs",
    "  wait_for_sync x1: replication is synchronous: a read sees every committed write",
    "Fixed in the migration (converter bugs): a cascade upgrade_group",
    "upgrades every app in the namespace's teams; of get_migration_status",
    "only the outputs that mean the same here are kept."
  ],
  "cluster": {
    "nodes": 3
  },
  "accounts": [
    "app-migration-running-1",
    "app-migration-running-2"
  ],
  "steps": [
    {
      "name": "Install scenario-pure-bugfix-v1 on node 1",
      "type": "install_package",
      "mpk": "{{env.CORE_WASM_DIR}}/dist/com.calimero.scenario-pure-bugfix-1.0.0.mpk",
      "outputs": {
        "app_v1": "package",
        "app_v1_version": "version"
      },
      "account": "app-migration-running-1"
    },
    {
      "name": "Create namespace (v1) on node 1",
      "type": "create_org",
      "org_name": "Create namespace (v1) on node 1",
      "outputs": {
        "namespace_id": "orgId"
      },
      "account": "app-migration-running-1"
    },
    {
      "name": "Create Open subgroup under namespace",
      "type": "create_team",
      "org": "{{namespace_id}}",
      "team_name": "running-scenario-subgroup",
      "join": "invite",
      "outputs": {
        "group_id": "teamId"
      },
      "account": "app-migration-running-1"
    },
    {
      "name": "Mark subgroup as Open",
      "type": "team_update",
      "org": "{{namespace_id}}",
      "team": "{{group_id}}",
      "join": "everyone",
      "account": "app-migration-running-1"
    },
    {
      "name": "Create context in subgroup on node 1 (v1)",
      "type": "deploy",
      "account": "app-migration-running-1",
      "package": "{{app_v1}}",
      "version": "{{app_v1_version}}",
      "app_name": "Create context in subgroup on node 1 (v1)",
      "org": "{{namespace_id}}",
      "access": {
        "kind": "team",
        "team": "{{group_id}}"
      },
      "outputs": {
        "ctx_id": "contextId"
      }
    },
    {
      "name": "Write v1 item k1=10 on node 1",
      "type": "call",
      "app": "{{ctx_id}}",
      "method": "add_value",
      "args": {
        "key": "k1",
        "value": 10
      },
      "account": "app-migration-running-1"
    },
    {
      "name": "Create namespace invitation for node 2",
      "type": "invite",
      "org": "{{namespace_id}}",
      "role": "member",
      "account": "app-migration-running-1",
      "outputs": {
        "namespace_invitation": "token"
      }
    },
    {
      "name": "Node 2 joins namespace",
      "type": "redeem_invite",
      "token": "{{namespace_invitation}}",
      "account": "app-migration-running-2"
    },
    {
      "name": "Node 2 materialises subgroup membership via inheritance",
      "type": "team_join",
      "org": "{{namespace_id}}",
      "team": "{{group_id}}",
      "account": "app-migration-running-2"
    },
    {
      "name": "Node 2 installs v2 ahead of the upgrade",
      "type": "install_package",
      "mpk": "{{env.CORE_WASM_DIR}}/dist/com.calimero.scenario-pure-bugfix-2.0.0.mpk",
      "outputs": {
        "app_v2": "package",
        "app_v2_version": "version"
      },
      "account": "app-migration-running-2"
    },
    {
      "name": "Both releases share one application id",
      "type": "json_assert",
      "statements": [
        "equal(\"{{app_v2}}\", \"{{app_v1}}\")"
      ]
    },
    {
      "name": "Node 2 runs v1",
      "type": "call",
      "app": "{{ctx_id}}",
      "method": "sum_all_values",
      "args": {},
      "account": "app-migration-running-2",
      "outputs": {
        "sum_before": "rpc"
      }
    },
    {
      "name": "Assert the off-by-one v1 sum on node 2",
      "type": "json_assert",
      "statements": [
        "json_equal({{sum_before}}, {\"output\": 11})"
      ]
    },
    {
      "name": "Cascade namespace v1 to v2 (initiated by node 1)",
      "type": "upgrade_app",
      "app": "{{ctx_id}}",
      "version": "{{app_v2_version}}",
      "account": "app-migration-running-1"
    },
    {
      "name": "Wait for the cascade to reach node 2",
      "type": "wait",
      "seconds": 15.0
    },
    {
      "name": "Node 2 runs the fixed release",
      "type": "call",
      "app": "{{ctx_id}}",
      "method": "sum_all_values",
      "args": {},
      "account": "app-migration-running-2",
      "outputs": {
        "sum_after": "rpc"
      }
    },
    {
      "name": "Assert the fixed sum on node 2",
      "type": "json_assert",
      "statements": [
        "json_equal({{sum_after}}, {\"output\": 10})"
      ]
    },
    {
      "name": "Delete subgroup",
      "type": "team_delete",
      "org": "{{namespace_id}}",
      "team": "{{group_id}}",
      "account": "app-migration-running-1"
    }
  ]
}
