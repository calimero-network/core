{
  "name": "35 — Two namespaces coexist on different versions (1-node)",
  "description": "Per-context bytecode binding (multi-version coexistence). One node hosts TWO namespaces created from the same v1 bundle (migration-suite, version-stable ApplicationId). Installing v2 and upgrading only namespace A's subgroup must NOT change what namespace B executes: the application row is a download-cache pointer; each context loads the bytecode its group's bytecode_id / activation marker points at.\nPre-binding this fails: the second install (and the lazy upgrade's in-place reinstall) flipped the shared row, so B's context compiled the v2 binary against its v1-shaped state (\"Not all bytes read\" deserialization failure on the next B call). Post-binding, B keeps answering the v1 schema — even after fresh writes on B — until B is upgraded itself, after which both namespaces answer v2.\n",
  "comment": [
    "Migrated from this file's v1 workflow by `merobox cloud port`.",
    "Each of the original scenario's nodes is an account here; see merobox/cloud_v2/port.py for the mapping.",
    "Dropped (no counterpart in this node):",
    "  delete_context (unknown) x2: checks what the dropped steps did",
    "  delete_namespace x2: v1 namespace deletion",
    "  uninstall_application (unknown) x1: checks what the dropped steps did",
    "Fixed in the migration (converter bugs): a cascade upgrade_group",
    "upgrades every app in the namespace's teams; of get_migration_status",
    "only the outputs that mean the same here are kept."
  ],
  "cluster": {
    "nodes": 3
  },
  "accounts": [
    "app-migration-coexist-1"
  ],
  "steps": [
    {
      "name": "Install migration-suite-v1",
      "type": "install_package",
      "mpk": "{{env.CORE_WASM_DIR}}/dist/com.calimero.migration-suite-1.0.0.mpk",
      "outputs": {
        "app_v1": "package",
        "app_v1_version": "version"
      },
      "account": "app-migration-coexist-1"
    },
    {
      "name": "Create namespace A",
      "type": "create_org",
      "org_name": "Create namespace A",
      "outputs": {
        "namespace_a": "orgId"
      },
      "account": "app-migration-coexist-1"
    },
    {
      "name": "Create subgroup in namespace A",
      "type": "create_team",
      "org": "{{namespace_a}}",
      "team_name": "coexist-a",
      "join": "invite",
      "outputs": {
        "group_a": "teamId"
      },
      "account": "app-migration-coexist-1"
    },
    {
      "name": "Create context in subgroup A (v1)",
      "type": "deploy",
      "account": "app-migration-coexist-1",
      "package": "{{app_v1}}",
      "version": "{{app_v1_version}}",
      "app_name": "Create context in subgroup A (v1)",
      "org": "{{namespace_a}}",
      "access": {
        "kind": "team",
        "team": "{{group_a}}"
      },
      "outputs": {
        "ctx_a": "contextId"
      }
    },
    {
      "name": "Create namespace B",
      "type": "create_org",
      "org_name": "Create namespace B",
      "outputs": {
        "namespace_b": "orgId"
      },
      "account": "app-migration-coexist-1"
    },
    {
      "name": "Create subgroup in namespace B",
      "type": "create_team",
      "org": "{{namespace_b}}",
      "team_name": "coexist-b",
      "join": "invite",
      "outputs": {
        "group_b": "teamId"
      },
      "account": "app-migration-coexist-1"
    },
    {
      "name": "Create context in subgroup B (v1)",
      "type": "deploy",
      "account": "app-migration-coexist-1",
      "package": "{{app_v1}}",
      "version": "{{app_v1_version}}",
      "app_name": "Create context in subgroup B (v1)",
      "org": "{{namespace_b}}",
      "access": {
        "kind": "team",
        "team": "{{group_b}}"
      },
      "outputs": {
        "ctx_b": "contextId"
      }
    },
    {
      "name": "Write v1 state in A",
      "type": "call",
      "app": "{{ctx_a}}",
      "method": "set_description",
      "args": {
        "description": "namespace-a"
      },
      "account": "app-migration-coexist-1"
    },
    {
      "name": "Write v1 state in B",
      "type": "call",
      "app": "{{ctx_b}}",
      "method": "set_description",
      "args": {
        "description": "namespace-b"
      },
      "account": "app-migration-coexist-1"
    },
    {
      "name": "Read v1 schema in A (sanity)",
      "type": "call",
      "app": "{{ctx_a}}",
      "method": "schema_info",
      "args": {},
      "account": "app-migration-coexist-1",
      "outputs": {
        "a_schema_v1": "rpc"
      }
    },
    {
      "name": "Read v1 schema in B (sanity)",
      "type": "call",
      "app": "{{ctx_b}}",
      "method": "schema_info",
      "args": {},
      "account": "app-migration-coexist-1",
      "outputs": {
        "b_schema_v1": "rpc"
      }
    },
    {
      "name": "Assert both namespaces start on v1",
      "type": "json_assert",
      "statements": [
        "json_subset({{a_schema_v1}}, {\"output\": {\"schema_version\": \"1.0.0\", \"description\": \"namespace-a\"}})",
        "json_subset({{b_schema_v1}}, {\"output\": {\"schema_version\": \"1.0.0\", \"description\": \"namespace-b\"}})"
      ]
    },
    {
      "name": "Install migration-suite-v2-add-field",
      "type": "install_package",
      "mpk": "{{env.CORE_WASM_DIR}}/dist/com.calimero.migration-suite-2.0.0.mpk",
      "outputs": {
        "app_v2": "package",
        "app_v2_version": "version"
      },
      "account": "app-migration-coexist-1"
    },
    {
      "name": "Assert both versions share one application id (bundle same-id)",
      "type": "json_assert",
      "statements": [
        "equal(\"{{app_v1}}\", \"{{app_v2}}\")"
      ]
    },
    {
      "name": "Upgrade ONLY subgroup A to v2",
      "type": "upgrade_app",
      "app": "{{ctx_a}}",
      "version": "{{app_v2_version}}",
      "account": "app-migration-coexist-1"
    },
    {
      "name": "Wait for upgrade to apply",
      "type": "wait",
      "seconds": 10.0
    },
    {
      "name": "Read schema in A (triggers A's lazy migration)",
      "type": "call",
      "app": "{{ctx_a}}",
      "method": "schema_info",
      "args": {},
      "account": "app-migration-coexist-1",
      "outputs": {
        "a_schema_v2": "rpc"
      }
    },
    {
      "name": "Assert A migrated to v2 with data preserved",
      "type": "json_assert",
      "statements": [
        "json_subset({{a_schema_v2}}, {\"output\": {\"schema_version\": \"2.0.0\", \"description\": \"namespace-a\"}})",
        "json_subset({{a_schema_v2}}, {\"output\": {\"notes\": \"added in v2\"}})"
      ]
    },
    {
      "name": "Activity on B after A's upgrade (v1 write must still work)",
      "type": "call",
      "app": "{{ctx_b}}",
      "method": "increment_counter",
      "args": {},
      "account": "app-migration-coexist-1"
    },
    {
      "name": "Read schema in B after activity",
      "type": "call",
      "app": "{{ctx_b}}",
      "method": "schema_info",
      "args": {},
      "account": "app-migration-coexist-1",
      "outputs": {
        "b_schema_after_a_upgrade": "rpc"
      }
    },
    {
      "name": "Assert B still executes v1 (the row flip must not leak into B)",
      "type": "json_assert",
      "statements": [
        "json_subset({{b_schema_after_a_upgrade}}, {\"output\": {\"schema_version\": \"1.0.0\", \"description\": \"namespace-b\", \"counter\": \"1\"}})"
      ]
    },
    {
      "name": "Upgrade subgroup B to v2",
      "type": "upgrade_app",
      "app": "{{ctx_b}}",
      "version": "{{app_v2_version}}",
      "account": "app-migration-coexist-1"
    },
    {
      "name": "Wait for B's upgrade to apply",
      "type": "wait",
      "seconds": 10.0
    },
    {
      "name": "Read schema in B (triggers B's lazy migration)",
      "type": "call",
      "app": "{{ctx_b}}",
      "method": "schema_info",
      "args": {},
      "account": "app-migration-coexist-1",
      "outputs": {
        "b_schema_v2": "rpc"
      }
    },
    {
      "name": "Assert B migrated to v2 with its own data preserved",
      "type": "json_assert",
      "statements": [
        "json_subset({{b_schema_v2}}, {\"output\": {\"schema_version\": \"2.0.0\", \"description\": \"namespace-b\", \"counter\": \"1\"}})",
        "json_subset({{b_schema_v2}}, {\"output\": {\"notes\": \"added in v2\"}})"
      ]
    },
    {
      "name": "Re-read schema in A (A unaffected by B's upgrade)",
      "type": "call",
      "app": "{{ctx_a}}",
      "method": "schema_info",
      "args": {},
      "account": "app-migration-coexist-1",
      "outputs": {
        "a_schema_final": "rpc"
      }
    },
    {
      "name": "Assert A still v2 with its own data",
      "type": "json_assert",
      "statements": [
        "json_subset({{a_schema_final}}, {\"output\": {\"schema_version\": \"2.0.0\", \"description\": \"namespace-a\"}})"
      ]
    },
    {
      "name": "Delete subgroup A",
      "type": "team_delete",
      "org": "{{namespace_a}}",
      "team": "{{group_a}}",
      "account": "app-migration-coexist-1"
    },
    {
      "name": "Delete subgroup B",
      "type": "team_delete",
      "org": "{{namespace_b}}",
      "team": "{{group_b}}",
      "account": "app-migration-coexist-1"
    }
  ]
}
