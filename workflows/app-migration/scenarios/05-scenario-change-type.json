{
  "name": "05 — Scenario \"change type\" (v4-rename-field → v5-change-type, 2-node)",
  "description": "2-node per-context migration for the type-change scenario. v4-rename-field has `counter: LwwRegister<u64>` and an `increment_counter()` method. v5-change-type changes the in-state type to `LwwRegister<String>` and swaps `increment_counter()` for an explicit `set_counter(String)`. `migrate_v4_to_v5` stringifies the pre-migration u64 value so the existing counter survives the type change.\nThis row of the scenario matrix proves that an explicit-migrate type-change keeps the field value intact (just re-typed) on BOTH nodes and that the new v5 method (set_counter) becomes callable while the v4 method (increment_counter) goes away. Phase 7d round-trips set_counter(String) on node 1 → get_counter on node 2.\n",
  "comment": [
    "Migrated from this file's v1 workflow by `merobox cloud port`.",
    "Each of the original scenario's nodes is an account here; see merobox/cloud_v2/port.py for the mapping.",
    "Dropped (no counterpart in this node):",
    "  assert_log_present x2: v1 node logs",
    "  assert_migration_complete x1: v1 group migration",
    "  delete_context (unknown) x1: checks what the dropped steps did",
    "  delete_namespace x1: v1 namespace deletion",
    "  uninstall_application (unknown) x1: checks what the dropped steps did",
    "  wait_for_sync x2: replication is synchronous: a read sees every committed write",
    "Fixed in the migration (converter bugs): a cascade upgrade_group",
    "upgrades every app in the namespace's teams; of get_migration_status",
    "only the outputs that mean the same here are kept."
  ],
  "cluster": {
    "nodes": 3
  },
  "accounts": [
    "app-migration-typechange-1",
    "app-migration-typechange-2"
  ],
  "steps": [
    {
      "name": "Install migration-suite-v4-rename-field on node 1",
      "type": "install_package",
      "mpk": "{{env.CORE_WASM_DIR}}/dist/com.calimero.migration-suite-4.0.0.mpk",
      "outputs": {
        "app_v4": "package",
        "app_v4_version": "version"
      },
      "account": "app-migration-typechange-1"
    },
    {
      "name": "Create namespace (v4) on node 1",
      "type": "create_org",
      "org_name": "Create namespace (v4) on node 1",
      "outputs": {
        "namespace_id": "orgId"
      },
      "account": "app-migration-typechange-1"
    },
    {
      "name": "Create Open subgroup under namespace",
      "type": "create_team",
      "org": "{{namespace_id}}",
      "team_name": "typechange-scenario-subgroup",
      "join": "invite",
      "outputs": {
        "group_id": "teamId"
      },
      "account": "app-migration-typechange-1"
    },
    {
      "name": "Mark subgroup as Open",
      "type": "team_update",
      "org": "{{namespace_id}}",
      "team": "{{group_id}}",
      "join": "everyone",
      "account": "app-migration-typechange-1"
    },
    {
      "name": "Create context in subgroup on node 1 (v4)",
      "type": "deploy",
      "account": "app-migration-typechange-1",
      "package": "{{app_v4}}",
      "version": "{{app_v4_version}}",
      "app_name": "Create context in subgroup on node 1 (v4)",
      "org": "{{namespace_id}}",
      "access": {
        "kind": "team",
        "team": "{{group_id}}"
      },
      "outputs": {
        "ctx_id": "contextId"
      }
    },
    {
      "name": "Create namespace invitation for node 2",
      "type": "invite",
      "org": "{{namespace_id}}",
      "role": "member",
      "account": "app-migration-typechange-1",
      "outputs": {
        "namespace_invitation": "token"
      }
    },
    {
      "name": "Node 2 joins namespace",
      "type": "redeem_invite",
      "token": "{{namespace_invitation}}",
      "account": "app-migration-typechange-2"
    },
    {
      "name": "Node 2 materialises subgroup membership via inheritance",
      "type": "team_join",
      "org": "{{namespace_id}}",
      "team": "{{group_id}}",
      "account": "app-migration-typechange-2"
    },
    {
      "name": "Set details (v4)",
      "type": "call",
      "app": "{{ctx_id}}",
      "method": "set_details",
      "args": {
        "details": "typechange-scenario"
      },
      "account": "app-migration-typechange-1"
    },
    {
      "name": "Increment counter (v4 numeric) — 1",
      "type": "call",
      "app": "{{ctx_id}}",
      "method": "increment_counter",
      "args": {},
      "account": "app-migration-typechange-1"
    },
    {
      "name": "Increment counter (v4 numeric) — 2",
      "type": "call",
      "app": "{{ctx_id}}",
      "method": "increment_counter",
      "args": {},
      "account": "app-migration-typechange-1"
    },
    {
      "name": "Increment counter (v4 numeric) — 3",
      "type": "call",
      "app": "{{ctx_id}}",
      "method": "increment_counter",
      "args": {},
      "account": "app-migration-typechange-1"
    },
    {
      "name": "Sanity-check v4 schema before migration on node 1",
      "type": "call",
      "app": "{{ctx_id}}",
      "method": "schema_info",
      "args": {},
      "account": "app-migration-typechange-1",
      "outputs": {
        "v4_schema": "rpc"
      }
    },
    {
      "name": "Assert v4 has counter \"3\"",
      "type": "json_assert",
      "statements": [
        "json_subset({{v4_schema}}, {\"output\": {\"schema_version\": \"4.0.0\", \"details\": \"typechange-scenario\", \"counter\": \"3\"}})"
      ]
    },
    {
      "name": "Install migration-suite-v5-change-type on node 1",
      "type": "install_package",
      "mpk": "{{env.CORE_WASM_DIR}}/dist/com.calimero.migration-suite-5.0.0.mpk",
      "outputs": {
        "app_v5": "package",
        "app_v5_version": "version"
      },
      "account": "app-migration-typechange-1"
    },
    {
      "name": "Assert both versions share one application id (bundle same-id)",
      "type": "json_assert",
      "statements": [
        "equal(\"{{app_v4}}\", \"{{app_v5}}\")"
      ]
    },
    {
      "name": "Upgrade subgroup v4 → v5 (counter u64 → String)",
      "type": "upgrade_app",
      "app": "{{ctx_id}}",
      "version": "{{app_v5_version}}",
      "account": "app-migration-typechange-1"
    },
    {
      "name": "Wait for upgrade + migration to apply + log flush",
      "type": "wait",
      "seconds": 15.0
    },
    {
      "name": "Read post-migration schema_info on node 1 (triggers lazy migration)",
      "type": "call",
      "app": "{{ctx_id}}",
      "method": "schema_info",
      "args": {},
      "account": "app-migration-typechange-1",
      "outputs": {
        "v5_schema_node1": "rpc"
      }
    },
    {
      "name": "Read post-migration schema_info on node 2 (triggers lazy migration)",
      "type": "call",
      "app": "{{ctx_id}}",
      "method": "schema_info",
      "args": {},
      "account": "app-migration-typechange-2",
      "outputs": {
        "v5_schema_node2": "rpc"
      }
    },
    {
      "name": "Assert v5 schema on node 1 (counter still \"3\", but now String-typed)",
      "type": "json_assert",
      "statements": [
        "json_subset({{v5_schema_node1}}, {\"output\": {\"schema_version\": \"5.0.0\", \"details\": \"typechange-scenario\", \"counter\": \"3\"}})"
      ]
    },
    {
      "name": "Assert v5 schema on node 2 (same shape, proves migration reached node 2)",
      "type": "json_assert",
      "statements": [
        "json_subset({{v5_schema_node2}}, {\"output\": {\"schema_version\": \"5.0.0\", \"details\": \"typechange-scenario\", \"counter\": \"3\"}})"
      ]
    },
    {
      "name": "Node 1 calls v5 set_counter (accepts a String)",
      "type": "call",
      "app": "{{ctx_id}}",
      "method": "set_counter",
      "args": {
        "counter": "not-a-number-anymore"
      },
      "account": "app-migration-typechange-1"
    },
    {
      "name": "Node 2 reads counter back via v5 get_counter",
      "type": "call",
      "app": "{{ctx_id}}",
      "method": "get_counter",
      "args": {},
      "account": "app-migration-typechange-2",
      "outputs": {
        "counter_after_node2": "rpc"
      }
    },
    {
      "name": "Assert v5 counter holds the non-numeric string on node 2",
      "type": "json_assert",
      "statements": [
        "json_equal({{counter_after_node2}}, {\"output\": \"not-a-number-anymore\"})"
      ]
    },
    {
      "name": "Negative — increment_counter gone in v5",
      "type": "call",
      "app": "{{ctx_id}}",
      "method": "increment_counter",
      "args": {},
      "account": "app-migration-typechange-1",
      "expected_failure": true
    },
    {
      "name": "Delete subgroup",
      "type": "team_delete",
      "org": "{{namespace_id}}",
      "team": "{{group_id}}",
      "account": "app-migration-typechange-1"
    }
  ]
}
