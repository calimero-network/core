---
import Figure from '../Figure.astro';
---
<Figure id="d-key-hierarchy">
<svg viewBox="0 0 760 400" role="img" aria-label="Key hierarchy: a node proves its TDX image to mero-kms, which releases the cluster's key; K_r is derived from it with HKDF and the cluster name, and every key that seals a node's data is derived from K_r; transport, receipt and session keys are not" xmlns="http://www.w3.org/2000/svg">
  <defs><marker id="kh-arrow" markerWidth="9" markerHeight="9" refX="6.5" refY="3" orient="auto"><path d="M0,0 L6.5,3 L0,6 Z" fill="#8b949e"/></marker></defs>
  <rect x="0" y="0" width="760" height="400" rx="10" fill="#0f0f16"/>

  <!-- attestation first -->
  <g class="seq-step" style="--step-i:0">
    <rect x="20" y="24" width="210" height="70" rx="10" fill="#10210f" stroke="#3fb950" stroke-width="1.4"/>
    <text x="125" y="46" text-anchor="middle" fill="#3fb950" font-family="'JetBrains Mono', monospace" font-size="10.5" font-weight="700">booting TD (merod)</text>
    <text x="125" y="64" text-anchor="middle" fill="#c9d1d9" font-family="'JetBrains Mono', monospace" font-size="8.5">TDX quote over the KMS's</text>
    <text x="125" y="77" text-anchor="middle" fill="#c9d1d9" font-family="'JetBrains Mono', monospace" font-size="8.5">challenge + disk identity</text>
    <line x1="230" y1="59" x2="290" y2="59" stroke="#8b949e" stroke-width="1.4" marker-end="url(#kh-arrow)"/>
    <text x="260" y="50" text-anchor="middle" fill="#a5ff11" font-family="'JetBrains Mono', monospace" font-size="8.5">1 attest</text>
  </g>
  <g class="seq-step" style="--step-i:1">
    <rect x="292" y="24" width="200" height="70" rx="10" fill="#13160f" stroke="#a5ff11" stroke-width="1.4"/>
    <text x="392" y="46" text-anchor="middle" fill="#a5ff11" font-family="'JetBrains Mono', monospace" font-size="10.5" font-weight="700">mero-kms</text>
    <text x="392" y="64" text-anchor="middle" fill="#c9d1d9" font-family="'JetBrains Mono', monospace" font-size="8.5">checks the quote against</text>
    <text x="392" y="77" text-anchor="middle" fill="#c9d1d9" font-family="'JetBrains Mono', monospace" font-size="8.5">its release policy</text>
    <line x1="492" y1="59" x2="552" y2="59" stroke="#8b949e" stroke-width="1.4" marker-end="url(#kh-arrow)"/>
    <text x="522" y="50" text-anchor="middle" fill="#a5ff11" font-family="'JetBrains Mono', monospace" font-size="8.5">2 release</text>
    <rect x="554" y="24" width="186" height="70" rx="10" fill="#161b22" stroke="#a5ff11" stroke-width="1.2"/>
    <text x="647" y="46" text-anchor="middle" fill="#a5ff11" font-family="'JetBrains Mono', monospace" font-size="10" font-weight="700">KMS key</text>
    <text x="647" y="64" text-anchor="middle" fill="#c9d1d9" font-family="'JetBrains Mono', monospace" font-size="8.5">one per disk identity,</text>
    <text x="647" y="77" text-anchor="middle" fill="#c9d1d9" font-family="'JetBrains Mono', monospace" font-size="8.5">sealed to the TD</text>
  </g>

  <!-- K_r -->
  <g class="seq-step" style="--step-i:2">
    <line x1="647" y1="94" x2="647" y2="118" stroke="#8b949e" stroke-width="1.3"/>
    <line x1="647" y1="118" x2="380" y2="118" stroke="#8b949e" stroke-width="1.3"/>
    <line x1="380" y1="118" x2="380" y2="136" stroke="#8b949e" stroke-width="1.3" marker-end="url(#kh-arrow)"/>
    <rect x="200" y="138" width="360" height="56" rx="10" fill="#231708" stroke="#f0883e" stroke-width="1.6"/>
    <text x="380" y="160" text-anchor="middle" fill="#f0883e" font-family="'JetBrains Mono', monospace" font-size="11" font-weight="700">storage key K_r (one per cluster)</text>
    <text x="380" y="180" text-anchor="middle" fill="#c9d1d9" font-family="'JetBrains Mono', monospace" font-size="8.5">HKDF-SHA256(KMS key, salt "calimero.cloud.storage.v1", info = cluster)</text>
  </g>

  <!-- derived -->
  <g class="seq-step" style="--step-i:3">
    <line x1="380" y1="194" x2="380" y2="214" stroke="#8b949e" stroke-width="1.3"/>
    <line x1="80" y1="214" x2="680" y2="214" stroke="#8b949e" stroke-width="1.3"/>
    <line x1="80" y1="214" x2="80" y2="230" stroke="#8b949e" stroke-width="1.3" marker-end="url(#kh-arrow)"/>
    <line x1="230" y1="214" x2="230" y2="230" stroke="#8b949e" stroke-width="1.3" marker-end="url(#kh-arrow)"/>
    <line x1="380" y1="214" x2="380" y2="230" stroke="#8b949e" stroke-width="1.3" marker-end="url(#kh-arrow)"/>
    <line x1="530" y1="214" x2="530" y2="230" stroke="#8b949e" stroke-width="1.3" marker-end="url(#kh-arrow)"/>
    <line x1="680" y1="214" x2="680" y2="230" stroke="#8b949e" stroke-width="1.3" marker-end="url(#kh-arrow)"/>

    <rect x="14" y="232" width="132" height="76" rx="8" fill="#16222e" stroke="#39d0d8"/>
    <text x="80" y="252" text-anchor="middle" fill="#39d0d8" font-family="'JetBrains Mono', monospace" font-size="9.5" font-weight="700">the store</text>
    <text x="80" y="270" text-anchor="middle" fill="#c9d1d9" font-family="'JetBrains Mono', monospace" font-size="8">AES-256-GCM: entries,</text>
    <text x="80" y="283" text-anchor="middle" fill="#c9d1d9" font-family="'JetBrains Mono', monospace" font-size="8">votes, state rows,</text>
    <text x="80" y="296" text-anchor="middle" fill="#c9d1d9" font-family="'JetBrains Mono', monospace" font-size="8">blobs</text>

    <rect x="164" y="232" width="132" height="76" rx="8" fill="#16222e" stroke="#39d0d8"/>
    <text x="230" y="252" text-anchor="middle" fill="#39d0d8" font-family="'JetBrains Mono', monospace" font-size="9.5" font-weight="700">snapshot key</text>
    <text x="230" y="270" text-anchor="middle" fill="#c9d1d9" font-family="'JetBrains Mono', monospace" font-size="8">snapshot frames,</text>
    <text x="230" y="283" text-anchor="middle" fill="#c9d1d9" font-family="'JetBrains Mono', monospace" font-size="8">backups</text>
    <text x="230" y="296" text-anchor="middle" fill="#6b6b80" font-family="'JetBrains Mono', monospace" font-size="8">+ hidden-key HMAC</text>

    <rect x="314" y="232" width="132" height="76" rx="8" fill="#16222e" stroke="#39d0d8"/>
    <text x="380" y="252" text-anchor="middle" fill="#39d0d8" font-family="'JetBrains Mono', monospace" font-size="9.5" font-weight="700">cluster secret</text>
    <text x="380" y="270" text-anchor="middle" fill="#c9d1d9" font-family="'JetBrains Mono', monospace" font-size="8">x-cluster-auth on</text>
    <text x="380" y="283" text-anchor="middle" fill="#c9d1d9" font-family="'JetBrains Mono', monospace" font-size="8">/internal/* between</text>
    <text x="380" y="296" text-anchor="middle" fill="#c9d1d9" font-family="'JetBrains Mono', monospace" font-size="8">peers</text>

    <rect x="464" y="232" width="132" height="76" rx="8" fill="#16222e" stroke="#39d0d8"/>
    <text x="530" y="252" text-anchor="middle" fill="#39d0d8" font-family="'JetBrains Mono', monospace" font-size="9.5" font-weight="700">app TEE key</text>
    <text x="530" y="270" text-anchor="middle" fill="#c9d1d9" font-family="'JetBrains Mono', monospace" font-size="8">per app: TeeSecret,</text>
    <text x="530" y="283" text-anchor="middle" fill="#c9d1d9" font-family="'JetBrains Mono', monospace" font-size="8">timers' own state</text>

    <rect x="614" y="232" width="132" height="76" rx="8" fill="#16222e" stroke="#39d0d8"/>
    <text x="680" y="252" text-anchor="middle" fill="#39d0d8" font-family="'JetBrains Mono', monospace" font-size="9.5" font-weight="700">member key</text>
    <text x="680" y="270" text-anchor="middle" fill="#c9d1d9" font-family="'JetBrains Mono', monospace" font-size="8">per app and account:</text>
    <text x="680" y="283" text-anchor="middle" fill="#c9d1d9" font-family="'JetBrains Mono', monospace" font-size="8">a member's sealed</text>
    <text x="680" y="296" text-anchor="middle" fill="#c9d1d9" font-family="'JetBrains Mono', monospace" font-size="8">share</text>
  </g>

  <!-- not from K_r -->
  <g class="seq-step" style="--step-i:4">
    <rect x="14" y="328" width="732" height="56" rx="8" fill="#161b22" stroke="#444c56" stroke-dasharray="5 4"/>
    <text x="380" y="348" text-anchor="middle" fill="#8b949e" font-family="'JetBrains Mono', monospace" font-size="9" font-weight="700">not derived from K_r</text>
    <text x="380" y="368" text-anchor="middle" fill="#8b949e" font-family="'JetBrains Mono', monospace" font-size="8.5">transport key (X25519) and receipt key (Ed25519): per node, in memory, attested · session key K_s: in the system state, rotated</text>
  </g>
</svg>
</Figure>
