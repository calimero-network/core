    <rect x="170" y="382" width="12" height="10" fill="#1a1430" stroke="#a371f7"/><text x="188" y="391" fill="#8b949e" font-family="'JetBrains Mono', monospace" font-size="8">compiled into the app (wasm32-wasip2)</text>
    <rect x="420" y="382" width="12" height="10" fill="#10210f" stroke="#3fb950"/><text x="438" y="391" fill="#8b949e" font-family="'JetBrains Mono', monospace" font-size="8">no calimero-* dependency</text>
