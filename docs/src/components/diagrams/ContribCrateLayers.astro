    <rect x="274" y="52" width="63" height="22" rx="4" fill="#161b22" stroke="#444c56"/>
    <text x="305.5" y="67" text-anchor="middle" fill="#c9d1d9" font-family="'JetBrains Mono', monospace" font-size="8.5">mero-sign</text>
    <rect x="343" y="52" width="79" height="22" rx="4" fill="#161b22" stroke="#444c56"/>
    <text x="382.5" y="67" text-anchor="middle" fill="#c9d1d9" font-family="'JetBrains Mono', monospace" font-size="8.5">mero-compute</text>
