package calimero:app@0.5.7;

interface types {
  type account-id = string;
  type org-id = string;
  type team-id = string;
  type blob-id = string;
  type action-id = string;
  record api-key-caller { key-id: string, account: account-id }
  // An anonymous visitor through one of the instance's public links: the link (its key) and
  // the visitor's own Ed25519 public key (hex), which it proved it holds. 0.5.6.
  record visitor-caller { link: string, key: string }
  variant caller { account(account-id), api-key(api-key-caller), public, system, app(string) }
  enum org-role { owner, admin, member, guest }
  record org-membership { org: org-id, role: org-role }
  variant audience {
    all, caller, accounts(list<account-id>), team(team-id),
    org-members(org-id), org-admins(org-id),
  }
  record event { name: string, data: list<u8>, audience: audience }
  record app-error { code: string, message: string }
  record blob-info { size: u64, sha256: list<u8>, mime: string }
  enum invocation-kind { call, view, action, timer, xcall-deliver, init, migrate }
}

interface storage {
  get: func(key: list<u8>) -> option<list<u8>>;
  put: func(key: list<u8>, value: list<u8>);
  delete: func(key: list<u8>);
  add: func(key: list<u8>, delta: s64);   // commutative, no read; value is a CBOR integer
  resource cursor { next: func(max: u32) -> list<tuple<list<u8>, list<u8>>>; }
  range: func(start: list<u8>, end: list<u8>, reverse: bool) -> cursor;

  // 0.5.7: `put`, `delete` and `add` that answer a write past one of the run's limits as
  // an error the guest handles, where the three above trap. Nothing is written or counted
  // for a refused write; the answer depends only on the run's writes, so every node gives
  // the same one. Every other refusal (a view writing, a key over 1 KiB) still traps.
  enum run-limit {
    // more than `max` writes (`put`, `delete`, `add`) in one run (MAX_WRITES)
    writes,
    // more than `max` bytes written in one run: keys, values, events, xcalls (MAX_RUN_BYTES)
    bytes,
  }
  // `attempted` is what the run would have reached with this write: the write's number, or
  // the run's bytes with it.
  record limit-exceeded { limit: run-limit, max: u64, attempted: u64 }
  put-checked: func(key: list<u8>, value: list<u8>) -> result<_, limit-exceeded>;
  delete-checked: func(key: list<u8>) -> result<_, limit-exceeded>;
  add-checked: func(key: list<u8>, delta: s64) -> result<_, limit-exceeded>;
}

// For a migration run: `storage` reads the old state (writes to it trap HostDenied) and
// `rebuild` reads and writes the new version's keyspace. Migrations are refused
// (`MigrationsNotSupported`), so no run is given this interface.
interface rebuild {
  use storage.{cursor};
  get: func(key: list<u8>) -> option<list<u8>>;
  put: func(key: list<u8>, value: list<u8>);
  delete: func(key: list<u8>);
  add: func(key: list<u8>, delta: s64);
  range: func(start: list<u8>, end: list<u8>, reverse: bool) -> cursor;
}

interface context {
  use types.{caller as caller-t, account-id, org-id, team-id, org-role as org-role-t, org-membership, action-id};
  use types.{visitor-caller};
  // A visitor through a public link is `public` here, so a component built before 0.5.6
  // sees an anonymous caller; `visitor` names them.
  caller: func() -> caller-t;
  // The visitor a public link let in, when `caller` is `public` because of one; none for
  // any other run. 0.5.6.
  visitor: func() -> option<visitor-caller>;
  // The app this call came through, when another app called as the person it serves (who
  // granted it this method; `caller` is that person): set by the node, never by an
  // argument; none for any other run. 0.5.2.
  via: func() -> option<string>;
  // The scope of the caller's grant on this instance: small opaque JSON the instance's managers
  // set on the person's grant (or the invite that made it), in the app's own terms, such as
  // `{"channel":"partners"}`; the node never reads it. None when the caller is no account, is
  // named with no scope, or reaches the instance another way, and in a compute run. The platform
  // admits; the app scopes. 0.5.6.
  grant-scope: func() -> option<string>;
  app-id: func() -> string;
  // The app this instance's release references under `name` (its signed manifest's `uses`):
  // a member its creation made, or an app its owner attached. None when nothing is linked
  // under that name, and in a compute run. 0.5.3.
  linked: func(name: string) -> option<string>;
  // The app whose unit this one is a member of: the instance whose release created it
  // (`uses` with `mode: create`). None for any other app, and in a compute run. 0.5.5.
  unit-of: func() -> option<string>;
  app-owner: func() -> account-id;
  org: func() -> option<org-id>;
  org-role: func(account: account-id) -> option<org-role-t>;
  org-role-strict: func(account: account-id) -> option<org-role-t>; // answers as org-role, from this node's replica (no read index)
  orgs-of: func(account: account-id) -> list<org-membership>;     // the app's own org only
  in-team: func(account: account-id, team: team-id) -> bool;
  applied-index: func() -> u64;
  unique-id: func() -> string;   // <leader term>.<call seq>.<n>; calls, timers, init, xcall delivery
  start-action: func(method: string, args: list<u8>) -> result<action-id, string>; // calls and timers
  // time and randomness: wasi:clocks and wasi:random, served by the host
}

interface events {
  use types.{event};
  emit: func(e: event) -> result<_, string>;
}

interface blobs {
  use types.{blob-id, blob-info};
  info: func(id: blob-id) -> option<blob-info>;
  grant: func(id: blob-id, ttl-seconds: u32) -> string;
}

// Full-text search over a table's declared fields: the host keeps the index from the app's
// state and answers views only.
interface search {
  enum search-mode { words, prefix, substring, fuzzy }
  record search-hit { key: list<u8>, score: f32, snippet: string }
  record search-page { hits: list<search-hit>, next: option<u32>, total: u64 }
  query: func(table: string, text: string, mode: search-mode, cursor: u32, limit: u32) -> result<search-page, string>;
}

// Encrypted files kept by the node: sealed blobs, sharing the blob-id namespace. `finish` returns
// the id to store as a BlobRef; a file no state refers to is collected. Writes are logged-write
// kinds only; `open` works only inside a compute run, `info` in every kind. blobs.info answers
// for a file; blobs.grant refuses it.
interface files {
  use types.{blob-id, blob-info};
  resource writer {
    write: func(bytes: list<u8>) -> result<_, string>;
    finish: func() -> result<blob-id, string>;
  }
  resource reader {
    read: func(max: u32) -> result<list<u8>, string>;   // an empty list is the end of the file; max 0 is read as 1
  }
  create: func() -> result<writer, string>;
  open: func(id: blob-id) -> result<reader, string>;
  info: func(id: blob-id) -> option<blob-info>;       // mime is "" for files; size and sha256 are of the plaintext
}

// Starting and cancelling compute runs, and publishing a done run's output: logged writes only (call, timer, init, xcall delivery).
// The compute world does not import it: a run cannot start runs. `uploader` is a read, for every kind but a migration.
interface runs {
  use types.{blob-id, action-id};
  start: func(method: string, args: list<u8>, inputs: list<blob-id>) -> result<action-id, string>; // an active run with the same method, args and inputs answers its id
  cancel: func(run: action-id) -> result<_, string>;   // an active run only; recorded with the run's outcome, applied with its entry
  uploader: func(id: blob-id) -> option<string>;       // the account that uploaded the sealed file, fixed at its upload; none for a file a call or a run made, and for an unknown id
  publish: func(id: blob-id) -> result<blob-id, string>; // a done run's output as a plain blob, the only way a file's bytes leave the cluster: its id is the SHA-256 of the plaintext; an id that is no output of this app's done runs answers NOT_A_RUN_OUTPUT
}

// What a compute component sees of its run; the app world does not import it.
interface job {
  use types.{blob-id, action-id};
  run-id: func() -> option<action-id>;
  inputs: func() -> list<blob-id>;
  progress: func(percent: u8, step: string);   // the last value wins, never logged; step is cut at 128 bytes
}

interface xcall {
  send: func(app: string, method: string, args: list<u8>) -> result<_, string>; // outbox; delivered after commit
  // Synchronous: the target's call, logged in its own log before this run continues, under a
  // key derived from this run's; not atomic with this run. Calls, timers and actions.
  call: func(app: string, method: string, args: list<u8>) -> result<list<u8>, string>;
  // Synchronous read of the target's latest committed state. Calls, timers, views and actions.
  view: func(app: string, method: string, args: list<u8>) -> result<list<u8>, string>;
  // One synchronous call or view of a batch.
  enum request-kind { call, view }
  record request { kind: request-kind, app: string, method: string, args: list<u8> }
  // Runs every request at once and answers in order; each counts as one synchronous xcall
  // and gets the same checks, key and replay as `call`/`view`. 0.5.4.
  batch: func(requests: list<request>) -> list<result<list<u8>, string>>;
}

// Available only while handling kind = action
interface action {
  key: func() -> string;                                                    // this action run's idempotency key
  view: func(method: string, args: list<u8>) -> result<list<u8>, string>;
  call: func(method: string, args: list<u8>) -> result<list<u8>, string>;   // one log entry, key derived from key()
}

world app {
  import storage;
  import rebuild;
  import context;
  import events;
  import blobs;
  import search;
  import files;
  import xcall;
  import action;
  import runs;

  // WASI 0.2.12, what wasmtime 50 and componentize-js 0.23 ship, each served by the host
  // (https://calimero-network.github.io/core/protocol/execution/#what-the-host-offers-a-cloud-run).
  // Nine more WASI interfaces Rust's std imports are accepted at install and served by stubs
  // that refuse; they are not part of the world.
  import wasi:io/error@0.2.12;
  import wasi:io/poll@0.2.12;
  import wasi:io/streams@0.2.12;
  import wasi:clocks/wall-clock@0.2.12;
  import wasi:clocks/monotonic-clock@0.2.12;
  import wasi:random/random@0.2.12;
  import wasi:random/insecure-seed@0.2.12; // std's HashMap seeds from it
  import wasi:cli/stdout@0.2.12;
  import wasi:cli/stderr@0.2.12;
  import wasi:cli/environment@0.2.12;
  import wasi:http/types@0.2.12;
  import wasi:http/outgoing-handler@0.2.12; // actions, calls, timers and xcall deliveries (recorded); never views, init or migrations

  use types.{invocation-kind, app-error};
  export handle: func(kind: invocation-kind, method: string, args: list<u8>) -> result<list<u8>, app-error>;
}

// The compute methods of an app, built as their own component for job nodes: no state, no
// xcall, no network, so the install-time import check is the whole sandbox.
world compute {
  import types;
  import files;
  import job;

  import wasi:io/error@0.2.12;
  import wasi:io/poll@0.2.12;
  import wasi:io/streams@0.2.12;
  import wasi:clocks/wall-clock@0.2.12;
  import wasi:clocks/monotonic-clock@0.2.12;
  import wasi:random/random@0.2.12;
  import wasi:random/insecure-seed@0.2.12; // std's HashMap seeds from it
  import wasi:cli/stdout@0.2.12;
  import wasi:cli/stderr@0.2.12;
  import wasi:cli/environment@0.2.12;

  use types.{app-error};
  export run: func(method: string, args: list<u8>) -> result<list<u8>, app-error>;
}
