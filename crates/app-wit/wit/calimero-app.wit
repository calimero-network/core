package calimero:app@0.5.1;

interface types {
  type account-id = string;
  type org-id = string;
  type team-id = string;
  type blob-id = string;
  type action-id = string;
  record api-key-caller { key-id: string, account: account-id }
  variant caller { account(account-id), api-key(api-key-caller), public, system, app(string) }
  enum org-role { owner, admin, member, guest }
  record org-membership { org: org-id, role: org-role }
  variant audience {
    all, caller, accounts(list<account-id>), team(team-id),
    org-members(org-id), org-admins(org-id),
  }
  record event { name: string, data: list<u8>, audience: audience }
  record app-error { code: string, message: string }
  record blob-info { size: u64, sha256: list<u8>, mime: string }
  enum invocation-kind { call, view, action, timer, xcall-deliver, init, migrate }
}

interface storage {
  get: func(key: list<u8>) -> option<list<u8>>;
  put: func(key: list<u8>, value: list<u8>);
  delete: func(key: list<u8>);
  add: func(key: list<u8>, delta: s64);   // commutative, no read; value is a CBOR integer (D47)
  resource cursor { next: func(max: u32) -> list<tuple<list<u8>, list<u8>>>; }
  range: func(start: list<u8>, end: list<u8>, reverse: bool) -> cursor;
}

// Available only while handling kind = migrate (D38). `storage` reads the old state
// (writes to it trap HostDenied); `rebuild` reads and writes the new version's keyspace.
interface rebuild {
  use storage.{cursor};
  get: func(key: list<u8>) -> option<list<u8>>;
  put: func(key: list<u8>, value: list<u8>);
  delete: func(key: list<u8>);
  add: func(key: list<u8>, delta: s64);
  range: func(start: list<u8>, end: list<u8>, reverse: bool) -> cursor;
}

interface context {
  use types.{caller as caller-t, account-id, org-id, team-id, org-role as org-role-t, org-membership, action-id};
  caller: func() -> caller-t;
  app-id: func() -> string;
  app-owner: func() -> account-id;
  org: func() -> option<org-id>;
  org-role: func(account: account-id) -> option<org-role-t>;
  org-role-strict: func(account: account-id) -> option<org-role-t>; // read-index on the system group
  orgs-of: func(account: account-id) -> list<org-membership>;     // the app's own org only (D75); partners with R1
  in-team: func(account: account-id, team: team-id) -> bool;
  applied-index: func() -> u64;
  unique-id: func() -> string;   // <leader term>.<call seq>.<n>; calls, timers, init, xcall delivery (D52)
  start-action: func(method: string, args: list<u8>) -> result<action-id, string>; // calls and timers (D17)
  // time and randomness: wasi:clocks and wasi:random, served by the host (D19)
}

interface events {
  use types.{event};
  emit: func(e: event) -> result<_, string>;
}

interface blobs {
  use types.{blob-id, blob-info};
  info: func(id: blob-id) -> option<blob-info>;
  grant: func(id: blob-id, ttl-seconds: u32) -> string;
}

// Full-text search over a table's declared fields (spec section 7, R2): the host keeps the
// index from the app's state and answers views only. Not in the spec's section 4 world,
// which names the index but no interface to query it.
interface search {
  enum search-mode { words, prefix, substring, fuzzy }
  record search-hit { key: list<u8>, score: f32, snippet: string }
  record search-page { hits: list<search-hit>, next: option<u32>, total: u64 }
  query: func(table: string, text: string, mode: search-mode, cursor: u32, limit: u32) -> result<search-page, string>;
}

// Encrypted files kept by the node: sealed blobs, sharing the blob-id namespace. `finish` returns
// the id to store as a BlobRef; a file no state refers to is collected. Writes are logged-write
// kinds only; reads work in views and actions too. blobs.info answers for a file; blobs.grant
// refuses it.
interface files {
  use types.{blob-id, blob-info};
  resource writer {
    write: func(bytes: list<u8>) -> result<_, string>;
    finish: func() -> result<blob-id, string>;
  }
  resource reader {
    read: func(max: u32) -> result<list<u8>, string>;   // an empty list is the end of the file; max 0 is read as 1
  }
  create: func() -> result<writer, string>;
  open: func(id: blob-id) -> result<reader, string>;
  info: func(id: blob-id) -> option<blob-info>;       // mime is "" for files; size and sha256 are of the plaintext
}

// Starting and cancelling compute runs: logged writes only (call, timer, init, xcall delivery).
// The compute world does not import it: a run cannot start runs.
interface runs {
  use types.{blob-id, action-id};
  start: func(method: string, args: list<u8>, inputs: list<blob-id>) -> result<action-id, string>; // an active run with the same method, args and inputs answers its id
  cancel: func(run: action-id) -> result<_, string>;   // an active run only; recorded with the run's outcome, applied with its entry
}

// What a compute component sees of its run; the app world does not import it.
interface job {
  use types.{blob-id, action-id};
  run-id: func() -> option<action-id>;
  inputs: func() -> list<blob-id>;
  progress: func(percent: u8, step: string);   // the last value wins, never logged; step is cut at 128 bytes
}

interface xcall {
  send: func(app: string, method: string, args: list<u8>) -> result<_, string>; // outbox; delivered after commit
  // Synchronous: the target's call, logged in its own log before this run continues, under a
  // key derived from this run's; not atomic with this run. Calls, timers and actions.
  call: func(app: string, method: string, args: list<u8>) -> result<list<u8>, string>;
  // Synchronous read of the target's latest committed state. Calls, timers, views and actions.
  view: func(app: string, method: string, args: list<u8>) -> result<list<u8>, string>;
}

// Available only while handling kind = action (D12, D17)
interface action {
  key: func() -> string;                                                    // this action run's idempotency key
  view: func(method: string, args: list<u8>) -> result<list<u8>, string>;
  call: func(method: string, args: list<u8>) -> result<list<u8>, string>;   // one log entry, key derived from key()
}

// PoC (host collections): not part of the spec's 0.5.1; the version is kept while this is tried out.
interface collections {
  variant key-part { none, boolean(bool), int(s64), uint(u64), text(string), bytes(list<u8>) }
  type key = list<key-part>;
  record entry { key: key, value: list<u8> }
  record page { items: list<entry>, next: option<string> }
  variant coll-error { duplicate(string), bad-record(string), bad-cursor, unknown-collection(string), wrong-kind(string), unknown-set(string) }
  table-insert: func(table: string, %record: list<u8>) -> result<_, coll-error>;
  table-upsert: func(table: string, %record: list<u8>) -> result<_, coll-error>;
  table-get: func(table: string, key: key) -> result<option<list<u8>>, coll-error>;
  table-remove: func(table: string, key: key) -> result<bool, coll-error>;
  table-find: func(table: string, index: option<string>, prefix: key, cursor: option<string>, limit: u32, reverse: bool) -> result<page, coll-error>;
  table-count: func(table: string, count: string, prefix: key) -> result<u64, coll-error>;
  map-get: func(%map: string, key: key) -> result<option<list<u8>>, coll-error>;
  map-insert: func(%map: string, key: key, value: list<u8>) -> result<option<list<u8>>, coll-error>;
  map-remove: func(%map: string, key: key) -> result<option<list<u8>>, coll-error>;
  map-page: func(%map: string, prefix: key, cursor: option<string>, limit: u32, reverse: bool) -> result<page, coll-error>;
  tally-add: func(tally: string, key: key, delta: s64) -> result<_, coll-error>;
  tally-get: func(tally: string, key: key) -> result<s64, coll-error>;
}

world app {
  import storage;
  import rebuild;
  import context;
  import events;
  import blobs;
  import search;
  import files;
  import xcall;
  import action;
  import runs;
  import collections;

  // WASI 0.2.12, what wasmtime 50 and componentize-js 0.23 ship (D43); implemented by the host (section 4 table).
  // The nine stubbed interfaces of D44 are accepted at install but are not part of the world.
  import wasi:io/error@0.2.12;
  import wasi:io/poll@0.2.12;
  import wasi:io/streams@0.2.12;
  import wasi:clocks/wall-clock@0.2.12;
  import wasi:clocks/monotonic-clock@0.2.12;
  import wasi:random/random@0.2.12;
  import wasi:random/insecure-seed@0.2.12; // std's HashMap seeds from it
  import wasi:cli/stdout@0.2.12;
  import wasi:cli/stderr@0.2.12;
  import wasi:cli/environment@0.2.12;
  import wasi:http/types@0.2.12;
  import wasi:http/outgoing-handler@0.2.12; // usable in actions only (D12)

  use types.{invocation-kind, app-error};
  export handle: func(kind: invocation-kind, method: string, args: list<u8>) -> result<list<u8>, app-error>;
}

// The compute methods of an app, built as their own component for job nodes: no state, no
// xcall, no network, so the install-time import check is the whole sandbox.
world compute {
  import types;
  import files;
  import job;

  import wasi:io/error@0.2.12;
  import wasi:io/poll@0.2.12;
  import wasi:io/streams@0.2.12;
  import wasi:clocks/wall-clock@0.2.12;
  import wasi:clocks/monotonic-clock@0.2.12;
  import wasi:random/random@0.2.12;
  import wasi:random/insecure-seed@0.2.12; // std's HashMap seeds from it
  import wasi:cli/stdout@0.2.12;
  import wasi:cli/stderr@0.2.12;
  import wasi:cli/environment@0.2.12;

  use types.{app-error};
  export run: func(method: string, args: list<u8>) -> result<list<u8>, app-error>;
}
