{
  "components": {
    "parameters": {
      "app": {
        "description": "The app instance's id.",
        "in": "path",
        "name": "app",
        "required": true,
        "schema": {
          "type": "string"
        }
      }
    },
    "responses": {
      "AppError": {
        "content": {
          "application/json": {
            "schema": {
              "oneOf": [
                {
                  "properties": {
                    "details": {
                      "properties": {
                        "code": {
                          "const": "NotFound"
                        },
                        "fields": {
                          "$ref": "#/components/schemas/NotFoundError"
                        },
                        "index": {
                          "type": "integer"
                        }
                      },
                      "required": [
                        "code",
                        "fields"
                      ],
                      "type": "object"
                    },
                    "error": {
                      "const": "APP_ERROR"
                    },
                    "message": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "error",
                    "message",
                    "details"
                  ],
                  "type": "object"
                },
                {
                  "$ref": "#/components/schemas/Trap"
                }
              ]
            }
          }
        },
        "description": "The app refused the call (`APP_ERROR`, one of its declared errors) or the run trapped (`TRAP`)."
      },
      "BadRequest": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ApiError"
            }
          }
        },
        "description": "The request is malformed (`BAD_REQUEST`), names a reserved method (`RESERVED_METHOD`), or carries an approval for another call (`WRONG_CHALLENGE`)."
      },
      "ConfirmRequired": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ConfirmRequired"
            }
          }
        },
        "description": "`CONFIRM_REQUIRED`: approve the call with the passkey and send it again with `confirm`."
      },
      "Forbidden": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ApiError"
            }
          }
        },
        "description": "The caller may not call this method of this app (`FORBIDDEN`), or the app is read-only."
      },
      "Gone": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ApiError"
            }
          }
        },
        "description": "`UNSUPPORTED_ENGINE`: the app is an SDK 0.12 app, which this node no longer runs."
      },
      "NotFound": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ApiError"
            }
          }
        },
        "description": "No such app here."
      },
      "RateLimited": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ApiError"
            }
          }
        },
        "description": "`RATE_LIMITED`: a public method's rate, or the node's limits."
      },
      "Unauthorized": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ApiError"
            }
          }
        },
        "description": "No valid session or API key, and the method is not public."
      },
      "Unavailable": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ApiError"
            }
          }
        },
        "description": "`UNAVAILABLE` or `TIMEOUT`: retry with the same idempotency key."
      }
    },
