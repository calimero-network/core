{
  "abiVersion": 1,
  "world": "calimero:app@0.5.1",
  "state": {
    "fields": { "items": "table", "tags": "unorderedMap", "hits": "counter", "owner": "cell" },
    "search": { "items": ["title"] },
    "version": 2
  },
  "methods": {
    "init": { "kind": "init", "params": [["owner", "string"], ["limit", "u64"], ["note", "option<string>"], ["first", "option<Item>"]], "returns": null, "confirm": false, "public": false, "allowSystem": false },
    "everything": {
      "kind": "call",
      "params": [
        ["flag", "bool"], ["small", "u8"], ["medium", "u16"], ["count", "u32"], ["big", "u64"],
        ["huge", "u128"], ["size", "usize"], ["delta", "i8"], ["offset", "i32"], ["balance", "i64"],
        ["ratio", "f32"], ["precise", "f64"], ["letter", "char"], ["title", "string"],
        ["blob", "bytes"], ["maybe", "option<u64>"], ["names", "list<string>"],
        ["pair", "tuple<u32, string>"], ["digest", "[u8;32]"],
        ["scores", "BTreeMap<String,u32>"], ["byId", "HashMap<u32,String>"],
        ["unique", "BTreeSet<String>"], ["item", "Item"], ["page", "Page<Item>"],
        ["nested", "option<list<option<Item>>>"]
      ],
      "returns": "list<Item>",
      "confirm": false, "public": false, "allowSystem": false
    },
    "wipe": { "kind": "call", "params": [["reason", "option<string>"]], "returns": null, "confirm": true, "public": false, "allowSystem": false },
    "secret": { "kind": "view", "params": [], "returns": "string", "confirm": true, "public": false, "allowSystem": false },
    "lookup": { "kind": "view", "params": [["id", "u64"]], "returns": "option<Item>", "confirm": false, "public": true, "rate": "10/s", "allowSystem": false },
    "events": { "kind": "call", "params": [["in", "string"], ["default", "option<bytes>"], ["when", "option<i64>"]], "returns": "tuple<u32, string>", "confirm": false, "public": false, "allowSystem": false },
    "count": { "kind": "view", "params": [["stale", "bool"]], "returns": "u64", "confirm": false, "public": false, "allowSystem": false },
    "blobOf": { "kind": "view", "params": [["key", "string"]], "returns": "option<bytes>", "confirm": false, "public": false, "allowSystem": false },
    "fromPeer": { "kind": "call", "params": [["note", "string"]], "returns": null, "confirm": false, "public": false, "allowSystem": true, "allowApps": ["*"] },
    "tick": { "kind": "timer", "params": [], "returns": null, "every": "1m", "confirm": false, "public": false, "allowSystem": true },
    "fetchPrice": { "kind": "action", "params": [["symbol", "string"]], "returns": null, "confirm": false, "public": false, "allowSystem": false },
    "storePrice": { "kind": "call", "params": [["price", "u64"]], "returns": null, "confirm": false, "public": false, "allowSystem": false, "allowAction": true },
    "digest": { "kind": "compute", "params": [["x", "u32"]], "returns": null, "compute": { "fuel": 100, "result": "onDigest" }, "confirm": false, "public": false, "allowSystem": false },
    "onDigest": { "kind": "call", "params": [], "returns": null, "computeResult": true, "confirm": false, "public": false, "allowSystem": true },
    "shapes": {
      "kind": "view",
      "params": [
        ["status", "Status"], ["tagged", "Tagged"], ["adjacent", "Adjacent"], ["either", "Either"],
        ["id", "Id"], ["point", "Point"], ["marker", "Marker"], ["tree", "Tree"],
        ["expr", "Expr"], ["choice", "Choice<Item>"]
      ],
      "returns": "Tree",
      "confirm": false, "public": false, "allowSystem": false
    },
    "plain": {
      "kind": "call",
      "params": [
        ["stats", "Stats"], ["counts", "list<u64_number>"], ["pixels", "byte_list"],
        ["limit", "option<i64_number>"], ["extra", "Opaque"]
      ],
      "returns": "Stats",
      "confirm": false, "public": false, "allowSystem": false
    }
  },
  "errors": { "NotFound": { "id": "u64" }, "Forbidden": {}, "Invalid": { "field": "string", "detail": "option<string>" }, "Rejected": { "0": "string" }, "Unknown": {} },
  "events": { "Created": { "id": "u64", "item": "Item" }, "Wiped": {}, "Default": { "blob": "bytes", "at": "option<u64>", "pair": "tuple<u32, string>", "delta": "i64" } },
  "types": {
    "Adjacent": {
      "kind": "enum", "tag": "t", "content": "c",
      "variants": [
        { "name": "Text", "type": "string" }, { "name": "Empty" }, { "name": "Pair", "items": ["u32", "u32"] },
        { "name": "Labeled", "fields": [["label", "string"], ["at", "option<u64>"]] }
      ]
    },
    "Choice": { "kind": "enum", "params": ["T"], "tag": "kind", "variants": [{ "name": "one", "fields": [["value", "T"]] }, { "name": "zero" }] },
    "Either": {
      "kind": "enum", "untagged": true,
      "variants": [
        { "name": "Num", "type": "u32" }, { "name": "Named", "fields": [["name", "string"]] },
        { "name": "Pair", "items": ["u32", "string"] }, { "name": "Blank" }
      ]
    },
    "Expr": {
      "kind": "enum",
      "variants": [{ "name": "Lit", "type": "i64" }, { "name": "Neg", "type": "Expr" }, { "name": "Add", "items": ["Expr", "Expr"] }]
    },
    "Id": { "kind": "newtype", "type": "string" },
    "Item": {
      "kind": "record",
      "fields": [["id", "u64"], ["title", "string"], ["tags", "list<string>"], ["note", "option<string>", { "optional": true }], ["status", "Status"]]
    },
    "Marker": { "kind": "unit" },
    "Page": { "kind": "record", "params": ["T"], "fields": [["items", "list<T>"], ["next", "option<string>"]] },
    "Point": { "kind": "tuple", "items": ["f64", "f64"] },
    "Stats": {
      "kind": "record",
      "fields": [
        ["views", "u64_number"], ["delta", "i64_number"], ["pixels", "byte_list"],
        ["peak", "option<u64_number>", { "optional": true }], ["label", "string", { "optional": true }]
      ]
    },
    "Status": {
      "kind": "enum",
      "variants": [{ "name": "Open" }, { "name": "Closed", "fields": [["at", "u64"]] }, { "name": "Moved", "type": "string" }, { "name": "Span", "items": ["u32", "u32"] }]
    },
    "Tagged": {
      "kind": "enum", "tag": "type",
      "variants": [{ "name": "draft" }, { "name": "published", "fields": [["at", "u64"]] }, { "name": "wrapped", "type": "Item" }]
    },
    "Tree": { "kind": "record", "fields": [["value", "u32"], ["children", "list<Tree>"], ["parent", "option<Tree>", { "optional": true }]] }
  }
}
