[
  { "as": "bob", "op": "view", "method": "page", "args": { "slug": "home" },
    "expect": { "ok": { "slug": "home", "title": "Home", "author": "@owner", "revision": 1,
      "body": "Welcome to the team wiki. Anyone in the org may start a page; only its author changes it.",
      "tags": [], "attachments": [] } } },
  { "as": "bob", "op": "view", "method": "pages", "expect": { "ok": [ { "slug": "home", "title": "Home", "author": "@owner" } ] } },
  { "as": "alice", "op": "call", "method": "createPage", "args": { "title": "  Getting   Started ", "body": "install meroctl" }, "expect": { "ok": "getting-started" } },
  { "as": "bob", "op": "view", "method": "page", "args": { "slug": "GETTING started" },
    "expect": { "ok": { "slug": "getting-started", "title": "  Getting   Started ", "author": "@alice", "revision": 1,
      "body": "install meroctl", "tags": [], "attachments": [] } } },
  { "as": "bob", "op": "call", "method": "createPage", "args": { "title": "getting started", "body": "mine" },
    "expect": { "error": "PageExists", "fields": { "slug": "getting-started" } } },
  { "as": "bob", "op": "call", "method": "revisePage", "args": { "slug": "getting-started", "body": "defaced" },
    "expect": { "error": "NotAuthor", "fields": { "slug": "getting-started" } } },
  { "as": "bob", "op": "call", "method": "renamePage", "args": { "slug": "getting-started", "title": "Forged" },
    "expect": { "error": "NotAuthor", "fields": { "slug": "getting-started" } } },
  { "as": "bob", "op": "call", "method": "tagPage", "args": { "slug": "getting-started", "tag": "spam" },
    "expect": { "error": "NotAuthor", "fields": { "slug": "getting-started" } } },
  { "as": "bob", "op": "call", "method": "deletePage", "args": { "slug": "getting-started" },
    "expect": { "error": "NotAuthor", "fields": { "slug": "getting-started" } } },
  { "as": "bob", "op": "call", "method": "revisePage", "args": { "slug": "home", "body": "mine now" },
    "expect": { "error": "NotAuthor", "fields": { "slug": "home" } } },
  { "as": "bob", "op": "call", "method": "revisePage", "args": { "slug": "nowhere", "body": "x" },
    "expect": { "error": "NoPage", "fields": { "slug": "nowhere" } } },
  { "as": "alice", "op": "call", "method": "revisePage", "args": { "slug": "getting-started", "body": "install meroctl, then sign in" }, "expect": { "ok": 2 } },
  { "as": "alice", "op": "call", "method": "renamePage", "args": { "slug": "getting-started", "title": "Start here" }, "expect": { "ok": null } },
  { "as": "bob", "op": "view", "method": "history", "args": { "slug": "getting-started" },
    "expect": { "ok": [ { "revision": 1, "body": "install meroctl" }, { "revision": 2, "body": "install meroctl, then sign in" } ] } },
  { "as": "alice", "op": "call", "method": "tagPage", "args": { "slug": "getting-started", "tag": "pear" }, "expect": { "ok": true } },
  { "as": "bob", "op": "call", "method": "createPage", "args": { "title": "Fruit", "body": "a list" }, "expect": { "ok": "fruit" } },
  { "as": "bob", "op": "call", "method": "tagPage", "args": { "slug": "fruit", "tag": "apple" }, "expect": { "ok": true } },
  { "as": "bob", "op": "call", "method": "tagPage", "args": { "slug": "fruit", "tag": " Apricot " }, "expect": { "ok": true } },
  { "as": "alice", "op": "call", "method": "tagPage", "args": { "slug": "getting-started", "tag": "APPLE" }, "expect": { "ok": true } },
  { "as": "alice", "op": "call", "method": "tagPage", "args": { "slug": "getting-started", "tag": "pear" }, "expect": { "ok": false },
    "events": { "bob": ["PageChanged", "PageChanged", "PageChanged", "PageChanged", "PageChanged", "PageChanged", "PageChanged", "PageChanged"] } },
  { "as": "bob", "op": "view", "method": "tags", "args": { "offset": 0, "limit": 10 }, "expect": { "ok": ["apple", "apricot", "pear"] } },
  { "as": "bob", "op": "view", "method": "tagsStartingWith", "args": { "prefix": "ap" }, "expect": { "ok": ["apple", "apricot"] } },
  { "as": "bob", "op": "view", "method": "tagsBetween", "args": { "start": "apricot", "end": "pear" }, "expect": { "ok": ["apricot"] } },
  { "as": "bob", "op": "view", "method": "tags", "args": { "offset": 2, "limit": 2 }, "expect": { "ok": ["pear"] } },
  { "as": "bob", "op": "view", "method": "tags", "args": { "offset": 3, "limit": 2 }, "expect": { "ok": [] } },
  { "as": "bob", "op": "view", "method": "tagStats", "expect": { "ok": { "count": "3", "first": "apple", "last": "pear" } } },
  { "as": "bob", "op": "view", "method": "pagesTagged", "args": { "tag": "apple" }, "expect": { "ok": ["fruit", "getting-started"] } },
  { "as": "bob", "op": "call", "method": "untagPage", "args": { "slug": "fruit", "tag": "apple" }, "expect": { "ok": true } },
  { "as": "bob", "op": "call", "method": "untagPage", "args": { "slug": "fruit", "tag": "apple" }, "expect": { "ok": false } },
  { "as": "bob", "op": "view", "method": "pagesTagged", "args": { "tag": "apple" }, "expect": { "ok": ["getting-started"] } },
  { "as": "alice", "op": "call", "method": "deletePage", "args": { "slug": "getting-started" }, "expect": { "ok": true } },
  { "as": "alice", "op": "call", "method": "deletePage", "args": { "slug": "getting-started" }, "expect": { "ok": false },
    "events": { "bob": ["PageChanged", "PageChanged", "PageChanged", "PageChanged", "PageChanged", "PageChanged", "PageChanged", "PageChanged", "PageChanged", "PageChanged"] } },
  { "as": "bob", "op": "view", "method": "tagStats", "expect": { "ok": { "count": "1", "first": "apricot", "last": "apricot" } } },
  { "as": "bob", "op": "view", "method": "history", "args": { "slug": "getting-started" }, "expect": { "ok": [] } },
  { "as": "bob", "op": "view", "method": "pages",
    "expect": { "ok": [ { "slug": "fruit", "title": "Fruit", "author": "@bob" }, { "slug": "home", "title": "Home", "author": "@owner" } ] } },
  { "as": "gus", "op": "view", "method": "pagesTagged", "args": { "tag": "apricot" }, "expect": { "ok": ["fruit"] } },
  { "as": "gus", "op": "call", "method": "createPage", "args": { "title": "Guest page", "body": "" }, "expect": { "error": "Forbidden" } },
  { "as": "carol", "op": "view", "method": "page", "args": { "slug": "home" }, "expect": { "refused": "NOT_FOUND" } },
  { "as": "owner", "op": "call", "method": "revisePage", "args": { "slug": "home", "body": "Read Start here first." }, "expect": { "ok": 2 } }
]
