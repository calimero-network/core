{
  "name": "Collaborative Editor Concurrent Workflow",
  "description": "Two-node concurrent editing over RGA: each writer types a passage then a heading, and both replicas must agree.\n",
  "comment": [
    "Migrated from this file's v1 workflow by `merobox cloud port`.",
    "Each of the original scenario's nodes is an account here; see merobox/cloud_v2/port.py for the mapping.",
    "Dropped (no counterpart in this node):",
    "  wait_for_sync x2: replication is synchronous: a read sees every committed write"
  ],
  "cluster": {
    "nodes": 3
  },
  "accounts": [
    "calimero-node-1",
    "calimero-node-2"
  ],
  "steps": [
    {
      "name": "Install Collaborative Editor on Node 1",
      "type": "upload_bundle",
      "wasm": "{{env.CORE_WASM_DIR}}/collaborative_editor.wasm",
      "outputs": {
        "app_id_bundle": "hash"
      },
      "account": "calimero-node-1"
    },
    {
      "type": "set",
      "values": {
        "app_id": "com.calimero.collaborative-editor"
      }
    },
    {
      "name": "Create Mesh",
      "type": "create_org",
      "account": "calimero-node-1",
      "org_name": "mesh",
      "outputs": {
        "namespace_id": "orgId"
      }
    },
    {
      "type": "invite",
      "account": "calimero-node-1",
      "org": "{{namespace_id}}",
      "role": "member",
      "outputs": {
        "_mesh_invite": "token"
      }
    },
    {
      "type": "redeem_invite",
      "account": "calimero-node-2",
      "token": "{{_mesh_invite}}"
    },
    {
      "name": "Create Mesh",
      "type": "deploy",
      "account": "calimero-node-1",
      "org": "{{namespace_id}}",
      "wasm": "{{env.CORE_WASM_DIR}}/collaborative_editor.wasm",
      "app_name": "Create Mesh",
      "outputs": {
        "context_id": "contextId",
        "member_public_key": "memberPublicKey"
      }
    },
    {
      "name": "Seed the document from Node 1",
      "type": "call",
      "app": "{{context_id}}",
      "method": "insert_text",
      "args": {
        "position": 0,
        "text": "existing text. "
      },
      "account": "calimero-node-1"
    },
    {
      "name": "Get Seeded Text (Node 2)",
      "type": "call",
      "app": "{{context_id}}",
      "method": "get_text",
      "args": {},
      "account": "calimero-node-2",
      "outputs": {
        "seeded_text_node2": "rpc"
      }
    },
    {
      "name": "Assert Node 2 genuinely has the seeded text",
      "type": "json_assert",
      "statements": [
        "json_equal({{seeded_text_node2}}, {\"output\": \"existing text. \"})"
      ]
    },
    {
      "name": "Node 1 types passage",
      "type": "call",
      "app": "{{context_id}}",
      "method": "insert_text",
      "args": {
        "position": 15,
        "text": "PASSAGE1"
      },
      "account": "calimero-node-1"
    },
    {
      "name": "Node 1 goes back and types heading",
      "type": "call",
      "app": "{{context_id}}",
      "method": "insert_text",
      "args": {
        "position": 15,
        "text": "HEAD1"
      },
      "account": "calimero-node-1"
    },
    {
      "name": "Node 2 types passage",
      "type": "call",
      "app": "{{context_id}}",
      "method": "insert_text",
      "args": {
        "position": 15,
        "text": "PASSAGE2"
      },
      "account": "calimero-node-2"
    },
    {
      "name": "Node 2 goes back and types heading",
      "type": "call",
      "app": "{{context_id}}",
      "method": "insert_text",
      "args": {
        "position": 15,
        "text": "HEAD2"
      },
      "account": "calimero-node-2"
    },
    {
      "name": "Get Text After Interleaving (Node 1)",
      "type": "call",
      "app": "{{context_id}}",
      "method": "get_text",
      "args": {},
      "account": "calimero-node-1",
      "outputs": {
        "interleave_text_node1": "rpc"
      }
    },
    {
      "name": "Get Text After Interleaving (Node 2)",
      "type": "call",
      "app": "{{context_id}}",
      "method": "get_text",
      "args": {},
      "account": "calimero-node-2",
      "outputs": {
        "interleave_text_node2": "rpc"
      }
    },
    {
      "name": "Assert both nodes converged on interleaving case",
      "type": "json_assert",
      "statements": [
        "json_equal({{interleave_text_node1}}, {{interleave_text_node2}})"
      ]
    },
    {
      "name": "Assert every contribution survived",
      "type": "assert",
      "statements": [
        "contains({{interleave_text_node1}}, 'HEAD1')",
        "contains({{interleave_text_node1}}, 'PASSAGE1')",
        "contains({{interleave_text_node1}}, 'HEAD2')",
        "contains({{interleave_text_node1}}, 'PASSAGE2')"
      ]
    }
  ]
}
