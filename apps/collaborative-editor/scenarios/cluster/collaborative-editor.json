{
  "name": "Collaborative Editor Workflow",
  "description": "A workflow demonstrating collaborative text editing using RGA CRDT",
  "comment": [
    "Migrated from this file's v1 workflow by `merobox cloud port`.",
    "Each of the original scenario's nodes is an account here; see merobox/cloud_v2/port.py for the mapping.",
    "Dropped (no counterpart in this node):",
    "  wait_for_sync x9: replication is synchronous: a read sees every committed write"
  ],
  "cluster": {
    "nodes": 3
  },
  "accounts": [
    "calimero-node-1",
    "calimero-node-2"
  ],
  "steps": [
    {
      "name": "Install Collaborative Editor on Node 1",
      "type": "upload_bundle",
      "wasm": "{{env.CORE_WASM_DIR}}/collaborative_editor.wasm",
      "outputs": {
        "app_id_bundle": "hash"
      },
      "account": "calimero-node-1"
    },
    {
      "type": "set",
      "values": {
        "app_id": "com.calimero.collaborative-editor"
      }
    },
    {
      "name": "Create Mesh",
      "type": "create_org",
      "account": "calimero-node-1",
      "org_name": "mesh",
      "outputs": {
        "namespace_id": "orgId"
      }
    },
    {
      "type": "invite",
      "account": "calimero-node-1",
      "org": "{{namespace_id}}",
      "role": "member",
      "outputs": {
        "_mesh_invite": "token"
      }
    },
    {
      "type": "redeem_invite",
      "account": "calimero-node-2",
      "token": "{{_mesh_invite}}"
    },
    {
      "name": "Create Mesh",
      "type": "deploy",
      "account": "calimero-node-1",
      "org": "{{namespace_id}}",
      "wasm": "{{env.CORE_WASM_DIR}}/collaborative_editor.wasm",
      "app_name": "Create Mesh",
      "outputs": {
        "context_id": "contextId",
        "member_public_key": "memberPublicKey"
      }
    },
    {
      "name": "Get Initial Text (Node 1)",
      "type": "call",
      "app": "{{context_id}}",
      "method": "get_text",
      "args": {},
      "account": "calimero-node-1",
      "outputs": {
        "initial_text": "rpc"
      }
    },
    {
      "name": "Assert document is initially empty",
      "type": "json_assert",
      "statements": [
        "json_equal({{initial_text}}, {\"output\": \"\"})"
      ]
    },
    {
      "name": "Insert Hello from Node 1",
      "type": "call",
      "app": "{{context_id}}",
      "method": "insert_text",
      "args": {
        "position": 0,
        "text": "Hello"
      },
      "account": "calimero-node-1",
      "outputs": {
        "insert_hello_result": "rpc"
      }
    },
    {
      "name": "Assert Hello inserted successfully",
      "type": "json_assert",
      "statements": [
        "json_equal({{insert_hello_result}}, {\"output\": null})"
      ]
    },
    {
      "name": "Get Text After Hello (Node 1)",
      "type": "call",
      "app": "{{context_id}}",
      "method": "get_text",
      "args": {},
      "account": "calimero-node-1",
      "outputs": {
        "text_node1_hello": "rpc"
      }
    },
    {
      "name": "Assert Node 1 sees Hello",
      "type": "json_assert",
      "statements": [
        "json_equal({{text_node1_hello}}, {\"output\": \"Hello\"})"
      ]
    },
    {
      "name": "Get Text After Hello (Node 2)",
      "type": "call",
      "app": "{{context_id}}",
      "method": "get_text",
      "args": {},
      "account": "calimero-node-2",
      "outputs": {
        "text_node2_hello": "rpc"
      }
    },
    {
      "name": "Assert Node 2 sees Hello (synced)",
      "type": "json_assert",
      "statements": [
        "json_equal({{text_node2_hello}}, {\"output\": \"Hello\"})"
      ]
    },
    {
      "name": "Append World from Node 2",
      "type": "call",
      "app": "{{context_id}}",
      "method": "append_text",
      "args": {
        "text": " World"
      },
      "account": "calimero-node-2",
      "outputs": {
        "append_world_result": "rpc"
      }
    },
    {
      "name": "Get Text After World (Node 1)",
      "type": "call",
      "app": "{{context_id}}",
      "method": "get_text",
      "args": {},
      "account": "calimero-node-1",
      "outputs": {
        "text_node1_world": "rpc"
      }
    },
    {
      "name": "Assert Node 1 sees Hello World",
      "type": "json_assert",
      "statements": [
        "json_equal({{text_node1_world}}, {\"output\": \"Hello World\"})"
      ]
    },
    {
      "name": "Get Text After World (Node 2)",
      "type": "call",
      "app": "{{context_id}}",
      "method": "get_text",
      "args": {},
      "account": "calimero-node-2",
      "outputs": {
        "text_node2_world": "rpc"
      }
    },
    {
      "name": "Assert Node 2 sees Hello World",
      "type": "json_assert",
      "statements": [
        "json_equal({{text_node2_world}}, {\"output\": \"Hello World\"})"
      ]
    },
    {
      "name": "Insert Exclamation from Node 1",
      "type": "call",
      "app": "{{context_id}}",
      "method": "insert_text",
      "args": {
        "position": 11,
        "text": "!"
      },
      "account": "calimero-node-1",
      "outputs": {
        "insert_exclamation_result": "rpc"
      }
    },
    {
      "name": "Get Text After Exclamation (Node 1)",
      "type": "call",
      "app": "{{context_id}}",
      "method": "get_text",
      "args": {},
      "account": "calimero-node-1",
      "outputs": {
        "text_with_exclamation_node1": "rpc"
      }
    },
    {
      "name": "Assert Node 1 sees Hello World!",
      "type": "json_assert",
      "statements": [
        "json_equal({{text_with_exclamation_node1}}, {\"output\": \"Hello World!\"})"
      ]
    },
    {
      "name": "Get Text After Exclamation (Node 2)",
      "type": "call",
      "app": "{{context_id}}",
      "method": "get_text",
      "args": {},
      "account": "calimero-node-2",
      "outputs": {
        "text_with_exclamation_node2": "rpc"
      }
    },
    {
      "name": "Assert Node 2 sees Hello World!",
      "type": "json_assert",
      "statements": [
        "json_equal({{text_with_exclamation_node2}}, {\"output\": \"Hello World!\"})"
      ]
    },
    {
      "name": "Delete World from Node 2",
      "type": "call",
      "app": "{{context_id}}",
      "method": "delete_text",
      "args": {
        "start": 6,
        "end": 11
      },
      "account": "calimero-node-2",
      "outputs": {
        "delete_world_result": "rpc"
      }
    },
    {
      "name": "Get Text After Deletion (Node 1)",
      "type": "call",
      "app": "{{context_id}}",
      "method": "get_text",
      "args": {},
      "account": "calimero-node-1",
      "outputs": {
        "text_after_delete_node1": "rpc"
      }
    },
    {
      "name": "Assert Node 1 sees Hello !",
      "type": "json_assert",
      "statements": [
        "json_equal({{text_after_delete_node1}}, {\"output\": \"Hello !\"})"
      ]
    },
    {
      "name": "Get Text After Deletion (Node 2)",
      "type": "call",
      "app": "{{context_id}}",
      "method": "get_text",
      "args": {},
      "account": "calimero-node-2",
      "outputs": {
        "text_after_delete_node2": "rpc"
      }
    },
    {
      "name": "Assert Node 2 sees Hello !",
      "type": "json_assert",
      "statements": [
        "json_equal({{text_after_delete_node2}}, {\"output\": \"Hello !\"})"
      ]
    },
    {
      "name": "Insert CRDT from Node 1",
      "type": "call",
      "app": "{{context_id}}",
      "method": "insert_text",
      "args": {
        "position": 6,
        "text": "CRDT"
      },
      "account": "calimero-node-1",
      "outputs": {
        "insert_crdt_result": "rpc"
      }
    },
    {
      "name": "Get Text After CRDT Insert (Node 1)",
      "type": "call",
      "app": "{{context_id}}",
      "method": "get_text",
      "args": {},
      "account": "calimero-node-1",
      "outputs": {
        "text_with_crdt_node1": "rpc"
      }
    },
    {
      "name": "Assert Node 1 sees Hello CRDT!",
      "type": "json_assert",
      "statements": [
        "json_equal({{text_with_crdt_node1}}, {\"output\": \"Hello CRDT!\"})"
      ]
    },
    {
      "name": "Get Text After CRDT Insert (Node 2)",
      "type": "call",
      "app": "{{context_id}}",
      "method": "get_text",
      "args": {},
      "account": "calimero-node-2",
      "outputs": {
        "text_with_crdt_node2": "rpc"
      }
    },
    {
      "name": "Assert Node 2 sees Hello CRDT!",
      "type": "json_assert",
      "statements": [
        "json_equal({{text_with_crdt_node2}}, {\"output\": \"Hello CRDT!\"})"
      ]
    },
    {
      "name": "Replace CRDT with Calimero from Node 2",
      "type": "call",
      "app": "{{context_id}}",
      "method": "replace_text",
      "args": {
        "start": 6,
        "end": 10,
        "text": "Calimero"
      },
      "account": "calimero-node-2",
      "outputs": {
        "replace_result": "rpc"
      }
    },
    {
      "name": "Get Text After Replace (Node 1)",
      "type": "call",
      "app": "{{context_id}}",
      "method": "get_text",
      "args": {},
      "account": "calimero-node-1",
      "outputs": {
        "text_after_replace_node1": "rpc"
      }
    },
    {
      "name": "Assert Node 1 sees Hello Calimero!",
      "type": "json_assert",
      "statements": [
        "json_equal({{text_after_replace_node1}}, {\"output\": \"Hello Calimero!\"})"
      ]
    },
    {
      "name": "Get Text After Replace (Node 2)",
      "type": "call",
      "app": "{{context_id}}",
      "method": "get_text",
      "args": {},
      "account": "calimero-node-2",
      "outputs": {
        "text_after_replace_node2": "rpc"
      }
    },
    {
      "name": "Assert Node 2 sees Hello Calimero!",
      "type": "json_assert",
      "statements": [
        "json_equal({{text_after_replace_node2}}, {\"output\": \"Hello Calimero!\"})"
      ]
    },
    {
      "name": "Get Document Length (Node 1)",
      "type": "call",
      "app": "{{context_id}}",
      "method": "get_length",
      "args": {},
      "account": "calimero-node-1",
      "outputs": {
        "doc_length": "rpc"
      }
    },
    {
      "name": "Assert length is correct (15 characters)",
      "type": "json_assert",
      "statements": [
        "json_equal({{doc_length}}, {\"output\": 15})"
      ]
    },
    {
      "name": "Check if Document is Empty (Node 1)",
      "type": "call",
      "app": "{{context_id}}",
      "method": "is_empty",
      "args": {},
      "account": "calimero-node-1",
      "outputs": {
        "is_empty_result": "rpc"
      }
    },
    {
      "name": "Assert document is not empty",
      "type": "json_assert",
      "statements": [
        "json_equal({{is_empty_result}}, {\"output\": false})"
      ]
    },
    {
      "name": "Get Initial Title (Node 1)",
      "type": "call",
      "app": "{{context_id}}",
      "method": "get_title",
      "args": {},
      "account": "calimero-node-1",
      "outputs": {
        "initial_title": "rpc"
      }
    },
    {
      "name": "Assert title is Untitled Document",
      "type": "json_assert",
      "statements": [
        "json_equal({{initial_title}}, {\"output\": \"Untitled Document\"})"
      ]
    },
    {
      "name": "Set New Title from Node 2",
      "type": "call",
      "app": "{{context_id}}",
      "method": "set_title",
      "args": {
        "new_title": "Collaborative Editor Demo"
      },
      "account": "calimero-node-2",
      "outputs": {
        "set_title_result": "rpc"
      }
    },
    {
      "name": "Get New Title (Node 1)",
      "type": "call",
      "app": "{{context_id}}",
      "method": "get_title",
      "args": {},
      "account": "calimero-node-1",
      "outputs": {
        "new_title_node1": "rpc"
      }
    },
    {
      "name": "Assert title changed on Node 1",
      "type": "json_assert",
      "statements": [
        "json_equal({{new_title_node1}}, {\"output\": \"Collaborative Editor Demo\"})"
      ]
    },
    {
      "name": "Get New Title (Node 2)",
      "type": "call",
      "app": "{{context_id}}",
      "method": "get_title",
      "args": {},
      "account": "calimero-node-2",
      "outputs": {
        "new_title_node2": "rpc"
      }
    },
    {
      "name": "Assert title changed on Node 2",
      "type": "json_assert",
      "statements": [
        "json_equal({{new_title_node2}}, {\"output\": \"Collaborative Editor Demo\"})"
      ]
    },
    {
      "name": "Get Document Stats (Node 1)",
      "type": "call",
      "app": "{{context_id}}",
      "method": "get_stats",
      "args": {},
      "account": "calimero-node-1",
      "outputs": {
        "stats": "rpc"
      }
    },
    {
      "name": "Assert stats call succeeded",
      "type": "assert",
      "statements": [
        "is_set({{stats}})"
      ]
    },
    {
      "name": "Clear Document from Node 1",
      "type": "call",
      "app": "{{context_id}}",
      "method": "clear",
      "args": {},
      "account": "calimero-node-1",
      "outputs": {
        "clear_result": "rpc"
      }
    },
    {
      "name": "Get Text After Clear (Node 1)",
      "type": "call",
      "app": "{{context_id}}",
      "method": "get_text",
      "args": {},
      "account": "calimero-node-1",
      "outputs": {
        "text_after_clear_node1": "rpc"
      }
    },
    {
      "name": "Assert Node 1 document is empty",
      "type": "json_assert",
      "statements": [
        "json_equal({{text_after_clear_node1}}, {\"output\": \"\"})"
      ]
    },
    {
      "name": "Get Text After Clear (Node 2)",
      "type": "call",
      "app": "{{context_id}}",
      "method": "get_text",
      "args": {},
      "account": "calimero-node-2",
      "outputs": {
        "text_after_clear_node2": "rpc"
      }
    },
    {
      "name": "Assert Node 2 document is empty",
      "type": "json_assert",
      "statements": [
        "json_equal({{text_after_clear_node2}}, {\"output\": \"\"})"
      ]
    },
    {
      "name": "Check if Document is Empty After Clear (Node 1)",
      "type": "call",
      "app": "{{context_id}}",
      "method": "is_empty",
      "args": {},
      "account": "calimero-node-1",
      "outputs": {
        "is_empty_after_clear": "rpc"
      }
    },
    {
      "name": "Assert document is now empty",
      "type": "json_assert",
      "statements": [
        "json_equal({{is_empty_after_clear}}, {\"output\": true})"
      ]
    },
    {
      "name": "Insert ABC from Node 1",
      "type": "call",
      "app": "{{context_id}}",
      "method": "insert_text",
      "args": {
        "position": 0,
        "text": "ABC"
      },
      "account": "calimero-node-1",
      "outputs": {
        "insert_abc_result": "rpc"
      }
    },
    {
      "name": "Insert XYZ from Node 2",
      "type": "call",
      "app": "{{context_id}}",
      "method": "insert_text",
      "args": {
        "position": 0,
        "text": "XYZ"
      },
      "account": "calimero-node-2",
      "outputs": {
        "insert_xyz_result": "rpc"
      }
    },
    {
      "name": "Get Text After Concurrent Edits (Node 1)",
      "type": "call",
      "app": "{{context_id}}",
      "method": "get_text",
      "args": {},
      "account": "calimero-node-1",
      "outputs": {
        "text_concurrent_node1": "rpc"
      }
    },
    {
      "name": "Get Text After Concurrent Edits (Node 2)",
      "type": "call",
      "app": "{{context_id}}",
      "method": "get_text",
      "args": {},
      "account": "calimero-node-2",
      "outputs": {
        "text_concurrent_node2": "rpc"
      }
    },
    {
      "name": "Assert both nodes have same text (convergence)",
      "type": "json_assert",
      "statements": [
        "json_equal({{text_concurrent_node1}}, {{text_concurrent_node2}})"
      ]
    },
    {
      "name": "Get Length After Concurrent Edits (Node 1)",
      "type": "call",
      "app": "{{context_id}}",
      "method": "get_length",
      "args": {},
      "account": "calimero-node-1",
      "outputs": {
        "length_concurrent": "rpc"
      }
    },
    {
      "name": "Assert total length is 6 (ABC + XYZ)",
      "type": "json_assert",
      "statements": [
        "json_equal({{length_concurrent}}, {\"output\": 6})"
      ]
    }
  ]
}
