{
  "name": "TEE cards",
  "description": "Seats, draws dealt by the cluster's TEE handler, sealed hands read only by their player",
  "comment": [
    "A workflow for tee-cards (its v1 workflows were about TEE",
    "authorities, their failover and the namespace TEE key, deleted with no",
    "counterpart: the cluster is every app's TEE). This one plays the game: a",
    "draw asks the TEE (a `tee:` handler the leader runs once), which deals from a",
    "deck only it reads, sealed to the player; each player reads only their own",
    "hand."
  ],
  "cluster": {
    "nodes": 3
  },
  "accounts": [
    "alice",
    "bob",
    "carol"
  ],
  "steps": [
    {
      "name": "Alice founds an organization",
      "type": "create_org",
      "account": "alice",
      "org_name": "Cards",
      "outputs": {
        "org": "orgId"
      }
    },
    {
      "name": "An invite for Bob",
      "type": "invite",
      "account": "alice",
      "org": "{{org}}",
      "role": "member",
      "outputs": {
        "token": "token"
      }
    },
    {
      "name": "Bob joins",
      "type": "redeem_invite",
      "account": "bob",
      "token": "{{token}}"
    },
    {
      "name": "Alice deploys tee-cards in the organization",
      "type": "deploy",
      "account": "alice",
      "wasm": "{{env.CORE_WASM_DIR}}/tee_cards.wasm",
      "app_name": "tee-cards",
      "org": "{{org}}",
      "outputs": {
        "app": "appId"
      }
    },
    {
      "name": "Alice's account key (the app names players by it)",
      "type": "whoami",
      "account": "alice",
      "outputs": {
        "alice_key": "publicKey"
      }
    },
    {
      "name": "Bob's account key",
      "type": "whoami",
      "account": "bob",
      "outputs": {
        "bob_key": "publicKey"
      }
    },
    {
      "name": "A player must sit before drawing",
      "type": "call",
      "account": "bob",
      "app": "{{app}}",
      "method": "draw",
      "expected_failure": true,
      "outputs": {
        "unseated": "error"
      }
    },
    {
      "name": "The app refused the unseated draw",
      "type": "assert",
      "statements": [
        "contains(\"{{unseated}}\", \"NotSeated\")"
      ]
    },
    {
      "name": "Alice sits",
      "type": "call",
      "account": "alice",
      "app": "{{app}}",
      "method": "sit"
    },
    {
      "name": "Bob sits",
      "type": "call",
      "account": "bob",
      "app": "{{app}}",
      "method": "sit"
    },
    {
      "name": "Alice draws",
      "type": "call",
      "account": "alice",
      "app": "{{app}}",
      "method": "draw"
    },
    {
      "name": "The TEE deals Alice one card",
      "type": "wait_for",
      "account": "bob",
      "app": "{{app}}",
      "method": "hand_size",
      "args": {
        "player": "{{alice_key}}"
      },
      "equals": 1,
      "timeout": 30
    },
    {
      "name": "Bob draws twice",
      "type": "call",
      "account": "bob",
      "app": "{{app}}",
      "method": "draw"
    },
    {
      "name": "Bob's second draw",
      "type": "call",
      "account": "bob",
      "app": "{{app}}",
      "method": "draw"
    },
    {
      "name": "The TEE deals Bob two cards",
      "type": "wait_for",
      "account": "alice",
      "app": "{{app}}",
      "method": "hand_size",
      "args": {
        "player": "{{bob_key}}"
      },
      "equals": 2,
      "timeout": 30
    },
    {
      "name": "Three cards left the deck of 52",
      "type": "view",
      "account": "alice",
      "app": "{{app}}",
      "method": "cards_left",
      "expect": 49
    },
    {
      "name": "Alice opens her own hand",
      "type": "view",
      "account": "alice",
      "app": "{{app}}",
      "method": "my_hand",
      "outputs": {
        "alice_hand": "result"
      }
    },
    {
      "name": "Bob opens his own hand",
      "type": "view",
      "account": "bob",
      "app": "{{app}}",
      "method": "my_hand",
      "outputs": {
        "bob_hand": "result"
      }
    },
    {
      "name": "Each opens exactly the cards dealt to them, all different",
      "type": "json_assert",
      "statements": [
        "json_not_equal({{alice_hand}}, [])",
        "json_not_equal({{bob_hand}}, [])",
        "json_not_equal({{alice_hand}}, {{bob_hand}})"
      ]
    },
    {
      "name": "A member may not run the TEE's deal itself",
      "type": "call",
      "account": "bob",
      "app": "{{app}}",
      "method": "deal",
      "args": {
        "player": "{{bob_key}}"
      },
      "expected_failure": true
    },
    {
      "name": "Bob still holds two",
      "type": "view",
      "account": "alice",
      "app": "{{app}}",
      "method": "hand_size",
      "args": {
        "player": "{{bob_key}}"
      },
      "expect": 2
    },
    {
      "name": "Carol is outside the organization",
      "type": "call",
      "account": "carol",
      "app": "{{app}}",
      "method": "sit",
      "expected_error": "NOT_FOUND"
    }
  ]
}
