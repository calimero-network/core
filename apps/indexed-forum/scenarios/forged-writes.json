[
  { "as": "owner", "op": "call", "method": "createPost",
    "args": { "id": "p1", "board": "dev", "title": "owner's post", "body": "b", "tags": ["rust"], "createdAt": "10" }, "save": "p1" },
  { "as": "owner", "op": "call", "method": "comment", "args": { "post": "$p1", "id": "c1", "body": "owner's comment", "createdAt": "11" }, "save": "c1" },
  { "as": "owner", "op": "call", "method": "vote", "args": { "post": "$p1" }, "expect": { "ok": "1" } },
  { "as": "mallory", "op": "call", "method": "editPost", "args": { "id": "$p1", "title": "forged", "body": "forged" },
    "expect": { "error": "NotAuthor", "fields": { "id": "$p1" } } },
  { "as": "mallory", "op": "call", "method": "retag", "args": { "id": "$p1", "tags": ["spam"] },
    "expect": { "error": "NotAuthor", "fields": { "id": "$p1" } } },
  { "as": "mallory", "op": "call", "method": "pin", "args": { "id": "$p1", "at": "99" },
    "expect": { "error": "NotAuthor", "fields": { "id": "$p1" } } },
  { "as": "mallory", "op": "call", "method": "unpin", "args": { "id": "$p1" },
    "expect": { "error": "NotAuthor", "fields": { "id": "$p1" } } },
  { "as": "mallory", "op": "call", "method": "deletePost", "args": { "id": "$p1" },
    "expect": { "error": "NotAuthor", "fields": { "id": "$p1" } } },
  { "as": "mallory", "op": "call", "method": "moderatePost", "args": { "id": "$p1" },
    "expect": { "error": "NotModerator", "fields": { "id": "$p1" } } },
  { "as": "mallory", "op": "call", "method": "editComment", "args": { "key": "$c1", "body": "forged" },
    "expect": { "error": "NoComment", "fields": { "key": "$c1" } } },
  { "as": "mallory", "op": "call", "method": "deleteComment", "args": { "key": "$c1" },
    "expect": { "error": "NoComment", "fields": { "key": "$c1" } } },
  { "as": "mallory", "op": "call", "method": "unvote", "args": { "post": "$p1" }, "expect": { "ok": "1" } },
  { "as": "mallory", "op": "call", "method": "createPost",
    "args": { "id": "p1", "board": "dev", "title": "mallory's post", "body": "", "tags": ["rust"], "createdAt": "12" }, "save": "p1m" },
  { "as": "owner", "op": "view", "method": "getPost", "args": { "id": "$p1" },
    "expect": { "ok": { "id": "$p1", "board": "dev", "author": "@owner", "title": "owner's post", "body": "b", "tags": ["rust"],
      "createdAt": "10", "pinned": false, "votes": "1", "comments": "1", "votedByMe": true } } },
  { "as": "owner", "op": "view", "method": "getPost", "args": { "id": "$p1m" },
    "expect": { "ok": { "id": "$p1m", "board": "dev", "author": "@mallory", "title": "mallory's post", "body": "", "tags": ["rust"],
      "createdAt": "12", "pinned": false, "votes": "0", "comments": "0", "votedByMe": false } } },
  { "as": "owner", "op": "view", "method": "comments", "args": { "post": "$p1", "offset": 0, "limit": 10 },
    "expect": { "ok": [ { "key": "$c1", "author": "@owner", "body": "owner's comment", "createdAt": "11" } ] } },
  { "as": "owner", "op": "view", "method": "authorFeed", "args": { "author": "@owner", "limit": 10 },
    "expect": { "ok": [ { "id": "$p1", "board": "dev", "author": "@owner", "title": "owner's post", "body": "b", "tags": ["rust"],
      "createdAt": "10", "pinned": false, "votes": "1", "comments": "1", "votedByMe": true } ] } }
]
