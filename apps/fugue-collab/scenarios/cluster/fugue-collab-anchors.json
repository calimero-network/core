{
  "name": "Fugue Collab Anchors",
  "description": "A cursor minted on one node, passed around as an opaque token, must name the same place on every node after edits before it, after it, and a delete of its character.\n",
  "comment": [
    "Migrated from this file's v1 workflow by `merobox cloud port`.",
    "Each of the original scenario's nodes is an account here; see merobox/cloud_v2/port.py for the mapping.",
    "Dropped (no counterpart in this node):",
    "  wait_for_sync x2: replication is synchronous: a read sees every committed write"
  ],
  "cluster": {
    "nodes": 3
  },
  "accounts": [
    "fugue-node-1",
    "fugue-node-2"
  ],
  "steps": [
    {
      "name": "Install fugue-collab on Node 1",
      "type": "upload_bundle",
      "wasm": "{{env.CORE_WASM_DIR}}/fugue_collab.wasm",
      "outputs": {
        "app_id_bundle": "hash"
      },
      "account": "fugue-node-1"
    },
    {
      "type": "set",
      "values": {
        "app_id": "com.calimero.fugue-collab"
      }
    },
    {
      "name": "Create a 2-node mesh",
      "type": "create_org",
      "account": "fugue-node-1",
      "org_name": "mesh",
      "outputs": {
        "namespace_id": "orgId"
      }
    },
    {
      "type": "invite",
      "account": "fugue-node-1",
      "org": "{{namespace_id}}",
      "role": "member",
      "outputs": {
        "_mesh_invite": "token"
      }
    },
    {
      "type": "redeem_invite",
      "account": "fugue-node-2",
      "token": "{{_mesh_invite}}"
    },
    {
      "name": "Create a 2-node mesh",
      "type": "deploy",
      "account": "fugue-node-1",
      "org": "{{namespace_id}}",
      "wasm": "{{env.CORE_WASM_DIR}}/fugue_collab.wasm",
      "app_name": "Create a 2-node mesh",
      "outputs": {
        "context_id": "contextId"
      }
    },
    {
      "name": "Node 1 types the document",
      "type": "call",
      "app": "{{context_id}}",
      "method": "insert_text",
      "args": {
        "position": 0,
        "text": "hello world"
      },
      "account": "fugue-node-1"
    },
    {
      "name": "Node 1 anchors the gap before \"w\"",
      "type": "call",
      "app": "{{context_id}}",
      "method": "anchor_at",
      "args": {
        "position": 6,
        "before": true
      },
      "account": "fugue-node-1",
      "outputs": {
        "anchor_w": "result"
      }
    },
    {
      "name": "Node 1 anchors the gap before \"e\"",
      "type": "call",
      "app": "{{context_id}}",
      "method": "anchor_at",
      "args": {
        "position": 1,
        "before": true
      },
      "account": "fugue-node-1",
      "outputs": {
        "anchor_e": "result"
      }
    },
    {
      "name": "Node 2 appends after the anchors",
      "type": "call",
      "app": "{{context_id}}",
      "method": "insert_text",
      "args": {
        "position": 11,
        "text": "BB"
      },
      "account": "fugue-node-2"
    },
    {
      "name": "Node 2 deletes the anchored \"e\"",
      "type": "call",
      "app": "{{context_id}}",
      "method": "delete_range",
      "args": {
        "start": 1,
        "end": 2
      },
      "account": "fugue-node-2"
    },
    {
      "name": "Node 1 inserts before the anchors",
      "type": "call",
      "app": "{{context_id}}",
      "method": "insert_text",
      "args": {
        "position": 0,
        "text": "AA"
      },
      "account": "fugue-node-1"
    },
    {
      "name": "Node 1 resolves the \"w\" anchor",
      "type": "call",
      "app": "{{context_id}}",
      "method": "resolve_anchor",
      "args": {
        "anchor": "{{anchor_w}}"
      },
      "account": "fugue-node-1",
      "outputs": {
        "w_on_1": "result"
      }
    },
    {
      "name": "Node 2 resolves the \"w\" anchor",
      "type": "call",
      "app": "{{context_id}}",
      "method": "resolve_anchor",
      "args": {
        "anchor": "{{anchor_w}}"
      },
      "account": "fugue-node-2",
      "outputs": {
        "w_on_2": "result"
      }
    },
    {
      "name": "Node 1 resolves the deleted \"e\" anchor",
      "type": "call",
      "app": "{{context_id}}",
      "method": "resolve_anchor",
      "args": {
        "anchor": "{{anchor_e}}"
      },
      "account": "fugue-node-1",
      "outputs": {
        "e_on_1": "result"
      }
    },
    {
      "name": "Node 2 resolves the deleted \"e\" anchor",
      "type": "call",
      "app": "{{context_id}}",
      "method": "resolve_anchor",
      "args": {
        "anchor": "{{anchor_e}}"
      },
      "account": "fugue-node-2",
      "outputs": {
        "e_on_2": "result"
      }
    },
    {
      "name": "Every node resolves each anchor to the same place",
      "type": "assert",
      "statements": [
        "{{w_on_1}} == 7",
        "{{w_on_2}} == 7",
        "{{e_on_1}} == 3",
        "{{e_on_2}} == 3"
      ]
    }
  ]
}
