{
  "name": "Fugue Collab Late Joiner",
  "description": "A node joins a context whose document already runs past the run cap and has a range tombstoned out of the middle, and must arrive at the same text.\n",
  "comment": [
    "Migrated from this file's v1 workflow by `merobox cloud port`.",
    "Each of the original scenario's nodes is an account here; see merobox/cloud_v2/port.py for the mapping.",
    "Dropped (no counterpart in this node):",
    "  wait_for_sync x4: replication is synchronous: a read sees every committed write"
  ],
  "cluster": {
    "nodes": 3
  },
  "accounts": [
    "fugue-node-1",
    "fugue-node-2",
    "fugue-node-3"
  ],
  "steps": [
    {
      "name": "Install fugue-collab on Node 1",
      "type": "upload_bundle",
      "wasm": "{{env.CORE_WASM_DIR}}/fugue_collab.wasm",
      "outputs": {
        "app_id_bundle": "hash"
      },
      "account": "fugue-node-1"
    },
    {
      "type": "set",
      "values": {
        "app_id": "com.calimero.fugue-collab"
      }
    },
    {
      "name": "Create a 2-node mesh without Node 3",
      "type": "create_org",
      "account": "fugue-node-1",
      "org_name": "mesh",
      "outputs": {
        "namespace_id": "orgId"
      }
    },
    {
      "type": "invite",
      "account": "fugue-node-1",
      "org": "{{namespace_id}}",
      "role": "member",
      "outputs": {
        "_mesh_invite": "token"
      }
    },
    {
      "type": "redeem_invite",
      "account": "fugue-node-2",
      "token": "{{_mesh_invite}}"
    },
    {
      "name": "Create a 2-node mesh without Node 3",
      "type": "deploy",
      "account": "fugue-node-1",
      "org": "{{namespace_id}}",
      "wasm": "{{env.CORE_WASM_DIR}}/fugue_collab.wasm",
      "app_name": "Create a 2-node mesh without Node 3",
      "outputs": {
        "context_id": "contextId"
      }
    },
    {
      "name": "Node 1 pastes 400 characters, crossing the run cap",
      "type": "call",
      "app": "{{context_id}}",
      "method": "insert_text",
      "args": {
        "position": 0,
        "text": ""
      },
      "account": "fugue-node-1"
    },
    {
      "name": "Node 2 inserts a marker inside the full first block",
      "type": "call",
      "app": "{{context_id}}",
      "method": "insert_text",
      "args": {
        "position": 200,
        "text": "[MID]"
      },
      "account": "fugue-node-2"
    },
    {
      "name": "Node 1 deletes ten characters straddling the cap boundary",
      "type": "call",
      "app": "{{context_id}}",
      "method": "delete_range",
      "args": {
        "start": 256,
        "end": 266
      },
      "account": "fugue-node-1"
    },
    {
      "name": "Create a namespace invitation for Node 3",
      "type": "invite",
      "org": "{{namespace_id}}",
      "role": "member",
      "account": "fugue-node-1",
      "outputs": {
        "invitation_3": "token"
      }
    },
    {
      "name": "Node 3 joins the namespace",
      "type": "redeem_invite",
      "token": "{{invitation_3}}",
      "account": "fugue-node-3"
    }
  ]
}
