{
  "name": "Fugue Collab Undo",
  "description": "Undo is local: a node undoes its own delete by re-inserting the text where it was, and its own insert by deleting exactly the characters it minted, while another node edits.\n",
  "comment": [
    "Migrated from this file's v1 workflow by `merobox cloud port`.",
    "Each of the original scenario's nodes is an account here; see merobox/cloud_v2/port.py for the mapping.",
    "Dropped (no counterpart in this node):",
    "  wait_for_sync x3: replication is synchronous: a read sees every committed write"
  ],
  "cluster": {
    "nodes": 3
  },
  "accounts": [
    "fugue-node-1",
    "fugue-node-2"
  ],
  "steps": [
    {
      "name": "Install fugue-collab on Node 1",
      "type": "upload_bundle",
      "wasm": "{{env.CORE_WASM_DIR}}/fugue_collab.wasm",
      "outputs": {
        "app_id_bundle": "hash"
      },
      "account": "fugue-node-1"
    },
    {
      "type": "set",
      "values": {
        "app_id": "com.calimero.fugue-collab"
      }
    },
    {
      "name": "Create a 2-node mesh",
      "type": "create_org",
      "account": "fugue-node-1",
      "org_name": "mesh",
      "outputs": {
        "namespace_id": "orgId"
      }
    },
    {
      "type": "invite",
      "account": "fugue-node-1",
      "org": "{{namespace_id}}",
      "role": "member",
      "outputs": {
        "_mesh_invite": "token"
      }
    },
    {
      "type": "redeem_invite",
      "account": "fugue-node-2",
      "token": "{{_mesh_invite}}"
    },
    {
      "name": "Create a 2-node mesh",
      "type": "deploy",
      "account": "fugue-node-1",
      "org": "{{namespace_id}}",
      "wasm": "{{env.CORE_WASM_DIR}}/fugue_collab.wasm",
      "app_name": "Create a 2-node mesh",
      "outputs": {
        "context_id": "contextId"
      }
    },
    {
      "name": "Node 1 types the document",
      "type": "call",
      "app": "{{context_id}}",
      "method": "insert_text",
      "args": {
        "position": 0,
        "text": "hello world"
      },
      "account": "fugue-node-1"
    },
    {
      "name": "Node 1 deletes a word",
      "type": "call",
      "app": "{{context_id}}",
      "method": "delete_range_tracked",
      "args": {
        "start": 6,
        "end": 11
      },
      "account": "fugue-node-1",
      "outputs": {
        "cut": "result"
      }
    },
    {
      "name": "Node 2 inserts at the start",
      "type": "call",
      "app": "{{context_id}}",
      "method": "insert_text",
      "args": {
        "position": 0,
        "text": "AA"
      },
      "account": "fugue-node-2"
    },
    {
      "name": "Node 1 undoes its delete",
      "type": "call",
      "app": "{{context_id}}",
      "method": "undo_delete",
      "args": {
        "token": "{{cut}}"
      },
      "account": "fugue-node-1"
    },
    {
      "name": "Node 2 types a prefix it will take back",
      "type": "call",
      "app": "{{context_id}}",
      "method": "insert_text_tracked",
      "args": {
        "position": 0,
        "text": "ZZ"
      },
      "account": "fugue-node-2",
      "outputs": {
        "typed": "result"
      }
    },
    {
      "name": "Node 2 undoes its insert",
      "type": "call",
      "app": "{{context_id}}",
      "method": "undo_insert",
      "args": {
        "token": "{{typed}}"
      },
      "account": "fugue-node-2"
    }
  ]
}
