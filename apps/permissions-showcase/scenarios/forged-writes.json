[
  { "as": "owner", "op": "call", "method": "postMessage", "args": { "channel": "general", "id": "m1", "text": "owner's message", "sentAt": "10" }, "expect": { "ok": "general/m1" } },
  { "as": "owner", "op": "call", "method": "postMessage", "args": { "channel": "general", "id": "m1", "text": "owner rewrites", "sentAt": "11" },
    "expect": { "error": "AlreadyWritten", "fields": { "key": "general/m1" } } },
  { "as": "mallory", "op": "call", "method": "postMessage", "args": { "channel": "general", "id": "m1", "text": "mallory's message", "sentAt": "12" }, "expect": { "ok": "general/m1" } },
  { "as": "mallory", "op": "call", "method": "postMessage", "args": { "channel": "general", "id": "m1", "text": "mallory rewrites", "sentAt": "13" },
    "expect": { "error": "AlreadyWritten", "fields": { "key": "general/m1" } } },
  { "as": "owner", "op": "view", "method": "channel", "args": { "channel": "general" },
    "expect": { "ok": [
      { "key": "general/m1", "author": "@owner", "text": "owner's message", "sentAt": "10" },
      { "key": "general/m1", "author": "@mallory", "text": "mallory's message", "sentAt": "12" } ] } },
  { "as": "owner", "op": "call", "method": "announce", "args": { "id": "a1", "text": "owner's announcement", "sentAt": "20" } },
  { "as": "owner", "op": "call", "method": "announce", "args": { "id": "a1", "text": "owner edits it", "sentAt": "21" },
    "expect": { "error": "AlreadyWritten", "fields": { "key": "a1" } } },
  { "as": "mallory", "op": "call", "method": "removeAnnouncement", "args": { "id": "a1" }, "expect": { "error": "NotModerator" } },
  { "as": "mallory", "op": "call", "method": "addModerator", "args": { "account": "@mallory" }, "expect": { "error": "NotModerator" } },
  { "as": "mallory", "op": "view", "method": "moderators", "expect": { "ok": ["@owner"] } },
  { "as": "mallory", "op": "view", "method": "announcements",
    "expect": { "ok": [ { "key": "a1", "author": "@owner", "text": "owner's announcement", "sentAt": "20" } ] } },
  { "as": "owner", "op": "call", "method": "createPage", "args": { "id": "home", "title": "Owner's home", "text": "v1" } },
  { "as": "mallory", "op": "call", "method": "renamePage", "args": { "id": "home", "title": "Forged" },
    "expect": { "error": "NoPage", "fields": { "id": "home" } } },
  { "as": "mallory", "op": "call", "method": "addRevision", "args": { "id": "home", "revision": "r2", "text": "forged" },
    "expect": { "error": "NoPage", "fields": { "id": "home" } } },
  { "as": "mallory", "op": "call", "method": "deletePage", "args": { "id": "home" }, "expect": { "ok": false } },
  { "as": "mallory", "op": "view", "method": "page", "args": { "author": "@owner", "id": "home" },
    "expect": { "ok": { "id": "home", "author": "@owner", "title": "Owner's home", "revisions": [["r1", "v1"]] } } },
  { "as": "mallory", "op": "view", "method": "page", "args": { "author": "@mallory", "id": "home" }, "expect": { "ok": null } }
]
