{
  "name": "Full-text search across two nodes",
  "description": "Two nodes, two contexts of the search-chat app. Each node keeps its own index of each context, built from the state it holds and never synced, so only a real network shows that the index follows state however it arrived.\n1. A MESSAGE POSTED ON ONE NODE IS FOUND ON THE OTHER. Node 1 posts; node 2\n   receives the delta by sync, indexes it on its own, and its search view\n   finds the message.\n\n2. A DELETE REMOVES THE HIT ON BOTH. Node 2 deletes the message; on both\n   nodes the next search no longer returns it.\n\n3. A SECOND CONTEXT NEVER SEES THE FIRST ONE'S HITS. The same query run in\n   another context of the same app, on either node, finds only that\n   context's own message.\n\nThe indexer commits every 250 ms, so each search follows a short wait. The first search on a node also tells its indexer the root it saw, which is how a context whose state arrived by snapshot or repair sync gets built; a second search after the wait asserts.\n",
  "comment": [
    "Migrated from this file's v1 workflow by `merobox cloud port`.",
    "Each of the original scenario's nodes is an account here; see merobox/cloud_v2/port.py for the mapping.",
    "Dropped (no counterpart in this node):",
    "  login (unknown) x2: checks what the dropped steps did",
    "  wait_for_sync x3: replication is synchronous: a read sees every committed write"
  ],
  "cluster": {
    "nodes": 3
  },
  "accounts": [
    "search-node-1",
    "search-node-2"
  ],
  "steps": [
    {
      "name": "Install application on search-node-1",
      "type": "upload_bundle",
      "wasm": "{{env.CORE_WASM_DIR}}/search_chat.wasm",
      "outputs": {
        "app_id_bundle": "hash"
      },
      "account": "search-node-1"
    },
    {
      "type": "set",
      "values": {
        "app_id": "com.calimero.search-chat"
      }
    },
    {
      "name": "Create namespace on search-node-1",
      "type": "create_org",
      "org_name": "Create namespace on search-node-1",
      "outputs": {
        "namespace_id": "orgId"
      },
      "account": "search-node-1"
    },
    {
      "name": "Create the first context",
      "type": "deploy",
      "account": "search-node-1",
      "wasm": "{{env.CORE_WASM_DIR}}/search_chat.wasm",
      "app_name": "Create the first context",
      "org": "{{namespace_id}}",
      "outputs": {
        "ctx_a": "contextId"
      }
    },
    {
      "name": "Create the second context",
      "type": "deploy",
      "account": "search-node-1",
      "wasm": "{{env.CORE_WASM_DIR}}/search_chat.wasm",
      "app_name": "Create the second context",
      "org": "{{namespace_id}}",
      "outputs": {
        "ctx_b": "contextId"
      }
    },
    {
      "name": "Assert both contexts were created",
      "type": "assert",
      "statements": [
        "is_set({{ctx_a}})",
        "is_set({{ctx_b}})"
      ]
    },
    {
      "name": "Invite search-node-2 to the namespace",
      "type": "invite",
      "org": "{{namespace_id}}",
      "role": "member",
      "account": "search-node-1",
      "outputs": {
        "invitation": "token"
      }
    },
    {
      "name": "search-node-2 joins the namespace",
      "type": "redeem_invite",
      "token": "{{invitation}}",
      "account": "search-node-2"
    },
    {
      "name": "search-node-1 posts in the first context",
      "type": "call",
      "app": "{{ctx_a}}",
      "method": "post",
      "args": {
        "id": "m1",
        "sender": "alice",
        "text": "quarterly zebrafish report is ready",
        "ts": 1
      },
      "account": "search-node-1"
    },
    {
      "name": "search-node-1 posts in the second context",
      "type": "call",
      "app": "{{ctx_b}}",
      "method": "post",
      "args": {
        "id": "m1",
        "sender": "bob",
        "text": "unrelated lunch plans",
        "ts": 1
      },
      "account": "search-node-1"
    },
    {
      "name": "search-node-2 searches the first context once, waking its indexer",
      "type": "call",
      "app": "{{ctx_a}}",
      "method": "search",
      "args": {
        "query": "zebrafish"
      },
      "account": "search-node-2"
    },
    {
      "name": "Let both indexers commit",
      "type": "wait",
      "seconds": 3.0
    },
    {
      "name": "search-node-2 searches the first context",
      "type": "call",
      "app": "{{ctx_a}}",
      "method": "search",
      "args": {
        "query": "zebrafish"
      },
      "account": "search-node-2",
      "outputs": {
        "n2_found": "rpc"
      }
    },
    {
      "name": "search-node-1 searches the first context",
      "type": "call",
      "app": "{{ctx_a}}",
      "method": "search",
      "args": {
        "query": "zebrafish"
      },
      "account": "search-node-1",
      "outputs": {
        "n1_found": "rpc"
      }
    },
    {
      "name": "Assert both nodes find the message",
      "type": "assert",
      "statements": [
        "contains({{n2_found}}, \"quarterly zebrafish report is ready\")",
        "contains({{n1_found}}, \"quarterly zebrafish report is ready\")"
      ]
    },
    {
      "name": "Assert each node's own index matched exactly one document",
      "type": "json_assert",
      "statements": [
        "json_subset({{n2_found}}, {\"output\": {\"total\": 1, \"stale\": 0}})",
        "json_subset({{n1_found}}, {\"output\": {\"total\": 1, \"stale\": 0}})"
      ]
    },
    {
      "name": "search-node-2 searches the second context once, waking its indexer",
      "type": "call",
      "app": "{{ctx_b}}",
      "method": "search",
      "args": {
        "query": "zebrafish"
      },
      "account": "search-node-2"
    },
    {
      "name": "Let the second context's index commit",
      "type": "wait",
      "seconds": 3.0
    },
    {
      "name": "search-node-2 runs the same query in the second context",
      "type": "call",
      "app": "{{ctx_b}}",
      "method": "search",
      "args": {
        "query": "zebrafish"
      },
      "account": "search-node-2",
      "outputs": {
        "n2_other": "rpc"
      }
    },
    {
      "name": "search-node-1 runs the same query in the second context",
      "type": "call",
      "app": "{{ctx_b}}",
      "method": "search",
      "args": {
        "query": "zebrafish"
      },
      "account": "search-node-1",
      "outputs": {
        "n1_other": "rpc"
      }
    },
    {
      "name": "search-node-2 finds the second context's own message there",
      "type": "call",
      "app": "{{ctx_b}}",
      "method": "search",
      "args": {
        "query": "lunch"
      },
      "account": "search-node-2",
      "outputs": {
        "n2_own": "rpc"
      }
    },
    {
      "name": "Assert the second context holds none of the first one's hits",
      "type": "assert",
      "statements": [
        "not_contains({{n2_other}}, \"zebrafish report\")",
        "not_contains({{n1_other}}, \"zebrafish report\")",
        "contains({{n2_own}}, \"unrelated lunch plans\")"
      ]
    },
    {
      "name": "search-node-2 deletes the message",
      "type": "call",
      "app": "{{ctx_a}}",
      "method": "delete",
      "args": {
        "id": "m1"
      },
      "account": "search-node-2"
    },
    {
      "name": "Let both indexers commit the delete",
      "type": "wait",
      "seconds": 3.0,
      "exact": true
    },
    {
      "name": "search-node-1 searches after the delete",
      "type": "call",
      "app": "{{ctx_a}}",
      "method": "search",
      "args": {
        "query": "zebrafish"
      },
      "account": "search-node-1",
      "outputs": {
        "n1_gone": "rpc"
      }
    },
    {
      "name": "search-node-2 searches after the delete",
      "type": "call",
      "app": "{{ctx_a}}",
      "method": "search",
      "args": {
        "query": "zebrafish"
      },
      "account": "search-node-2",
      "outputs": {
        "n2_gone": "rpc"
      }
    },
    {
      "name": "Assert the deleted message is gone on both nodes",
      "type": "assert",
      "statements": [
        "not_contains({{n1_gone}}, \"quarterly zebrafish report\")",
        "not_contains({{n2_gone}}, \"quarterly zebrafish report\")"
      ]
    },
    {
      "name": "Assert both indexes dropped the document",
      "type": "json_assert",
      "statements": [
        "json_subset({{n1_gone}}, {\"output\": {\"total\": 0, \"stale\": 0}})",
        "json_subset({{n2_gone}}, {\"output\": {\"total\": 0, \"stale\": 0}})"
      ]
    }
  ]
}
