[
  { "as": "owner", "op": "call", "method": "setShared", "args": { "value": "initial-from-node1" }, "expect": { "ok": null } },
  { "as": "owner", "op": "call", "method": "getShared", "expect": { "ok": "initial-from-node1" } },
  { "as": "bob", "op": "call", "method": "getShared", "expect": { "ok": "initial-from-node1" } },
  { "as": "owner", "op": "call", "method": "mapSet", "args": { "key": "greeting", "value": "hello" }, "expect": { "ok": null } },
  { "as": "bob", "op": "call", "method": "mapGet", "args": { "key": "greeting" }, "expect": { "ok": "hello" } },
  { "as": "bob", "op": "call", "method": "myAccount", "expect": { "ok": "@bob" } },
  { "as": "bob", "op": "call", "method": "tryRotateWriters", "args": { "newWriters": ["@bob"] }, "expect": { "ok": false } },
  { "as": "bob", "op": "call", "method": "rotateWriters", "args": { "newWriters": ["@bob"] },
    "expect": { "error": "NotWriter", "fields": { "field": "value" } } },
  { "as": "owner", "op": "call", "method": "writerCount", "expect": { "ok": "1" } },
  { "as": "bob", "op": "call", "method": "setShared", "args": { "value": "before-rotation-from-node2" },
    "expect": { "error": "NotWriter", "fields": { "field": "value" } } },
  { "as": "owner", "op": "call", "method": "rotateWriters", "args": { "newWriters": ["@bob"] }, "expect": { "ok": null },
    "events": { "bob": ["SharedSet", "WritersRotated"] } },
  { "as": "owner", "op": "view", "method": "writerCount", "expect": { "ok": "1" } },
  { "as": "bob", "op": "call", "method": "setShared", "args": { "value": "post-rotation-from-node2" }, "expect": { "ok": null } },
  { "as": "owner", "op": "call", "method": "getShared", "expect": { "ok": "post-rotation-from-node2" } },
  { "as": "owner", "op": "call", "method": "setShared", "args": { "value": "owner-after-rotation" },
    "expect": { "error": "NotWriter", "fields": { "field": "value" } } },
  { "as": "bob", "op": "call", "method": "mapSet", "args": { "key": "evil", "value": "forged" },
    "expect": { "error": "NotWriter", "fields": { "field": "map" } } },
  { "as": "owner", "op": "call", "method": "mapGet", "args": { "key": "evil" }, "expect": { "ok": null } },
  { "as": "owner", "op": "call", "method": "mapSet", "args": { "key": "evil", "value": "fine" }, "expect": { "ok": null } },
  { "as": "bob", "op": "view", "method": "mapGet", "args": { "key": "evil" }, "expect": { "ok": "fine" } },
  { "as": "bob", "op": "call", "method": "tryRotateWriters", "args": { "newWriters": ["@bob", "@owner"] }, "expect": { "ok": true } },
  { "as": "owner", "op": "view", "method": "writerCount", "expect": { "ok": "2" } },
  { "as": "owner", "op": "call", "method": "rotateWriters", "args": { "newWriters": [] }, "expect": { "error": "NoWriters" } },

  { "as": "mallory", "op": "call", "method": "setShared", "args": { "value": "forged" },
    "expect": { "error": "NotWriter", "fields": { "field": "value" } } },
  { "as": "mallory", "op": "call", "method": "mapSet", "args": { "key": "greeting", "value": "forged" },
    "expect": { "error": "NotWriter", "fields": { "field": "map" } } },
  { "as": "mallory", "op": "call", "method": "grantRole", "args": { "role": "admin", "who": "@mallory" },
    "expect": { "error": "NotWriter", "fields": { "field": "roles" } } },
  { "as": "mallory", "op": "call", "method": "rotateWriters", "args": { "newWriters": ["@mallory"] },
    "expect": { "error": "NotWriter", "fields": { "field": "value" } } },
  { "as": "mallory", "op": "call", "method": "rotateWriters", "args": { "field": "roles", "newWriters": ["@mallory"] },
    "expect": { "error": "NotWriter", "fields": { "field": "roles" } } },
  { "as": "mallory", "op": "call", "method": "tryRotateWriters", "args": { "newWriters": ["@mallory"] }, "expect": { "ok": false } },
  { "as": "mallory", "op": "view", "method": "writerCount", "expect": { "ok": "2" } },
  { "as": "mallory", "op": "view", "method": "hasRole", "args": { "role": "admin", "who": "@mallory" }, "expect": { "ok": false } },
  { "as": "owner", "op": "call", "method": "rotateWriters", "args": { "newWriters": ["@bob"] } },
  { "as": "owner", "op": "call", "method": "rotateWriters", "args": { "newWriters": ["@owner", "@mallory"] },
    "expect": { "error": "NotWriter", "fields": { "field": "value" } } },
  { "as": "bob", "op": "call", "method": "mapSet", "args": { "key": "greeting", "value": "bob is no map writer" },
    "expect": { "error": "NotWriter", "fields": { "field": "map" } } },
  { "as": "bob", "op": "call", "method": "setShared", "args": { "value": "bob's value" } },
  { "as": "mallory", "op": "view", "method": "getShared", "expect": { "ok": "bob's value" } },
  { "as": "mallory", "op": "view", "method": "mapGet", "args": { "key": "greeting" }, "expect": { "ok": "hello" } },
  { "as": "mallory", "op": "view", "method": "writerCount", "expect": { "ok": "1" } },
  { "as": "mallory", "op": "view", "method": "writerCount", "args": { "field": "map" }, "expect": { "ok": "1" } },
  { "as": "@anonymous", "op": "view", "method": "getShared", "expect": { "refused": "UNAUTHENTICATED" } }
]
