[
  { "as": "owner", "op": "view", "method": "role", "expect": { "ok": "owner" } },
  { "as": "owner", "op": "view", "method": "whoami", "args": { "candidates": ["writers"] } },
  { "as": "bob", "op": "view", "method": "role", "expect": { "ok": "member" } },
  { "as": "carol", "op": "view", "method": "role", "expect": { "ok": "admin" } },
  { "as": "dave", "op": "view", "method": "role", "expect": { "ok": "guest" } },
  { "as": "owner", "op": "call", "method": "setPinned", "args": { "text": "welcome" } },
  { "as": "bob", "op": "view", "method": "pinned", "expect": { "ok": "welcome" } },
  { "as": "bob", "op": "call", "method": "setPinned", "args": { "text": "bob was here" }, "expect": { "error": "AdminsOnly" } },
  { "as": "carol", "op": "call", "method": "setPinned", "args": { "text": "pinned by carol" } },
  { "as": "bob", "op": "view", "method": "pinned", "expect": { "ok": "pinned by carol" } },
  { "as": "dave", "op": "view", "method": "pinned", "expect": { "error": "MembersOnly" } },
  { "as": "bob", "op": "call", "method": "setTeamNote", "args": { "team": "writers", "text": "draft one" } },
  { "as": "carol", "op": "call", "method": "setTeamNote", "args": { "team": "writers", "text": "carol's edit" }, "expect": { "error": "TeamOnly" } },
  { "as": "carol", "op": "view", "method": "teamNote", "args": { "team": "writers" }, "expect": { "ok": "draft one" } },
  { "as": "bob", "op": "call", "method": "announce", "args": { "text": "hi" }, "events": { "carol": ["Announced"], "dave": [] } },
  { "as": "owner", "op": "call", "method": "setConfig", "args": { "value": "owner-config" } },
  { "as": "bob", "op": "view", "method": "getConfig", "expect": { "ok": "owner-config" } },
  { "as": "bob", "op": "call", "method": "setConfig", "args": { "value": "forged" }, "expect": { "error": "NotOwner" } },
  { "as": "carol", "op": "call", "method": "setConfig", "args": { "value": "an admin's" }, "expect": { "error": "NotOwner" } },
  { "as": "bob", "op": "view", "method": "myAccount", "expect": { "ok": "@bob" }, "save": "acct_bob" },
  { "as": "owner", "op": "call", "method": "grantRole", "args": { "role": "editor", "who": "$acct_bob" } },
  { "as": "bob", "op": "view", "method": "hasRole", "args": { "role": "editor", "who": "$acct_bob" }, "expect": { "ok": true } },
  { "as": "bob", "op": "call", "method": "tryGrantRole", "args": { "role": "viewer", "who": "$acct_bob" }, "expect": { "ok": false } },
  { "as": "carol", "op": "call", "method": "grantRole", "args": { "role": "viewer", "who": "$acct_bob" },
    "expect": { "error": "NotWriter", "fields": { "field": "roles" } } },
  { "as": "bob", "op": "view", "method": "hasRole", "args": { "role": "viewer", "who": "$acct_bob" }, "expect": { "ok": false } },
  { "as": "owner", "op": "call", "method": "transfer", "args": { "newOwner": "$acct_bob" } },
  { "as": "owner", "op": "view", "method": "owner", "expect": { "ok": "@bob" } },
  { "as": "bob", "op": "call", "method": "setConfig", "args": { "value": "by-bob" } },
  { "as": "owner", "op": "call", "method": "setConfig", "args": { "value": "nope" }, "expect": { "error": "NotOwner" } },
  { "as": "owner", "op": "view", "method": "getConfig", "expect": { "ok": "by-bob" } },
  { "as": "owner", "op": "call", "method": "revokeRole", "args": { "role": "editor", "who": "$acct_bob" } },
  { "as": "bob", "op": "view", "method": "hasRole", "args": { "role": "editor", "who": "$acct_bob" }, "expect": { "ok": false } },
  { "op": "removeMember", "args": "bob" },
  { "as": "bob", "op": "call", "method": "setTeamNote", "args": { "team": "writers", "text": "after leaving" }, "expect": { "refused": "NOT_FOUND" } },
  { "as": "owner", "op": "view", "method": "teamNote", "args": { "team": "writers" }, "expect": { "ok": "draft one" } },
  { "as": "owner", "op": "view", "method": "owner", "expect": { "ok": "@bob" } }
]
