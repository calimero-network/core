[
  { "as": "owner", "op": "call", "method": "setShared", "args": { "value": "owner's value" } },
  { "as": "owner", "op": "call", "method": "mapSet", "args": { "key": "k", "value": "owner's entry" } },
  { "as": "mallory", "op": "call", "method": "setShared", "args": { "value": "forged" },
    "expect": { "error": "NotWriter", "fields": { "field": "value" } } },
  { "as": "mallory", "op": "call", "method": "mapSet", "args": { "key": "k", "value": "forged" },
    "expect": { "error": "NotWriter", "fields": { "field": "map" } } },
  { "as": "mallory", "op": "call", "method": "rotateWriters", "args": { "newWriters": ["@mallory"] },
    "expect": { "error": "NotWriter", "fields": { "field": "value" } } },
  { "as": "mallory", "op": "call", "method": "tryRotateWriters", "args": { "newWriters": ["@mallory"] }, "expect": { "ok": false } },
  { "as": "mallory", "op": "view", "method": "writerCount", "expect": { "ok": "1" } },
  { "as": "mallory", "op": "call", "method": "setShared", "args": { "value": "forged after rotating" },
    "expect": { "error": "NotWriter", "fields": { "field": "value" } } },
  { "as": "owner", "op": "call", "method": "rotateWriters", "args": { "newWriters": ["@bob"] } },
  { "as": "owner", "op": "call", "method": "rotateWriters", "args": { "newWriters": ["@owner", "@mallory"] },
    "expect": { "error": "NotWriter", "fields": { "field": "value" } } },
  { "as": "mallory", "op": "call", "method": "rotateWriters", "args": { "newWriters": ["@mallory"] },
    "expect": { "error": "NotWriter", "fields": { "field": "value" } } },
  { "as": "bob", "op": "call", "method": "mapSet", "args": { "key": "k", "value": "bob is no map writer" },
    "expect": { "error": "NotWriter", "fields": { "field": "map" } } },
  { "as": "bob", "op": "call", "method": "setShared", "args": { "value": "bob's value" } },
  { "as": "mallory", "op": "view", "method": "getShared", "expect": { "ok": "bob's value" } },
  { "as": "mallory", "op": "view", "method": "mapGet", "args": { "key": "k" }, "expect": { "ok": "owner's entry" } },
  { "as": "mallory", "op": "view", "method": "writerCount", "expect": { "ok": "1" } }
]
