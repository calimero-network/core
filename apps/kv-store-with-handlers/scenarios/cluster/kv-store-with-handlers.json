{
  "name": "KV Store with Handlers Test",
  "description": "Test KV Store with handlers functionality, including insert, update, remove, and clear handlers",
  "comment": [
    "Migrated from this file's v1 workflow by `merobox cloud port`.",
    "Each of the original scenario's nodes is an account here; see merobox/cloud_v2/port.py for the mapping.",
    "Dropped (no counterpart in this node):",
    "  wait_for_sync x6: replication is synchronous: a read sees every committed write"
  ],
  "cluster": {
    "nodes": 3
  },
  "accounts": [
    "kvh-node-1",
    "kvh-node-2"
  ],
  "steps": [
    {
      "name": "Install KV Store with Handlers App on Node 1",
      "type": "upload_bundle",
      "wasm": "{{env.CORE_WASM_DIR}}/kv_store_with_handlers.wasm",
      "outputs": {
        "app_id_bundle": "hash"
      },
      "account": "kvh-node-1"
    },
    {
      "type": "set",
      "values": {
        "app_id": "com.calimero.kv-store-with-handlers"
      }
    },
    {
      "name": "Create Mesh",
      "type": "create_org",
      "account": "kvh-node-1",
      "org_name": "mesh",
      "outputs": {
        "namespace_id": "orgId"
      }
    },
    {
      "type": "invite",
      "account": "kvh-node-1",
      "org": "{{namespace_id}}",
      "role": "member",
      "outputs": {
        "_mesh_invite": "token"
      }
    },
    {
      "type": "redeem_invite",
      "account": "kvh-node-2",
      "token": "{{_mesh_invite}}"
    },
    {
      "name": "Create Mesh",
      "type": "deploy",
      "account": "kvh-node-1",
      "org": "{{namespace_id}}",
      "wasm": "{{env.CORE_WASM_DIR}}/kv_store_with_handlers.wasm",
      "app_name": "Create Mesh",
      "outputs": {
        "context_id": "contextId",
        "member_public_key": "memberPublicKey"
      }
    },
    {
      "name": "Get Initial Handler Count on Node 1",
      "type": "call",
      "app": "{{context_id}}",
      "method": "get_handler_execution_count",
      "args": {},
      "account": "kvh-node-1",
      "outputs": {
        "initial_handlers_node1": "rpc"
      }
    },
    {
      "name": "Assert Initial Handler Count is 0 on Node 1",
      "type": "json_assert",
      "statements": [
        "json_equal({{initial_handlers_node1}}, {\"output\": 0})"
      ]
    },
    {
      "name": "Get Initial Handler Count on Node 2",
      "type": "call",
      "app": "{{context_id}}",
      "method": "get_handler_execution_count",
      "args": {},
      "account": "kvh-node-2",
      "outputs": {
        "initial_handlers_node2": "rpc"
      }
    },
    {
      "name": "Assert Initial Handler Count is 0 on Node 2",
      "type": "json_assert",
      "statements": [
        "json_equal({{initial_handlers_node2}}, {\"output\": 0})"
      ]
    },
    {
      "name": "Set Initial Key-Value Pair",
      "type": "call",
      "app": "{{context_id}}",
      "method": "set",
      "args": {
        "key": "test_key",
        "value": "test_value"
      },
      "account": "kvh-node-1",
      "outputs": {
        "set_result_1": "rpc"
      }
    },
    {
      "name": "Verify Insert Handler Called on Node 1",
      "type": "call",
      "app": "{{context_id}}",
      "method": "get_handler_execution_count",
      "args": {},
      "account": "kvh-node-1",
      "outputs": {
        "handlers_after_insert_node1": "rpc"
      }
    },
    {
      "name": "Verify Insert Handler Called on Node 2",
      "type": "call",
      "app": "{{context_id}}",
      "method": "get_handler_execution_count",
      "args": {},
      "account": "kvh-node-2",
      "outputs": {
        "handlers_after_insert_node2": "rpc"
      }
    },
    {
      "name": "Assert Insert Handler Count on Node 2",
      "type": "json_assert",
      "statements": [
        "json_equal({{handlers_after_insert_node2}}, {\"output\": 1})"
      ]
    },
    {
      "name": "Update Key with New Value",
      "type": "call",
      "app": "{{context_id}}",
      "method": "set",
      "args": {
        "key": "test_key",
        "value": "updated_value"
      },
      "account": "kvh-node-1",
      "outputs": {
        "set_result_2": "rpc"
      }
    },
    {
      "name": "Verify Update Handler Called on Node 1",
      "type": "call",
      "app": "{{context_id}}",
      "method": "get_handler_execution_count",
      "args": {},
      "account": "kvh-node-1",
      "outputs": {
        "handlers_after_update_node1": "rpc"
      }
    },
    {
      "name": "Verify Update Handler Called on Node 2",
      "type": "call",
      "app": "{{context_id}}",
      "method": "get_handler_execution_count",
      "args": {},
      "account": "kvh-node-2",
      "outputs": {
        "handlers_after_update_node2": "rpc"
      }
    },
    {
      "name": "Assert Update Handler Count on Node 2",
      "type": "json_assert",
      "statements": [
        "json_equal({{handlers_after_update_node2}}, {\"output\": 2})"
      ]
    },
    {
      "name": "Remove Key",
      "type": "call",
      "app": "{{context_id}}",
      "method": "remove",
      "args": {
        "key": "test_key"
      },
      "account": "kvh-node-1",
      "outputs": {
        "remove_result": "rpc"
      }
    },
    {
      "name": "Assert Remove Returned Previous Value",
      "type": "json_assert",
      "statements": [
        "json_equal({{remove_result}}, {\"output\": \"updated_value\"})"
      ]
    },
    {
      "name": "Verify Remove Handler Called on Node 1",
      "type": "call",
      "app": "{{context_id}}",
      "method": "get_handler_execution_count",
      "args": {},
      "account": "kvh-node-1",
      "outputs": {
        "handlers_after_remove_node1": "rpc"
      }
    },
    {
      "name": "Verify Remove Handler Called on Node 2",
      "type": "call",
      "app": "{{context_id}}",
      "method": "get_handler_execution_count",
      "args": {},
      "account": "kvh-node-2",
      "outputs": {
        "handlers_after_remove_node2": "rpc"
      }
    },
    {
      "name": "Assert Remove Handler Count on Node 2",
      "type": "json_assert",
      "statements": [
        "json_equal({{handlers_after_remove_node2}}, {\"output\": 3})"
      ]
    },
    {
      "name": "Set Another Key-Value Pair",
      "type": "call",
      "app": "{{context_id}}",
      "method": "set",
      "args": {
        "key": "another_key",
        "value": "another_value"
      },
      "account": "kvh-node-1",
      "outputs": {
        "set_result_3": "rpc"
      }
    },
    {
      "name": "Clear All Key-Value Pairs",
      "type": "call",
      "app": "{{context_id}}",
      "method": "clear",
      "args": {},
      "account": "kvh-node-1",
      "outputs": {
        "clear_result": "rpc"
      }
    },
    {
      "name": "Verify Clear Handler Called on Node 1",
      "type": "call",
      "app": "{{context_id}}",
      "method": "get_handler_execution_count",
      "args": {},
      "account": "kvh-node-1",
      "outputs": {
        "handlers_after_clear_node1": "rpc"
      }
    },
    {
      "name": "Verify Clear Handler Called on Node 2",
      "type": "call",
      "app": "{{context_id}}",
      "method": "get_handler_execution_count",
      "args": {},
      "account": "kvh-node-2",
      "outputs": {
        "handlers_after_clear_node2": "rpc"
      }
    },
    {
      "name": "Assert Clear Handler Count on Node 2",
      "type": "json_assert",
      "statements": [
        "json_equal({{handlers_after_clear_node2}}, {\"output\": 5})"
      ]
    },
    {
      "name": "Node 2 Set Value",
      "type": "call",
      "app": "{{context_id}}",
      "method": "set",
      "args": {
        "key": "node2_key",
        "value": "value_from_node2"
      },
      "account": "kvh-node-2"
    },
    {
      "name": "Node 1 Get Node 2 Value",
      "type": "call",
      "app": "{{context_id}}",
      "method": "get",
      "args": {
        "key": "node2_key"
      },
      "account": "kvh-node-1",
      "outputs": {
        "node1_gets_node2_value": "result"
      }
    },
    {
      "name": "Assert Node 1 Sees Node 2 Value",
      "type": "assert",
      "statements": [
        "{{node1_gets_node2_value}} == 'value_from_node2'"
      ]
    },
    {
      "name": "Verify Final State on Node 1",
      "type": "call",
      "app": "{{context_id}}",
      "method": "get_handler_execution_count",
      "args": {},
      "account": "kvh-node-1",
      "outputs": {
        "final_handlers_node1": "rpc"
      }
    },
    {
      "name": "Assert Final Handler Count on Node 1",
      "type": "json_assert",
      "statements": [
        "json_equal({{final_handlers_node1}}, {\"output\": 6})"
      ]
    },
    {
      "name": "Verify Final State on Node 2",
      "type": "call",
      "app": "{{context_id}}",
      "method": "get_handler_execution_count",
      "args": {},
      "account": "kvh-node-2",
      "outputs": {
        "final_handlers_node2": "rpc"
      }
    },
    {
      "name": "Assert Final Handler Count on Node 2",
      "type": "json_assert",
      "statements": [
        "json_equal({{final_handlers_node2}}, {\"output\": 6})"
      ]
    },
    {
      "name": "Verify Final Entries on Node 1",
      "type": "call",
      "app": "{{context_id}}",
      "method": "entries",
      "args": {},
      "account": "kvh-node-1",
      "outputs": {
        "final_entries_node1": "result"
      }
    },
    {
      "name": "Assert Final Entries on Node 1",
      "type": "json_assert",
      "statements": [
        "json_equal({{final_entries_node1}}, {\"node2_key\": \"value_from_node2\"})"
      ]
    },
    {
      "name": "Verify Final Entries on Node 2",
      "type": "call",
      "app": "{{context_id}}",
      "method": "entries",
      "args": {},
      "account": "kvh-node-2",
      "outputs": {
        "final_entries_node2": "result"
      }
    },
    {
      "name": "Assert Final Entries on Node 2",
      "type": "json_assert",
      "statements": [
        "json_equal({{final_entries_node2}}, {\"node2_key\": \"value_from_node2\"})"
      ]
    }
  ]
}
