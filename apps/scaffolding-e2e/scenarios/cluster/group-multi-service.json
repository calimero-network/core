{
  "name": "E2E KV Store - Multi-Service Bundle",
  "description": "Tests the multi-service bundle install and service_name context selection. Both services (store-a, store-b) are backed by the same scaffolding_e2e WASM but are treated as independent services by merod. The test verifies:\n  1. A multi-service .mpk bundle can be installed.\n  2. Contexts can be pinned to a named service via service_name.\n  3. Contexts on different services are fully isolated — writes in store-a\n     are NOT visible in store-b and vice versa.\n  4. CRDT sync works correctly within each service's context.\n",
  "comment": [
    "Migrated from this file's v1 workflow by `merobox cloud port`.",
    "Each of the original scenario's nodes is an account here; see merobox/cloud_v2/port.py for the mapping.",
    "Dropped (no counterpart in this node):",
    "  login (unknown) x2: checks what the dropped steps did",
    "  wait_for_sync x3: replication is synchronous: a read sees every committed write"
  ],
  "cluster": {
    "nodes": 3
  },
  "accounts": [
    "e2e-node-1",
    "e2e-node-2"
  ],
  "steps": [
    {
      "name": "Install multi-service bundle on node-1",
      "type": "upload_bundle",
      "wasm": "{{env.CORE_WASM_DIR}}/scaffolding_e2e.wasm",
      "outputs": {
        "app_id_bundle": "hash"
      },
      "account": "e2e-node-1"
    },
    {
      "type": "set",
      "values": {
        "app_id": "com.calimero.scaffolding-e2e-multi"
      }
    },
    {
      "name": "Assert bundle installed",
      "type": "assert",
      "statements": [
        "is_set({{app_id}})"
      ]
    },
    {
      "name": "Create namespace on node-1",
      "type": "create_org",
      "org_name": "Create namespace on node-1",
      "outputs": {
        "namespace_id": "orgId"
      },
      "account": "e2e-node-1"
    },
    {
      "name": "Assert namespace created",
      "type": "assert",
      "statements": [
        "is_set({{namespace_id}})"
      ]
    },
    {
      "name": "Create context for service store-a on node-1",
      "type": "deploy",
      "account": "e2e-node-1",
      "wasm": "{{env.CORE_WASM_DIR}}/scaffolding_e2e.wasm",
      "app_name": "store-a",
      "org": "{{namespace_id}}",
      "outputs": {
        "ctx_a_id": "contextId",
        "ctx_a_key_node1": "memberPublicKey"
      }
    },
    {
      "name": "Create context for service store-b on node-1",
      "type": "deploy",
      "account": "e2e-node-1",
      "wasm": "{{env.CORE_WASM_DIR}}/scaffolding_e2e.wasm",
      "app_name": "store-b",
      "org": "{{namespace_id}}",
      "outputs": {
        "ctx_b_id": "contextId",
        "ctx_b_key_node1": "memberPublicKey"
      }
    },
    {
      "name": "Assert both contexts created",
      "type": "assert",
      "statements": [
        "is_set({{ctx_a_id}})",
        "is_set({{ctx_b_id}})"
      ]
    },
    {
      "name": "Create namespace invitation for node-2",
      "type": "invite",
      "org": "{{namespace_id}}",
      "role": "member",
      "account": "e2e-node-1",
      "outputs": {
        "namespace_invitation": "token"
      }
    },
    {
      "name": "Node-2 joins namespace",
      "type": "redeem_invite",
      "token": "{{namespace_invitation}}",
      "account": "e2e-node-2"
    },
    {
      "name": "Node-2 joins context-A via namespace membership",
      "type": "whoami",
      "account": "e2e-node-2",
      "outputs": {
        "ctx_a_key_node2": "publicKey"
      }
    },
    {
      "name": "Node-2 joins context-B via namespace membership",
      "type": "whoami",
      "account": "e2e-node-2",
      "outputs": {
        "ctx_b_key_node2": "publicKey"
      }
    },
    {
      "name": "Node-1 writes to store-a context",
      "type": "call",
      "app": "{{ctx_a_id}}",
      "method": "set",
      "args": {
        "key": "service_key",
        "value": "in_store_a"
      },
      "account": "e2e-node-1"
    },
    {
      "name": "Node-2 reads service_key from store-a (must be set)",
      "type": "call",
      "app": "{{ctx_a_id}}",
      "method": "get",
      "args": {
        "key": "service_key"
      },
      "account": "e2e-node-2",
      "outputs": {
        "key_in_a": "rpc"
      }
    },
    {
      "name": "Assert store-a value visible on node-2",
      "type": "json_assert",
      "statements": [
        "json_equal({{key_in_a}}, {\"output\": \"in_store_a\"})"
      ]
    },
    {
      "name": "Node-1 reads service_key from store-b (must be absent)",
      "type": "call",
      "app": "{{ctx_b_id}}",
      "method": "get",
      "args": {
        "key": "service_key"
      },
      "account": "e2e-node-1",
      "outputs": {
        "key_in_b_node1": "rpc"
      }
    },
    {
      "name": "Assert store-a write did NOT bleed into store-b on node-1",
      "type": "json_assert",
      "statements": [
        "json_equal({{key_in_b_node1}}, {\"output\": null})"
      ]
    },
    {
      "name": "Node-2 reads service_key from store-b (must also be absent)",
      "type": "call",
      "app": "{{ctx_b_id}}",
      "method": "get",
      "args": {
        "key": "service_key"
      },
      "account": "e2e-node-2",
      "outputs": {
        "key_in_b_node2": "rpc"
      }
    },
    {
      "name": "Assert store-a write did NOT bleed into store-b on node-2",
      "type": "json_assert",
      "statements": [
        "json_equal({{key_in_b_node2}}, {\"output\": null})"
      ]
    },
    {
      "name": "Node-2 writes to store-b context",
      "type": "call",
      "app": "{{ctx_b_id}}",
      "method": "set",
      "args": {
        "key": "service_key",
        "value": "in_store_b"
      },
      "account": "e2e-node-2"
    },
    {
      "name": "Node-1 reads service_key from store-b (must be set)",
      "type": "call",
      "app": "{{ctx_b_id}}",
      "method": "get",
      "args": {
        "key": "service_key"
      },
      "account": "e2e-node-1",
      "outputs": {
        "b_key_on_node1": "rpc"
      }
    },
    {
      "name": "Assert store-b value visible on node-1",
      "type": "json_assert",
      "statements": [
        "json_equal({{b_key_on_node1}}, {\"output\": \"in_store_b\"})"
      ]
    },
    {
      "name": "Node-1 re-reads service_key from store-a (must still be store-a value)",
      "type": "call",
      "app": "{{ctx_a_id}}",
      "method": "get",
      "args": {
        "key": "service_key"
      },
      "account": "e2e-node-1",
      "outputs": {
        "a_key_after_b_write": "rpc"
      }
    },
    {
      "name": "Assert store-b write did NOT overwrite store-a value",
      "type": "json_assert",
      "statements": [
        "json_equal({{a_key_after_b_write}}, {\"output\": \"in_store_a\"})"
      ]
    },
    {
      "name": "Node-1 calls set_with_handler in store-a context",
      "type": "call",
      "app": "{{ctx_a_id}}",
      "method": "set_with_handler",
      "args": {
        "key": "handler_key",
        "value": "handler_value"
      },
      "account": "e2e-node-1"
    },
    {
      "name": "Node-2 verifies handler_key synced in store-a",
      "type": "call",
      "app": "{{ctx_a_id}}",
      "method": "get",
      "args": {
        "key": "handler_key"
      },
      "account": "e2e-node-2",
      "outputs": {
        "handler_read": "rpc"
      }
    },
    {
      "name": "Assert handler dispatch synced the value in store-a",
      "type": "json_assert",
      "statements": [
        "json_equal({{handler_read}}, {\"output\": \"handler_value\"})"
      ]
    },
    {
      "name": "Node-2 checks handler execution count in store-a",
      "type": "call",
      "app": "{{ctx_a_id}}",
      "method": "get_handler_execution_count",
      "args": {},
      "account": "e2e-node-2",
      "outputs": {
        "handler_count": "rpc"
      }
    },
    {
      "name": "Assert handler was executed at least once",
      "type": "assert",
      "statements": [
        "is_set({{handler_count}})"
      ]
    }
  ]
}
