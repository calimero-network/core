{
  "name": "E2E Account - A Paired Device Joins A Restricted Subgroup Its Account Is In",
  "description": "Node 2 founds a namespace, lets members create subgroups, and rotates the namespace key by removing node 4. Node 1 joins after that rotation, creates a Restricted subgroup holding itself and node 2 (the shape of a DM) and writes into a context there. Node 3 is then paired into node 1's account while node 1 stays online. Node 3 speaks for a member of the subgroup, so it must converge on the subgroup, join its context and read the write. Node 3 then opens a Restricted subgroup of its own with node 2, and node 1 and node 2 must both join it and read node 3's write, as the account's other device and the peer.\n",
  "comment": [
    "Migrated from this file's v1 workflow by `merobox cloud port`.",
    "Each of the original scenario's nodes is an account here; see merobox/cloud_v2/port.py for the mapping.",
    "Dropped (no counterpart in this node):",
    "  login (unknown) x4: checks what the dropped steps did",
    "  node_identity output accountNamespaceId (v1 device key) x1: checks what the dropped steps did",
    "  wait_for_sync x4: replication is synchronous: a read sees every committed write"
  ],
  "cluster": {
    "nodes": 3
  },
  "accounts": [
    "paired-restricted-1",
    "paired-restricted-2",
    "paired-restricted-3",
    "paired-restricted-4"
  ],
  "steps": [
    {
      "name": "Install the application on node-2",
      "type": "upload_bundle",
      "wasm": "{{env.CORE_WASM_DIR}}/scaffolding_e2e.wasm",
      "outputs": {
        "app_bundle": "hash"
      },
      "account": "paired-restricted-2"
    },
    {
      "type": "set",
      "values": {
        "app": "com.calimero.scaffolding-e2e"
      }
    },
    {
      "name": "Node-2 creates the namespace",
      "type": "create_org",
      "org_name": "Node-2 creates the namespace",
      "outputs": {
        "namespace_id": "orgId"
      },
      "account": "paired-restricted-2"
    },
    {
      "name": "What node-2 speaks as",
      "type": "whoami",
      "outputs": {
        "account_node2": "publicKey"
      },
      "account": "paired-restricted-2"
    },
    {
      "name": "Node-2 lets every member create subgroups",
      "type": "capabilities",
      "org": "{{namespace_id}}",
      "capabilities": 36,
      "account": "paired-restricted-2"
    },
    {
      "name": "Invite node-4 to the namespace",
      "type": "invite",
      "org": "{{namespace_id}}",
      "role": "member",
      "account": "paired-restricted-2",
      "outputs": {
        "invite_node4": "token"
      }
    },
    {
      "name": "Node-4 joins the namespace",
      "type": "redeem_invite",
      "token": "{{invite_node4}}",
      "account": "paired-restricted-4"
    },
    {
      "type": "whoami",
      "account": "paired-restricted-4",
      "outputs": {
        "account_node4": "publicKey"
      }
    },
    {
      "name": "Node-2 removes node-4, rotating the namespace key",
      "type": "remove_member",
      "org": "{{namespace_id}}",
      "member": "{{account_node4}}",
      "account": "paired-restricted-2"
    },
    {
      "name": "Invite node-1 to the namespace",
      "type": "invite",
      "org": "{{namespace_id}}",
      "role": "member",
      "account": "paired-restricted-2",
      "outputs": {
        "invite_node1": "token"
      }
    },
    {
      "name": "Node-1 joins the namespace",
      "type": "redeem_invite",
      "token": "{{invite_node1}}",
      "account": "paired-restricted-1"
    },
    {
      "name": "Node-1 creates a Restricted subgroup",
      "type": "create_team",
      "org": "{{namespace_id}}",
      "team_name": "dm",
      "join": "invite",
      "outputs": {
        "dm_group": "teamId"
      },
      "account": "paired-restricted-1"
    },
    {
      "name": "Node-1 marks the subgroup Restricted",
      "type": "team_update",
      "org": "{{namespace_id}}",
      "team": "{{dm_group}}",
      "join": "invite",
      "account": "paired-restricted-1"
    },
    {
      "name": "Node-1 adds node-2 to the subgroup",
      "type": "team_add",
      "org": "{{namespace_id}}",
      "team": "{{dm_group}}",
      "members": [
        "{{account_node2}}"
      ],
      "role": "member",
      "account": "paired-restricted-1"
    },
    {
      "name": "Node-1 creates a context in the subgroup",
      "type": "deploy",
      "account": "paired-restricted-1",
      "wasm": "{{env.CORE_WASM_DIR}}/scaffolding_e2e.wasm",
      "app_name": "Node-1 creates a context in the subgroup",
      "org": "{{namespace_id}}",
      "access": {
        "kind": "team",
        "team": "{{dm_group}}"
      },
      "outputs": {
        "dm_ctx": "contextId"
      }
    },
    {
      "name": "Node-1 writes into the subgroup's context",
      "type": "call",
      "app": "{{dm_ctx}}",
      "method": "set",
      "args": {
        "key": "dm_key",
        "value": "from_node1"
      },
      "account": "paired-restricted-1"
    },
    {
      "name": "What node-1 speaks as",
      "type": "whoami",
      "outputs": {
        "root_key": "publicKey"
      },
      "account": "paired-restricted-1"
    },
    {
      "name": "Pair node-3 into node-1's account, naming only the account namespace",
      "type": "add_device",
      "account": "paired-restricted-1",
      "device": "paired-restricted-3"
    },
    {
      "name": "Node-3 joins the subgroup's context",
      "type": "whoami",
      "account": "paired-restricted-3",
      "outputs": {
        "dm_ctx_key_node3": "publicKey"
      }
    },
    {
      "name": "Node-3 holds a context identity",
      "type": "assert",
      "statements": [
        "is_set({{dm_ctx_key_node3}})"
      ]
    },
    {
      "name": "Node-3 reads node-1's write",
      "type": "call",
      "app": "{{dm_ctx}}",
      "method": "get",
      "args": {
        "key": "dm_key"
      },
      "account": "paired-restricted-3",
      "outputs": {
        "dm_read_node3": "rpc"
      }
    },
    {
      "name": "Node-3 sees the write",
      "type": "json_assert",
      "statements": [
        "json_equal({{dm_read_node3}}, {\"output\": \"from_node1\"})"
      ]
    },
    {
      "name": "Node-3 creates a Restricted subgroup of its own",
      "type": "create_team",
      "org": "{{namespace_id}}",
      "team_name": "dm-from-paired",
      "join": "invite",
      "outputs": {
        "dm3_group": "teamId"
      },
      "account": "paired-restricted-3"
    },
    {
      "name": "Node-3 marks its subgroup Restricted",
      "type": "team_update",
      "org": "{{namespace_id}}",
      "team": "{{dm3_group}}",
      "join": "invite",
      "account": "paired-restricted-3"
    },
    {
      "name": "Node-3 adds node-2 to its subgroup",
      "type": "team_add",
      "org": "{{namespace_id}}",
      "team": "{{dm3_group}}",
      "members": [
        "{{account_node2}}"
      ],
      "role": "member",
      "account": "paired-restricted-3"
    },
    {
      "name": "Node-3 creates a context in its subgroup",
      "type": "deploy",
      "account": "paired-restricted-3",
      "wasm": "{{env.CORE_WASM_DIR}}/scaffolding_e2e.wasm",
      "app_name": "Node-3 creates a context in its subgroup",
      "org": "{{namespace_id}}",
      "access": {
        "kind": "team",
        "team": "{{dm3_group}}"
      },
      "outputs": {
        "dm3_ctx": "contextId"
      }
    },
    {
      "name": "Node-3 writes into its subgroup's context",
      "type": "call",
      "app": "{{dm3_ctx}}",
      "method": "set",
      "args": {
        "key": "dm3_key",
        "value": "from_node3"
      },
      "account": "paired-restricted-3"
    },
    {
      "name": "Node-1 reads node-3's write",
      "type": "call",
      "app": "{{dm3_ctx}}",
      "method": "get",
      "args": {
        "key": "dm3_key"
      },
      "account": "paired-restricted-1",
      "outputs": {
        "dm3_read_node1": "rpc"
      }
    },
    {
      "name": "Node-2 reads node-3's write",
      "type": "call",
      "app": "{{dm3_ctx}}",
      "method": "get",
      "args": {
        "key": "dm3_key"
      },
      "account": "paired-restricted-2",
      "outputs": {
        "dm3_read_node2": "rpc"
      }
    },
    {
      "name": "Node-1 and node-2 see node-3's write",
      "type": "json_assert",
      "statements": [
        "json_equal({{dm3_read_node1}}, {\"output\": \"from_node3\"})",
        "json_equal({{dm3_read_node2}}, {\"output\": \"from_node3\"})"
      ]
    }
  ]
}
