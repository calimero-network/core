{
  "name": "E2E KV Store - Group Capabilities",
  "description": "Tests the capability API (set/get/override):\n  1. Set default capabilities (bitmask 7 = all) before inviting members\n  2. Invite member, verify inherited capabilities via get (json_equal 7)\n  3. Override individual member capabilities to 1, verify (json_equal 1)\n  4. Set default visibility to open, verify context sync still works\n\nNOTE: This tests the capability API (store/retrieve values), not capability enforcement (server rejecting unauthorized operations).\n",
  "comment": [
    "Migrated from this file's v1 workflow by `merobox cloud port`.",
    "Each of the original scenario's nodes is an account here; see merobox/cloud_v2/port.py for the mapping.",
    "Dropped (no counterpart in this node):",
    "  login (unknown) x2: checks what the dropped steps did",
    "  set_subgroup_visibility (not a subgroup) x1: checks what the dropped steps did",
    "  wait_for_sync x1: replication is synchronous: a read sees every committed write"
  ],
  "cluster": {
    "nodes": 3
  },
  "accounts": [
    "e2e-node-1",
    "e2e-node-2"
  ],
  "steps": [
    {
      "name": "Install application on node-1",
      "type": "upload_bundle",
      "wasm": "{{env.CORE_WASM_DIR}}/scaffolding_e2e.wasm",
      "outputs": {
        "app_id_bundle": "hash"
      },
      "account": "e2e-node-1"
    },
    {
      "type": "set",
      "values": {
        "app_id": "com.calimero.scaffolding-e2e"
      }
    },
    {
      "name": "Assert application installed",
      "type": "assert",
      "statements": [
        "is_set({{app_id}})"
      ]
    },
    {
      "name": "Create namespace on node-1",
      "type": "create_org",
      "org_name": "Create namespace on node-1",
      "outputs": {
        "namespace_id": "orgId"
      },
      "account": "e2e-node-1"
    },
    {
      "name": "Assert namespace created",
      "type": "assert",
      "statements": [
        "is_set({{namespace_id}})"
      ]
    },
    {
      "name": "Set default capabilities to all (7)",
      "type": "capabilities",
      "org": "{{namespace_id}}",
      "capabilities": 7,
      "account": "e2e-node-1"
    },
    {
      "name": "Invite node-2 to namespace",
      "type": "invite",
      "org": "{{namespace_id}}",
      "role": "member",
      "account": "e2e-node-1",
      "outputs": {
        "invite_node2": "token"
      }
    },
    {
      "name": "Node-2 joins namespace",
      "type": "redeem_invite",
      "token": "{{invite_node2}}",
      "account": "e2e-node-2"
    },
    {
      "type": "whoami",
      "account": "e2e-node-2",
      "outputs": {
        "account_node2": "publicKey"
      }
    },
    {
      "name": "Get node-2 capabilities",
      "type": "member_capabilities",
      "org": "{{namespace_id}}",
      "member": "{{account_node2}}",
      "account": "e2e-node-1",
      "outputs": {
        "node2_caps": "capabilities"
      }
    },
    {
      "name": "Assert node-2 inherited default capabilities",
      "type": "json_assert",
      "statements": [
        "json_equal({{node2_caps}}, 7)"
      ]
    },
    {
      "name": "Restrict node-2 capabilities to create-context only",
      "type": "capabilities",
      "org": "{{namespace_id}}",
      "capabilities": 1,
      "account": "e2e-node-1",
      "member": "{{account_node2}}"
    },
    {
      "name": "Get node-2 capabilities after restriction",
      "type": "member_capabilities",
      "org": "{{namespace_id}}",
      "member": "{{account_node2}}",
      "account": "e2e-node-1",
      "outputs": {
        "node2_caps_after": "capabilities"
      }
    },
    {
      "name": "Assert restricted capabilities is 1",
      "type": "json_assert",
      "statements": [
        "json_equal({{node2_caps_after}}, 1)"
      ]
    },
    {
      "name": "Create context in namespace",
      "type": "deploy",
      "account": "e2e-node-1",
      "wasm": "{{env.CORE_WASM_DIR}}/scaffolding_e2e.wasm",
      "app_name": "Create context in namespace",
      "org": "{{namespace_id}}",
      "outputs": {
        "ctx_id": "contextId"
      }
    },
    {
      "name": "Assert context created",
      "type": "assert",
      "statements": [
        "is_set({{ctx_id}})"
      ]
    },
    {
      "name": "Node-1 writes to context",
      "type": "call",
      "app": "{{ctx_id}}",
      "method": "set",
      "args": {
        "key": "caps_test",
        "value": "caps_work"
      },
      "account": "e2e-node-1"
    },
    {
      "name": "Node-2 reads from context",
      "type": "call",
      "app": "{{ctx_id}}",
      "method": "get",
      "args": {
        "key": "caps_test"
      },
      "account": "e2e-node-2",
      "outputs": {
        "caps_read": "rpc"
      }
    },
    {
      "name": "Assert context works after capability and visibility changes",
      "type": "json_assert",
      "statements": [
        "json_equal({{caps_read}}, {\"output\": \"caps_work\"})"
      ]
    }
  ]
}
