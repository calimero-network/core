{
  "name": "E2E KV Store - Group Membership",
  "description": "Tests group membership operations: adding members to a subgroup, verifying member lists, removing members, and verifying removed members lose access. This is the core scenario for the namespace signing key hierarchy fix.\n",
  "comment": [
    "Migrated from this file's v1 workflow by `merobox cloud port`.",
    "Each of the original scenario's nodes is an account here; see merobox/cloud_v2/port.py for the mapping.",
    "Dropped (no counterpart in this node):",
    "  login (unknown) x3: checks what the dropped steps did",
    "  wait_for_sync x1: replication is synchronous: a read sees every committed write"
  ],
  "cluster": {
    "nodes": 3
  },
  "accounts": [
    "e2e-node-1",
    "e2e-node-2",
    "e2e-node-3"
  ],
  "steps": [
    {
      "name": "Install application on node-1",
      "type": "upload_bundle",
      "wasm": "{{env.CORE_WASM_DIR}}/scaffolding_e2e.wasm",
      "outputs": {
        "app_id_bundle": "hash"
      },
      "account": "e2e-node-1"
    },
    {
      "type": "set",
      "values": {
        "app_id": "com.calimero.scaffolding-e2e"
      }
    },
    {
      "name": "Create namespace on node-1",
      "type": "create_org",
      "org_name": "Create namespace on node-1",
      "outputs": {
        "namespace_id": "orgId"
      },
      "account": "e2e-node-1"
    },
    {
      "name": "Invite node-2 to namespace",
      "type": "invite",
      "org": "{{namespace_id}}",
      "role": "member",
      "account": "e2e-node-1",
      "outputs": {
        "invite_node2": "token"
      }
    },
    {
      "name": "Node-2 joins namespace",
      "type": "redeem_invite",
      "token": "{{invite_node2}}",
      "account": "e2e-node-2"
    },
    {
      "type": "whoami",
      "account": "e2e-node-2",
      "outputs": {
        "identity_node2": "publicKey",
        "account_node2": "publicKey"
      }
    },
    {
      "name": "Invite node-3 to namespace",
      "type": "invite",
      "org": "{{namespace_id}}",
      "role": "member",
      "account": "e2e-node-1",
      "outputs": {
        "invite_node3": "token"
      }
    },
    {
      "name": "Node-3 joins namespace",
      "type": "redeem_invite",
      "token": "{{invite_node3}}",
      "account": "e2e-node-3"
    },
    {
      "type": "whoami",
      "account": "e2e-node-3",
      "outputs": {
        "identity_node3": "publicKey"
      }
    },
    {
      "name": "List namespace members on node-1",
      "type": "team_list",
      "org": "{{namespace_id}}",
      "account": "e2e-node-1",
      "outputs": {
        "ns_members": "members"
      }
    },
    {
      "name": "Assert namespace has members",
      "type": "assert",
      "statements": [
        "is_set({{ns_members}})"
      ]
    },
    {
      "name": "Create subgroup",
      "type": "create_team",
      "org": "{{namespace_id}}",
      "team_name": "test-subgroup",
      "join": "invite",
      "outputs": {
        "subgroup_id": "teamId"
      },
      "account": "e2e-node-1"
    },
    {
      "name": "Mark the subgroup Restricted",
      "type": "team_update",
      "org": "{{namespace_id}}",
      "team": "{{subgroup_id}}",
      "join": "invite",
      "account": "e2e-node-1"
    },
    {
      "name": "Assert subgroup created",
      "type": "assert",
      "statements": [
        "is_set({{subgroup_id}})"
      ]
    },
    {
      "name": "Add node-2 to subgroup",
      "type": "team_add",
      "org": "{{namespace_id}}",
      "team": "{{subgroup_id}}",
      "members": [
        "{{identity_node2}}"
      ],
      "role": "member",
      "account": "e2e-node-1"
    },
    {
      "name": "List subgroup members",
      "type": "team_get",
      "org": "{{namespace_id}}",
      "team": "{{subgroup_id}}",
      "account": "e2e-node-1",
      "outputs": {
        "subgroup_members": "members"
      }
    },
    {
      "name": "Assert subgroup has members",
      "type": "assert",
      "statements": [
        "is_set({{subgroup_members}})"
      ]
    },
    {
      "name": "Create context in subgroup",
      "type": "deploy",
      "account": "e2e-node-1",
      "wasm": "{{env.CORE_WASM_DIR}}/scaffolding_e2e.wasm",
      "app_name": "Create context in subgroup",
      "org": "{{namespace_id}}",
      "access": {
        "kind": "team",
        "team": "{{subgroup_id}}"
      },
      "outputs": {
        "sub_ctx_id": "contextId"
      }
    },
    {
      "name": "Assert subgroup context created",
      "type": "assert",
      "statements": [
        "is_set({{sub_ctx_id}})"
      ]
    },
    {
      "name": "Node-2 joins subgroup context",
      "type": "whoami",
      "account": "e2e-node-2",
      "outputs": {
        "sub_ctx_key_node2": "publicKey"
      }
    },
    {
      "name": "Node-1 writes to subgroup context",
      "type": "call",
      "app": "{{sub_ctx_id}}",
      "method": "set",
      "args": {
        "key": "subgroup_key",
        "value": "from_subgroup"
      },
      "account": "e2e-node-1"
    },
    {
      "name": "Node-2 reads subgroup context value",
      "type": "call",
      "app": "{{sub_ctx_id}}",
      "method": "get",
      "args": {
        "key": "subgroup_key"
      },
      "account": "e2e-node-2",
      "outputs": {
        "subgroup_read": "rpc"
      }
    },
    {
      "name": "Assert subgroup context synced",
      "type": "json_assert",
      "statements": [
        "json_equal({{subgroup_read}}, {\"output\": \"from_subgroup\"})"
      ]
    },
    {
      "name": "Node-3 calls subgroup context (should fail - not a subgroup member)",
      "type": "call",
      "app": "{{sub_ctx_id}}",
      "method": "set",
      "args": {
        "key": "node3_key",
        "value": "should_not_work"
      },
      "account": "e2e-node-3",
      "expected_failure": true
    },
    {
      "name": "Remove node-2 from subgroup",
      "type": "team_remove",
      "org": "{{namespace_id}}",
      "team": "{{subgroup_id}}",
      "members": [
        "{{account_node2}}"
      ],
      "account": "e2e-node-1"
    },
    {
      "name": "List subgroup members after removal",
      "type": "team_get",
      "org": "{{namespace_id}}",
      "team": "{{subgroup_id}}",
      "account": "e2e-node-1",
      "outputs": {
        "subgroup_members_after": "members"
      }
    },
    {
      "name": "Assert subgroup still has admin member",
      "type": "assert",
      "statements": [
        "is_set({{subgroup_members_after}})"
      ]
    },
    {
      "name": "Node-2 writes to subgroup context after removal (should fail)",
      "type": "call",
      "app": "{{sub_ctx_id}}",
      "method": "set",
      "args": {
        "key": "revoked_key",
        "value": "should_not_work"
      },
      "account": "e2e-node-2",
      "expected_failure": true
    },
    {
      "name": "Get subgroup info",
      "type": "team_get",
      "org": "{{namespace_id}}",
      "team": "{{subgroup_id}}",
      "account": "e2e-node-1",
      "outputs": {
        "group_info_id": "groupId"
      }
    },
    {
      "name": "Assert group info describes the subgroup asked about",
      "type": "assert",
      "statements": [
        "{{group_info_id}} == {{subgroup_id}}"
      ]
    }
  ]
}
