{
  "name": "E2E KV Store - MemberRemoved Multi-Context Convergence",
  "description": "Exercises a `MemberRemoved` op against a namespace that hosts multiple contexts. The signed op carries per-context state-hash claims (one entry per registered context, sorted by context_id) plus a governance-state hash claim. On each receiver the apply path runs the post-apply verify against those claims; this test pins the happy-path \"all hashes match, no divergence, no reconcile fired, all peers converge to identical state.\"\nCatches regressions in:\n  * sign-time precompute (admin must produce the same per-context\n    hashes the receivers compute post-apply)\n  * apply-time verify (the merge-scan over the sorted context\n    list, the sentinel handling for the group-state hash, the\n    structured outcome returned up the apply pipeline)\n  * the `NamespaceApplyOutcome::Applied { divergence }` wire\n    shape (a regression that breaks the divergence field would\n    surface as either a deserialization error in the actor\n    pipeline or a spurious reconcile trigger).\n\nDoes NOT exercise the reconcile-via-anchor sync path itself — that fires only on actual mismatch, which requires a partition window to construct. See `member-removed-partition-window-reconcile.yml` for the partition variant.\n",
  "comment": [
    "Migrated from this file's v1 workflow by `merobox cloud port`.",
    "Each of the original scenario's nodes is an account here; see merobox/cloud_v2/port.py for the mapping.",
    "Dropped (no counterpart in this node):",
    "  login (unknown) x3: checks what the dropped steps did",
    "  wait_for_sync x4: replication is synchronous: a read sees every committed write"
  ],
  "cluster": {
    "nodes": 3
  },
  "accounts": [
    "e2e-node-1",
    "e2e-node-2",
    "e2e-node-3"
  ],
  "steps": [
    {
      "name": "Install application on node-1",
      "type": "upload_bundle",
      "wasm": "{{env.CORE_WASM_DIR}}/scaffolding_e2e.wasm",
      "outputs": {
        "app_id_bundle": "hash"
      },
      "account": "e2e-node-1"
    },
    {
      "type": "set",
      "values": {
        "app_id": "com.calimero.scaffolding-e2e"
      }
    },
    {
      "name": "Assert application installed",
      "type": "assert",
      "statements": [
        "is_set({{app_id}})"
      ]
    },
    {
      "name": "Create namespace on node-1",
      "type": "create_org",
      "org_name": "Create namespace on node-1",
      "outputs": {
        "namespace_id": "orgId"
      },
      "account": "e2e-node-1"
    },
    {
      "name": "Assert namespace created",
      "type": "assert",
      "statements": [
        "is_set({{namespace_id}})"
      ]
    },
    {
      "name": "Invite node-2 to namespace",
      "type": "invite",
      "org": "{{namespace_id}}",
      "role": "member",
      "account": "e2e-node-1",
      "outputs": {
        "invite_node2": "token"
      }
    },
    {
      "name": "Node-2 joins namespace",
      "type": "redeem_invite",
      "token": "{{invite_node2}}",
      "account": "e2e-node-2"
    },
    {
      "type": "whoami",
      "account": "e2e-node-2",
      "outputs": {
        "account_node2": "publicKey"
      }
    },
    {
      "name": "Invite node-3 to namespace",
      "type": "invite",
      "org": "{{namespace_id}}",
      "role": "member",
      "account": "e2e-node-1",
      "outputs": {
        "invite_node3": "token"
      }
    },
    {
      "name": "Node-3 joins namespace",
      "type": "redeem_invite",
      "token": "{{invite_node3}}",
      "account": "e2e-node-3"
    },
    {
      "type": "whoami",
      "account": "e2e-node-3",
      "outputs": {
        "identity_node3": "publicKey"
      }
    },
    {
      "name": "Create context A in namespace",
      "type": "deploy",
      "account": "e2e-node-1",
      "wasm": "{{env.CORE_WASM_DIR}}/scaffolding_e2e.wasm",
      "app_name": "Create context A in namespace",
      "org": "{{namespace_id}}",
      "outputs": {
        "ctx_a": "contextId"
      }
    },
    {
      "name": "Create context B in namespace",
      "type": "deploy",
      "account": "e2e-node-1",
      "wasm": "{{env.CORE_WASM_DIR}}/scaffolding_e2e.wasm",
      "app_name": "Create context B in namespace",
      "org": "{{namespace_id}}",
      "outputs": {
        "ctx_b": "contextId"
      }
    },
    {
      "name": "Create context C in namespace",
      "type": "deploy",
      "account": "e2e-node-1",
      "wasm": "{{env.CORE_WASM_DIR}}/scaffolding_e2e.wasm",
      "app_name": "Create context C in namespace",
      "org": "{{namespace_id}}",
      "outputs": {
        "ctx_c": "contextId"
      }
    },
    {
      "name": "Node-1 writes to context A",
      "type": "call",
      "app": "{{ctx_a}}",
      "method": "set",
      "args": {
        "key": "from_node1",
        "value": "in_ctx_a"
      },
      "account": "e2e-node-1"
    },
    {
      "name": "Node-2 writes to context B",
      "type": "call",
      "app": "{{ctx_b}}",
      "method": "set",
      "args": {
        "key": "from_node2",
        "value": "in_ctx_b"
      },
      "account": "e2e-node-2"
    },
    {
      "name": "Node-3 writes to context C",
      "type": "call",
      "app": "{{ctx_c}}",
      "method": "set",
      "args": {
        "key": "from_node3",
        "value": "in_ctx_c"
      },
      "account": "e2e-node-3"
    },
    {
      "name": "Admin (node-1) removes node-2",
      "type": "remove_member",
      "org": "{{namespace_id}}",
      "member": "{{account_node2}}",
      "account": "e2e-node-1"
    },
    {
      "name": "Confirm node-3 sees node-2 removed",
      "type": "team_list",
      "org": "{{namespace_id}}",
      "account": "e2e-node-3",
      "outputs": {
        "members_after_remove": "members"
      }
    },
    {
      "name": "Assert node-3's member list no longer contains node-2",
      "type": "assert",
      "statements": [
        "not_contains({{members_after_remove}}, {{account_node2}})"
      ]
    },
    {
      "name": "List members on node-1 for cross-check",
      "type": "team_list",
      "org": "{{namespace_id}}",
      "account": "e2e-node-1",
      "outputs": {
        "members_on_node1": "members"
      }
    },
    {
      "name": "Assert node-1 and node-3 agree on member set",
      "type": "assert",
      "statements": [
        "not_contains({{members_on_node1}}, {{account_node2}})"
      ]
    },
    {
      "name": "Node-3 reads ctx_a's earlier write",
      "type": "call",
      "app": "{{ctx_a}}",
      "method": "get",
      "args": {
        "key": "from_node1"
      },
      "account": "e2e-node-3",
      "outputs": {
        "read_a_on_node3": "rpc"
      }
    },
    {
      "name": "Assert ctx_a state is preserved on node-3 after removal",
      "type": "json_assert",
      "statements": [
        "json_equal({{read_a_on_node3}}, {\"output\": \"in_ctx_a\"})"
      ]
    }
  ]
}
