{
  "name": "E2E KV Store - Group Late Joiner State Catch-Up",
  "description": "Tests that a node joining a namespace after data already exists in a context correctly catches up to the pre-existing state. Node-1 writes several keys before node-2 joins, then node-2 joins and must see all pre-existing data as well as new writes after joining.\n",
  "comment": [
    "Migrated from this file's v1 workflow by `merobox cloud port`.",
    "Each of the original scenario's nodes is an account here; see merobox/cloud_v2/port.py for the mapping.",
    "Dropped (no counterpart in this node):",
    "  login (unknown) x2: checks what the dropped steps did",
    "  wait_for_sync x3: replication is synchronous: a read sees every committed write"
  ],
  "cluster": {
    "nodes": 3
  },
  "accounts": [
    "e2e-node-1",
    "e2e-node-2"
  ],
  "steps": [
    {
      "name": "Install application on node-1",
      "type": "upload_bundle",
      "wasm": "{{env.CORE_WASM_DIR}}/scaffolding_e2e.wasm",
      "outputs": {
        "app_id_bundle": "hash"
      },
      "account": "e2e-node-1"
    },
    {
      "type": "set",
      "values": {
        "app_id": "com.calimero.scaffolding-e2e"
      }
    },
    {
      "name": "Assert application installed",
      "type": "assert",
      "statements": [
        "is_set({{app_id}})"
      ]
    },
    {
      "name": "Create namespace on node-1",
      "type": "create_org",
      "org_name": "Create namespace on node-1",
      "outputs": {
        "namespace_id": "orgId"
      },
      "account": "e2e-node-1"
    },
    {
      "name": "Create context in namespace on node-1",
      "type": "deploy",
      "account": "e2e-node-1",
      "wasm": "{{env.CORE_WASM_DIR}}/scaffolding_e2e.wasm",
      "app_name": "Create context in namespace on node-1",
      "org": "{{namespace_id}}",
      "outputs": {
        "ctx_id": "contextId"
      }
    },
    {
      "name": "Node-1 writes pre-join key-1",
      "type": "call",
      "app": "{{ctx_id}}",
      "method": "set",
      "args": {
        "key": "pre_join_1",
        "value": "written_before_join"
      },
      "account": "e2e-node-1"
    },
    {
      "name": "Node-1 writes pre-join key-2",
      "type": "call",
      "app": "{{ctx_id}}",
      "method": "set",
      "args": {
        "key": "pre_join_2",
        "value": "also_before_join"
      },
      "account": "e2e-node-1"
    },
    {
      "name": "Node-1 writes pre-join key-3",
      "type": "call",
      "app": "{{ctx_id}}",
      "method": "set",
      "args": {
        "key": "pre_join_3",
        "value": "third_before_join"
      },
      "account": "e2e-node-1"
    },
    {
      "name": "Create namespace invitation for node-2",
      "type": "invite",
      "org": "{{namespace_id}}",
      "role": "member",
      "account": "e2e-node-1",
      "outputs": {
        "namespace_invitation": "token"
      }
    },
    {
      "name": "Node-2 joins namespace",
      "type": "redeem_invite",
      "token": "{{namespace_invitation}}",
      "account": "e2e-node-2"
    },
    {
      "name": "Node-2 reads pre-join key-1",
      "type": "call",
      "app": "{{ctx_id}}",
      "method": "get",
      "args": {
        "key": "pre_join_1"
      },
      "account": "e2e-node-2",
      "outputs": {
        "pre1_node2": "rpc"
      }
    },
    {
      "name": "Assert pre-join key-1 on node-2",
      "type": "json_assert",
      "statements": [
        "json_equal({{pre1_node2}}, {\"output\": \"written_before_join\"})"
      ]
    },
    {
      "name": "Node-2 reads pre-join key-2",
      "type": "call",
      "app": "{{ctx_id}}",
      "method": "get",
      "args": {
        "key": "pre_join_2"
      },
      "account": "e2e-node-2",
      "outputs": {
        "pre2_node2": "rpc"
      }
    },
    {
      "name": "Assert pre-join key-2 on node-2",
      "type": "json_assert",
      "statements": [
        "json_equal({{pre2_node2}}, {\"output\": \"also_before_join\"})"
      ]
    },
    {
      "name": "Node-2 reads pre-join key-3",
      "type": "call",
      "app": "{{ctx_id}}",
      "method": "get",
      "args": {
        "key": "pre_join_3"
      },
      "account": "e2e-node-2",
      "outputs": {
        "pre3_node2": "rpc"
      }
    },
    {
      "name": "Assert pre-join key-3 on node-2",
      "type": "json_assert",
      "statements": [
        "json_equal({{pre3_node2}}, {\"output\": \"third_before_join\"})"
      ]
    },
    {
      "name": "Node-1 writes post-join key",
      "type": "call",
      "app": "{{ctx_id}}",
      "method": "set",
      "args": {
        "key": "post_join",
        "value": "written_after_join"
      },
      "account": "e2e-node-1"
    },
    {
      "name": "Node-2 reads post-join key",
      "type": "call",
      "app": "{{ctx_id}}",
      "method": "get",
      "args": {
        "key": "post_join"
      },
      "account": "e2e-node-2",
      "outputs": {
        "post_join_node2": "rpc"
      }
    },
    {
      "name": "Assert post-join key on node-2",
      "type": "json_assert",
      "statements": [
        "json_equal({{post_join_node2}}, {\"output\": \"written_after_join\"})"
      ]
    },
    {
      "name": "Node-2 writes after joining",
      "type": "call",
      "app": "{{ctx_id}}",
      "method": "set",
      "args": {
        "key": "node2_post_join",
        "value": "node2_wrote_this"
      },
      "account": "e2e-node-2"
    },
    {
      "name": "Node-1 reads node-2 post-join key",
      "type": "call",
      "app": "{{ctx_id}}",
      "method": "get",
      "args": {
        "key": "node2_post_join"
      },
      "account": "e2e-node-1",
      "outputs": {
        "node2_post_join_node1": "rpc"
      }
    },
    {
      "name": "Assert node-2 post-join write visible on node-1",
      "type": "json_assert",
      "statements": [
        "json_equal({{node2_post_join_node1}}, {\"output\": \"node2_wrote_this\"})"
      ]
    },
    {
      "name": "Node-1 reads entry count",
      "type": "call",
      "app": "{{ctx_id}}",
      "method": "len",
      "args": {},
      "account": "e2e-node-1",
      "outputs": {
        "len_node1": "rpc"
      }
    },
    {
      "name": "Node-2 reads entry count",
      "type": "call",
      "app": "{{ctx_id}}",
      "method": "len",
      "args": {},
      "account": "e2e-node-2",
      "outputs": {
        "len_node2": "rpc"
      }
    },
    {
      "name": "Assert both nodes see same entry count",
      "type": "json_assert",
      "statements": [
        "json_equal({{len_node1}}, {{len_node2}})"
      ]
    }
  ]
}
