{
  "name": "E2E KV Store - Leave Namespace (Cascade)",
  "description": "Tests `leave_namespace`: voluntary self-leave at the namespace root cascades through every descendant subgroup where the leaver has a direct row. Single MemberLeft op at the root drives the whole subtree on every peer.\n",
  "comment": [
    "Migrated from this file's v1 workflow by `merobox cloud port`.",
    "Each of the original scenario's nodes is an account here; see merobox/cloud_v2/port.py for the mapping.",
    "Dropped (no counterpart in this node):",
    "  login (unknown) x2: checks what the dropped steps did"
  ],
  "cluster": {
    "nodes": 3
  },
  "accounts": [
    "e2e-node-1",
    "e2e-node-2"
  ],
  "steps": [
    {
      "name": "Install application on node-1",
      "type": "upload_bundle",
      "wasm": "{{env.CORE_WASM_DIR}}/scaffolding_e2e.wasm",
      "outputs": {
        "app_id_bundle": "hash"
      },
      "account": "e2e-node-1"
    },
    {
      "type": "set",
      "values": {
        "app_id": "com.calimero.scaffolding-e2e"
      }
    },
    {
      "name": "Create namespace on node-1",
      "type": "create_org",
      "org_name": "Create namespace on node-1",
      "outputs": {
        "namespace_id": "orgId"
      },
      "account": "e2e-node-1"
    },
    {
      "name": "Invite node-2 to namespace",
      "type": "invite",
      "org": "{{namespace_id}}",
      "role": "member",
      "account": "e2e-node-1",
      "outputs": {
        "invite_node2": "token"
      }
    },
    {
      "name": "Node-2 joins namespace",
      "type": "redeem_invite",
      "token": "{{invite_node2}}",
      "account": "e2e-node-2"
    },
    {
      "type": "whoami",
      "account": "e2e-node-2",
      "outputs": {
        "identity_node2": "publicKey",
        "account_node2": "publicKey"
      }
    },
    {
      "name": "Get node-1's account",
      "type": "whoami",
      "outputs": {
        "account_node1": "publicKey"
      },
      "account": "e2e-node-1"
    },
    {
      "name": "Create subgroup A",
      "type": "create_team",
      "org": "{{namespace_id}}",
      "team_name": "leave-namespace-subgroup-a",
      "join": "invite",
      "outputs": {
        "subgroup_a_id": "teamId"
      },
      "account": "e2e-node-1"
    },
    {
      "name": "Create subgroup B",
      "type": "create_team",
      "org": "{{namespace_id}}",
      "team_name": "leave-namespace-subgroup-b",
      "join": "invite",
      "outputs": {
        "subgroup_b_id": "teamId"
      },
      "account": "e2e-node-1"
    },
    {
      "name": "Add node-2 to subgroup A",
      "type": "team_add",
      "org": "{{namespace_id}}",
      "team": "{{subgroup_a_id}}",
      "members": [
        "{{identity_node2}}"
      ],
      "role": "member",
      "account": "e2e-node-1"
    },
    {
      "name": "Add node-2 to subgroup B",
      "type": "team_add",
      "org": "{{namespace_id}}",
      "team": "{{subgroup_b_id}}",
      "members": [
        "{{identity_node2}}"
      ],
      "role": "member",
      "account": "e2e-node-1"
    },
    {
      "name": "List subgroup-A members before leave",
      "type": "team_get",
      "org": "{{namespace_id}}",
      "team": "{{subgroup_a_id}}",
      "account": "e2e-node-1",
      "outputs": {
        "subgroup_a_before": "members"
      }
    },
    {
      "name": "Assert node-2 is in subgroup-A before leave",
      "type": "assert",
      "statements": [
        "contains({{subgroup_a_before}}, {{account_node2}})"
      ]
    },
    {
      "name": "List subgroup-B members before leave",
      "type": "team_get",
      "org": "{{namespace_id}}",
      "team": "{{subgroup_b_id}}",
      "account": "e2e-node-1",
      "outputs": {
        "subgroup_b_before": "members"
      }
    },
    {
      "name": "Assert node-2 is in subgroup-B before leave",
      "type": "assert",
      "statements": [
        "contains({{subgroup_b_before}}, {{account_node2}})"
      ]
    },
    {
      "name": "Node-2 leaves namespace",
      "type": "remove_member",
      "org": "{{namespace_id}}",
      "member": "e2e-node-2",
      "account": "e2e-node-2"
    },
    {
      "name": "Wait for cascade MemberLeft to propagate to node-1",
      "type": "wait",
      "seconds": 10.0
    },
    {
      "name": "List namespace members on node-1",
      "type": "team_list",
      "org": "{{namespace_id}}",
      "account": "e2e-node-1",
      "outputs": {
        "ns_members_after": "members"
      }
    },
    {
      "name": "Assert node-2 absent from namespace membership",
      "type": "assert",
      "statements": [
        "not_contains({{ns_members_after}}, {{account_node2}})",
        "contains({{ns_members_after}}, {{account_node1}})"
      ]
    },
    {
      "name": "List subgroup-A members on node-1",
      "type": "team_get",
      "org": "{{namespace_id}}",
      "team": "{{subgroup_a_id}}",
      "account": "e2e-node-1",
      "outputs": {
        "subgroup_a_after": "members"
      }
    },
    {
      "name": "Assert node-2 absent from subgroup-A but node-1 still present",
      "type": "assert",
      "statements": [
        "not_contains({{subgroup_a_after}}, {{account_node2}})",
        "contains({{subgroup_a_after}}, {{account_node1}})"
      ]
    },
    {
      "name": "List subgroup-B members on node-1",
      "type": "team_get",
      "org": "{{namespace_id}}",
      "team": "{{subgroup_b_id}}",
      "account": "e2e-node-1",
      "outputs": {
        "subgroup_b_after": "members"
      }
    },
    {
      "name": "Assert node-2 absent from subgroup-B but node-1 still present",
      "type": "assert",
      "statements": [
        "not_contains({{subgroup_b_after}}, {{account_node2}})",
        "contains({{subgroup_b_after}}, {{account_node1}})"
      ]
    }
  ]
}
