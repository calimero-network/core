{
  "name": "Frozen + RGA convergence repro",
  "description": "Focused repro for the frozen-storage sync divergence (#scaffolding-e2e \"Frozen data cannot be updated\" split-brain). A frozen entry added early syncs cleanly, but a later multi-collection op sequence (RGA document edits + a title change) makes one node's view of that earlier frozen entry diverge: `compare_trees` emits an `Action::Update` for the frozen element, which the storage layer categorically rejects, and the node can never reconcile. This workflow isolates that sequence with explicit cross-node convergence checks so the failure surfaces directly at the final `wait_for_sync` instead of being buried in the full e2e suite.\n",
  "comment": [
    "Migrated from this file's v1 workflow by `merobox cloud port`.",
    "Each of the original scenario's nodes is an account here; see merobox/cloud_v2/port.py for the mapping.",
    "Dropped (no counterpart in this node):",
    "  login (unknown) x3: checks what the dropped steps did",
    "  wait_for_sync x6: replication is synchronous: a read sees every committed write"
  ],
  "cluster": {
    "nodes": 3
  },
  "accounts": [
    "e2e-node-1",
    "e2e-node-2",
    "e2e-node-3"
  ],
  "steps": [
    {
      "name": "Install application on node-1",
      "type": "upload_bundle",
      "wasm": "{{env.CORE_WASM_DIR}}/scaffolding_e2e.wasm",
      "outputs": {
        "app_id_bundle": "hash"
      },
      "account": "e2e-node-1"
    },
    {
      "type": "set",
      "values": {
        "app_id": "com.calimero.scaffolding-e2e"
      }
    },
    {
      "name": "Create mesh with node-2",
      "type": "create_org",
      "account": "e2e-node-1",
      "org_name": "mesh",
      "outputs": {
        "group_id": "orgId"
      }
    },
    {
      "type": "set",
      "values": {
        "namespace_id": "{{group_id}}"
      }
    },
    {
      "type": "invite",
      "account": "e2e-node-1",
      "org": "{{group_id}}",
      "role": "member",
      "outputs": {
        "_mesh_invite": "token"
      }
    },
    {
      "type": "redeem_invite",
      "account": "e2e-node-2",
      "token": "{{_mesh_invite}}"
    },
    {
      "name": "Create mesh with node-2",
      "type": "deploy",
      "account": "e2e-node-1",
      "org": "{{group_id}}",
      "wasm": "{{env.CORE_WASM_DIR}}/scaffolding_e2e.wasm",
      "app_name": "Create mesh with node-2",
      "outputs": {
        "context_id": "contextId",
        "node1_key": "memberPublicKey"
      }
    },
    {
      "name": "Create namespace invitation for node-3",
      "type": "invite",
      "org": "{{group_id}}",
      "role": "member",
      "account": "e2e-node-1",
      "outputs": {
        "open_invitation_3": "token"
      }
    },
    {
      "name": "Join namespace - node-3",
      "type": "redeem_invite",
      "token": "{{open_invitation_3}}",
      "account": "e2e-node-3"
    },
    {
      "type": "whoami",
      "account": "e2e-node-3",
      "outputs": {
        "node3_key": "publicKey"
      }
    },
    {
      "name": "Add frozen value on node-1",
      "type": "call",
      "app": "{{context_id}}",
      "method": "add_frozen",
      "args": {
        "value": "Immutable data"
      },
      "account": "e2e-node-1",
      "outputs": {
        "frozen_hash": "result"
      }
    },
    {
      "name": "Get frozen value on node-3 (sanity - synced cleanly)",
      "type": "call",
      "app": "{{context_id}}",
      "method": "get_frozen",
      "args": {
        "hash_hex": "{{frozen_hash}}"
      },
      "account": "e2e-node-3",
      "outputs": {
        "frozen_value_node3": "rpc"
      }
    },
    {
      "name": "Assert frozen value present on node-3",
      "type": "json_assert",
      "statements": [
        "json_equal({{frozen_value_node3}}, {\"output\": \"Immutable data\"})"
      ]
    },
    {
      "name": "RGA insert text on node-1",
      "type": "call",
      "app": "{{context_id}}",
      "method": "rga_insert_text",
      "args": {
        "position": 0,
        "text": "Hello"
      },
      "account": "e2e-node-1"
    },
    {
      "name": "RGA append text on node-2",
      "type": "call",
      "app": "{{context_id}}",
      "method": "rga_append_text",
      "args": {
        "text": " brave new World"
      },
      "account": "e2e-node-2"
    },
    {
      "name": "RGA append text on node-3",
      "type": "call",
      "app": "{{context_id}}",
      "method": "rga_append_text",
      "args": {
        "text": " of frozen bugs"
      },
      "account": "e2e-node-3"
    },
    {
      "name": "RGA delete text on node-1",
      "type": "call",
      "app": "{{context_id}}",
      "method": "rga_delete_text",
      "args": {
        "start": 0,
        "end": 5
      },
      "account": "e2e-node-1"
    },
    {
      "name": "Set document title on node-1",
      "type": "call",
      "app": "{{context_id}}",
      "method": "rga_set_title",
      "args": {
        "new_title": "E2E Test Document"
      },
      "account": "e2e-node-1"
    },
    {
      "name": "Get frozen value on node-2 after title change",
      "type": "call",
      "app": "{{context_id}}",
      "method": "get_frozen",
      "args": {
        "hash_hex": "{{frozen_hash}}"
      },
      "account": "e2e-node-2",
      "outputs": {
        "frozen_after_node2": "rpc"
      }
    },
    {
      "name": "Assert frozen value still present on node-2",
      "type": "json_assert",
      "statements": [
        "json_equal({{frozen_after_node2}}, {\"output\": \"Immutable data\"})"
      ]
    },
    {
      "name": "Get frozen value on node-3 after title change",
      "type": "call",
      "app": "{{context_id}}",
      "method": "get_frozen",
      "args": {
        "hash_hex": "{{frozen_hash}}"
      },
      "account": "e2e-node-3",
      "outputs": {
        "frozen_after_node3": "rpc"
      }
    },
    {
      "name": "Assert frozen value still present on node-3",
      "type": "json_assert",
      "statements": [
        "json_equal({{frozen_after_node3}}, {\"output\": \"Immutable data\"})"
      ]
    }
  ]
}
