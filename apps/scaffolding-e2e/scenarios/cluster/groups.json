{
  "name": "E2E KV Store - Group Lifecycle Tests",
  "description": "Tests group creation, group invitation, join group, join group context, multi-context groups, and context invitation within groups.\n",
  "comment": [
    "Migrated from this file's v1 workflow by `merobox cloud port`.",
    "Each of the original scenario's nodes is an account here; see merobox/cloud_v2/port.py for the mapping.",
    "Dropped (no counterpart in this node):",
    "  login (unknown) x2: checks what the dropped steps did",
    "  wait_for_sync x4: replication is synchronous: a read sees every committed write"
  ],
  "cluster": {
    "nodes": 3
  },
  "accounts": [
    "e2e-node-1",
    "e2e-node-2"
  ],
  "steps": [
    {
      "name": "Install application on node-1",
      "type": "upload_bundle",
      "wasm": "{{env.CORE_WASM_DIR}}/scaffolding_e2e.wasm",
      "outputs": {
        "app_id_bundle": "hash"
      },
      "account": "e2e-node-1"
    },
    {
      "type": "set",
      "values": {
        "app_id": "com.calimero.scaffolding-e2e"
      }
    },
    {
      "name": "Assert application installed",
      "type": "assert",
      "statements": [
        "is_set({{app_id}})"
      ]
    },
    {
      "name": "Create namespace on node-1",
      "type": "create_org",
      "org_name": "Create namespace on node-1",
      "outputs": {
        "namespace_id": "orgId"
      },
      "account": "e2e-node-1"
    },
    {
      "name": "Assert namespace created",
      "type": "assert",
      "statements": [
        "is_set({{namespace_id}})"
      ]
    },
    {
      "name": "Create context 1 in namespace on node-1",
      "type": "deploy",
      "account": "e2e-node-1",
      "wasm": "{{env.CORE_WASM_DIR}}/scaffolding_e2e.wasm",
      "app_name": "Create context 1 in namespace on node-1",
      "org": "{{namespace_id}}",
      "outputs": {
        "ctx1_id": "contextId",
        "ctx1_key_node1": "memberPublicKey"
      }
    },
    {
      "name": "Create namespace invitation on node-1",
      "type": "invite",
      "org": "{{namespace_id}}",
      "role": "member",
      "account": "e2e-node-1",
      "outputs": {
        "namespace_invitation": "token"
      }
    },
    {
      "name": "Node-2 joins namespace",
      "type": "redeem_invite",
      "token": "{{namespace_invitation}}",
      "account": "e2e-node-2"
    },
    {
      "type": "whoami",
      "account": "e2e-node-2",
      "outputs": {
        "member_identity_node2": "publicKey"
      }
    },
    {
      "name": "Node-1 writes to context 1",
      "type": "call",
      "app": "{{ctx1_id}}",
      "method": "set",
      "args": {
        "key": "group_key1",
        "value": "from_node1"
      },
      "account": "e2e-node-1"
    },
    {
      "name": "Node-2 reads from context 1",
      "type": "call",
      "app": "{{ctx1_id}}",
      "method": "get",
      "args": {
        "key": "group_key1"
      },
      "account": "e2e-node-2",
      "outputs": {
        "get_result_1": "rpc"
      }
    },
    {
      "name": "Assert node-1 value synced to node-2",
      "type": "json_assert",
      "statements": [
        "json_equal({{get_result_1}}, {\"output\": \"from_node1\"})"
      ]
    },
    {
      "name": "Node-2 writes to context 1",
      "type": "call",
      "app": "{{ctx1_id}}",
      "method": "set",
      "args": {
        "key": "group_key2",
        "value": "from_node2"
      },
      "account": "e2e-node-2"
    },
    {
      "name": "Node-1 reads node-2 value",
      "type": "call",
      "app": "{{ctx1_id}}",
      "method": "get",
      "args": {
        "key": "group_key2"
      },
      "account": "e2e-node-1",
      "outputs": {
        "get_result_2": "rpc"
      }
    },
    {
      "name": "Assert node-2 value synced to node-1",
      "type": "json_assert",
      "statements": [
        "json_equal({{get_result_2}}, {\"output\": \"from_node2\"})"
      ]
    },
    {
      "name": "Create context 3 in same namespace",
      "type": "deploy",
      "account": "e2e-node-1",
      "wasm": "{{env.CORE_WASM_DIR}}/scaffolding_e2e.wasm",
      "app_name": "Create context 3 in same namespace",
      "org": "{{namespace_id}}",
      "outputs": {
        "ctx3_id": "contextId",
        "ctx3_key_node1": "memberPublicKey"
      }
    },
    {
      "name": "Node-2 joins context 3 via group membership",
      "type": "whoami",
      "account": "e2e-node-2",
      "outputs": {
        "ctx3_key_node2": "publicKey"
      }
    },
    {
      "name": "Node-2 writes to context 3",
      "type": "call",
      "app": "{{ctx3_id}}",
      "method": "set",
      "args": {
        "key": "ctx3_test",
        "value": "invite_join_works"
      },
      "account": "e2e-node-2"
    },
    {
      "name": "Node-1 reads from context 3",
      "type": "call",
      "app": "{{ctx3_id}}",
      "method": "get",
      "args": {
        "key": "ctx3_test"
      },
      "account": "e2e-node-1",
      "outputs": {
        "ctx3_get_result": "rpc"
      }
    },
    {
      "name": "Assert context invitation join works",
      "type": "json_assert",
      "statements": [
        "json_equal({{ctx3_get_result}}, {\"output\": \"invite_join_works\"})"
      ]
    }
  ]
}
