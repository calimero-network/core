{
  "name": "Simple Sync Test (No Handlers)",
  "description": "Basic set/get sync test without event handlers",
  "comment": [
    "Migrated from this file's v1 workflow by `merobox cloud port`.",
    "Each of the original scenario's nodes is an account here; see merobox/cloud_v2/port.py for the mapping.",
    "Dropped (no counterpart in this node):",
    "  wait_for_sync x2: replication is synchronous: a read sees every committed write"
  ],
  "cluster": {
    "nodes": 3
  },
  "accounts": [
    "e2e-node-1",
    "e2e-node-2"
  ],
  "steps": [
    {
      "name": "Install application on node-1",
      "type": "upload_bundle",
      "wasm": "{{env.CORE_WASM_DIR}}/scaffolding_e2e.wasm",
      "outputs": {
        "app_id_bundle": "hash"
      },
      "account": "e2e-node-1"
    },
    {
      "type": "set",
      "values": {
        "app_id": "com.calimero.scaffolding-e2e"
      }
    },
    {
      "name": "Create mesh with node-2",
      "type": "create_org",
      "account": "e2e-node-1",
      "org_name": "mesh",
      "outputs": {
        "namespace_id": "orgId"
      }
    },
    {
      "type": "invite",
      "account": "e2e-node-1",
      "org": "{{namespace_id}}",
      "role": "member",
      "outputs": {
        "_mesh_invite": "token"
      }
    },
    {
      "type": "redeem_invite",
      "account": "e2e-node-2",
      "token": "{{_mesh_invite}}"
    },
    {
      "name": "Create mesh with node-2",
      "type": "deploy",
      "account": "e2e-node-1",
      "org": "{{namespace_id}}",
      "wasm": "{{env.CORE_WASM_DIR}}/scaffolding_e2e.wasm",
      "app_name": "Create mesh with node-2",
      "outputs": {
        "context_id": "contextId",
        "node1_key": "memberPublicKey"
      }
    },
    {
      "name": "Set value on node-1",
      "type": "call",
      "app": "{{context_id}}",
      "method": "set",
      "args": {
        "key": "test_key",
        "value": "test_value"
      },
      "account": "e2e-node-1"
    },
    {
      "name": "Get value on node-2",
      "type": "call",
      "app": "{{context_id}}",
      "method": "get",
      "args": {
        "key": "test_key"
      },
      "account": "e2e-node-2",
      "outputs": {
        "result": "rpc"
      }
    },
    {
      "name": "Assert value synced",
      "type": "json_assert",
      "statements": [
        "json_equal({{result}}, {\"output\": \"test_value\"})"
      ]
    },
    {
      "name": "Set value on node-2",
      "type": "call",
      "app": "{{context_id}}",
      "method": "set",
      "args": {
        "key": "from_node2",
        "value": "node2_value"
      },
      "account": "e2e-node-2"
    },
    {
      "name": "Get node-2 value on node-1",
      "type": "call",
      "app": "{{context_id}}",
      "method": "get",
      "args": {
        "key": "from_node2"
      },
      "account": "e2e-node-1",
      "outputs": {
        "result2": "rpc"
      }
    },
    {
      "name": "Assert node-2 value synced to node-1",
      "type": "json_assert",
      "statements": [
        "json_equal({{result2}}, {\"output\": \"node2_value\"})"
      ]
    }
  ]
}
