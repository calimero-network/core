{
  "name": "E2E Account - Removing An Account From A Restricted Subgroup Shuts Out Its Paired Device",
  "description": "Node 2 founds a namespace and opens a Restricted subgroup holding node 1 and node 4. Node 3 is paired into node 1's account and proves it works by joining and reading the subgroup's context. Node 2 then removes node 1's account from the subgroup and opens a second context there. Node 4 still joins and reads it; node 1 and its paired node 3 must both fail to join it, and node 3 can no longer read the first context, which node 2 wrote into after the removal.\n",
  "comment": [
    "Migrated from this file's v1 workflow by `merobox cloud port`.",
    "Each of the original scenario's nodes is an account here; see merobox/cloud_v2/port.py for the mapping.",
    "Dropped (no counterpart in this node):",
    "  login (unknown) x4: checks what the dropped steps did",
    "  node_identity output accountNamespaceId (v1 device key) x1: checks what the dropped steps did",
    "  wait_for_sync x5: replication is synchronous: a read sees every committed write"
  ],
  "cluster": {
    "nodes": 3
  },
  "accounts": [
    "removed-paired-1",
    "removed-paired-2",
    "removed-paired-3",
    "removed-paired-4"
  ],
  "steps": [
    {
      "name": "Install the application on node-2",
      "type": "upload_bundle",
      "wasm": "{{env.CORE_WASM_DIR}}/scaffolding_e2e.wasm",
      "outputs": {
        "app_bundle": "hash"
      },
      "account": "removed-paired-2"
    },
    {
      "type": "set",
      "values": {
        "app": "com.calimero.scaffolding-e2e"
      }
    },
    {
      "name": "Node-2 creates the namespace",
      "type": "create_org",
      "org_name": "Node-2 creates the namespace",
      "outputs": {
        "namespace_id": "orgId"
      },
      "account": "removed-paired-2"
    },
    {
      "name": "Invite node-1 to the namespace",
      "type": "invite",
      "org": "{{namespace_id}}",
      "role": "member",
      "account": "removed-paired-2",
      "outputs": {
        "invite_node1": "token"
      }
    },
    {
      "name": "Node-1 joins the namespace",
      "type": "redeem_invite",
      "token": "{{invite_node1}}",
      "account": "removed-paired-1"
    },
    {
      "type": "whoami",
      "account": "removed-paired-1",
      "outputs": {
        "account_node1": "publicKey"
      }
    },
    {
      "name": "Invite node-4 to the namespace",
      "type": "invite",
      "org": "{{namespace_id}}",
      "role": "member",
      "account": "removed-paired-2",
      "outputs": {
        "invite_node4": "token"
      }
    },
    {
      "name": "Node-4 joins the namespace",
      "type": "redeem_invite",
      "token": "{{invite_node4}}",
      "account": "removed-paired-4"
    },
    {
      "type": "whoami",
      "account": "removed-paired-4",
      "outputs": {
        "account_node4": "publicKey"
      }
    },
    {
      "name": "Node-2 creates a Restricted subgroup",
      "type": "create_team",
      "org": "{{namespace_id}}",
      "team_name": "team",
      "join": "invite",
      "outputs": {
        "team_group": "teamId"
      },
      "account": "removed-paired-2"
    },
    {
      "name": "Node-2 marks the subgroup Restricted",
      "type": "team_update",
      "org": "{{namespace_id}}",
      "team": "{{team_group}}",
      "join": "invite",
      "account": "removed-paired-2"
    },
    {
      "name": "Node-2 adds node-1 and node-4 to the subgroup",
      "type": "team_add",
      "org": "{{namespace_id}}",
      "team": "{{team_group}}",
      "members": [
        "{{account_node1}}"
      ],
      "role": "member",
      "account": "removed-paired-2"
    },
    {
      "name": "Node-2 adds node-1 and node-4 to the subgroup",
      "type": "team_add",
      "org": "{{namespace_id}}",
      "team": "{{team_group}}",
      "members": [
        "{{account_node4}}"
      ],
      "role": "member",
      "account": "removed-paired-2"
    },
    {
      "name": "Node-2 creates a context in the subgroup",
      "type": "deploy",
      "account": "removed-paired-2",
      "wasm": "{{env.CORE_WASM_DIR}}/scaffolding_e2e.wasm",
      "app_name": "Node-2 creates a context in the subgroup",
      "org": "{{namespace_id}}",
      "access": {
        "kind": "team",
        "team": "{{team_group}}"
      },
      "outputs": {
        "first_ctx": "contextId"
      }
    },
    {
      "name": "Node-2 writes into the subgroup's context",
      "type": "call",
      "app": "{{first_ctx}}",
      "method": "set",
      "args": {
        "key": "first_key",
        "value": "before_removal"
      },
      "account": "removed-paired-2"
    },
    {
      "name": "What node-1 speaks as",
      "type": "whoami",
      "outputs": {
        "root_key": "publicKey"
      },
      "account": "removed-paired-1"
    },
    {
      "name": "Pair node-3 into node-1's account, naming only the account namespace",
      "type": "add_device",
      "account": "removed-paired-1",
      "device": "removed-paired-3"
    },
    {
      "name": "Node-2 removes node-1's account from the subgroup",
      "type": "team_remove",
      "org": "{{namespace_id}}",
      "team": "{{team_group}}",
      "members": [
        "{{account_node1}}"
      ],
      "account": "removed-paired-2"
    },
    {
      "name": "Node-2 writes into the first context after the removal",
      "type": "call",
      "app": "{{first_ctx}}",
      "method": "set",
      "args": {
        "key": "first_key",
        "value": "after_removal"
      },
      "account": "removed-paired-2"
    },
    {
      "name": "Node-2 creates a second context in the subgroup",
      "type": "deploy",
      "account": "removed-paired-2",
      "wasm": "{{env.CORE_WASM_DIR}}/scaffolding_e2e.wasm",
      "app_name": "Node-2 creates a second context in the subgroup",
      "org": "{{namespace_id}}",
      "access": {
        "kind": "team",
        "team": "{{team_group}}"
      },
      "outputs": {
        "second_ctx": "contextId"
      }
    },
    {
      "name": "Node-2 writes into the second context",
      "type": "call",
      "app": "{{second_ctx}}",
      "method": "set",
      "args": {
        "key": "second_key",
        "value": "after_removal"
      },
      "account": "removed-paired-2"
    },
    {
      "name": "Node-1, removed, cannot join the second context",
      "type": "http",
      "method": "get",
      "path": "apps/{{second_ctx}}",
      "account": "removed-paired-1",
      "expected_failure": true
    },
    {
      "name": "Node-3, a device of the removed account, cannot join the second context",
      "type": "http",
      "method": "get",
      "path": "apps/{{second_ctx}}",
      "account": "removed-paired-3",
      "expected_failure": true
    },
    {
      "name": "Node-3 can no longer read the first context",
      "type": "call",
      "app": "{{first_ctx}}",
      "method": "get",
      "args": {
        "key": "first_key"
      },
      "account": "removed-paired-3",
      "expected_failure": true
    }
  ]
}
