{
  "name": "E2E KV Store - Governance Late Joiner Catch-Up",
  "description": "Node-1 alone sets default capabilities on a namespace before any peer exists — this governance op must apply locally (best-effort publish). Node-2 then joins late and must inherit the capability value via sync, proving \"applied locally + propagated via sync\".\n",
  "comment": [
    "Migrated from this file's v1 workflow by `merobox cloud port`.",
    "Each of the original scenario's nodes is an account here; see merobox/cloud_v2/port.py for the mapping.",
    "Dropped (no counterpart in this node):",
    "  login (unknown) x2: checks what the dropped steps did",
    "  wait_for_sync x1: replication is synchronous: a read sees every committed write"
  ],
  "cluster": {
    "nodes": 3
  },
  "accounts": [
    "e2e-node-1",
    "e2e-node-2"
  ],
  "steps": [
    {
      "name": "Install application on node-1",
      "type": "upload_bundle",
      "wasm": "{{env.CORE_WASM_DIR}}/scaffolding_e2e.wasm",
      "outputs": {
        "app_id_bundle": "hash"
      },
      "account": "e2e-node-1"
    },
    {
      "type": "set",
      "values": {
        "app_id": "com.calimero.scaffolding-e2e"
      }
    },
    {
      "name": "Assert application installed",
      "type": "assert",
      "statements": [
        "is_set({{app_id}})"
      ]
    },
    {
      "name": "Create namespace on node-1",
      "type": "create_org",
      "org_name": "Create namespace on node-1",
      "outputs": {
        "namespace_id": "orgId"
      },
      "account": "e2e-node-1"
    },
    {
      "name": "Assert namespace created",
      "type": "assert",
      "statements": [
        "is_set({{namespace_id}})"
      ]
    },
    {
      "name": "Create context in namespace on node-1",
      "type": "deploy",
      "account": "e2e-node-1",
      "wasm": "{{env.CORE_WASM_DIR}}/scaffolding_e2e.wasm",
      "app_name": "Create context in namespace on node-1",
      "org": "{{namespace_id}}",
      "outputs": {
        "ctx_id": "contextId"
      }
    },
    {
      "name": "Assert context created",
      "type": "assert",
      "statements": [
        "is_set({{ctx_id}})"
      ]
    },
    {
      "name": "Node-1 sets default capabilities while solo",
      "type": "capabilities",
      "org": "{{namespace_id}}",
      "capabilities": 0,
      "account": "e2e-node-1"
    },
    {
      "name": "Create namespace invitation for node-2",
      "type": "invite",
      "org": "{{namespace_id}}",
      "role": "member",
      "account": "e2e-node-1",
      "outputs": {
        "namespace_invitation": "token"
      }
    },
    {
      "name": "Node-2 joins namespace",
      "type": "redeem_invite",
      "token": "{{namespace_invitation}}",
      "account": "e2e-node-2"
    },
    {
      "type": "whoami",
      "account": "e2e-node-2",
      "outputs": {
        "member_account_node2": "publicKey"
      }
    },
    {
      "name": "Get node-2 capabilities as seen by node-2",
      "type": "member_capabilities",
      "org": "{{namespace_id}}",
      "member": "{{member_account_node2}}",
      "account": "e2e-node-2",
      "outputs": {
        "node2_caps": "capabilities"
      }
    },
    {
      "name": "Assert node-2 inherited the solo-set default (caps=0)",
      "type": "json_assert",
      "statements": [
        "json_equal({{node2_caps}}, 0)"
      ]
    },
    {
      "name": "Get node-2 capabilities as seen by node-1",
      "type": "member_capabilities",
      "org": "{{namespace_id}}",
      "member": "{{member_account_node2}}",
      "account": "e2e-node-1",
      "outputs": {
        "node2_caps_view_node1": "capabilities"
      }
    },
    {
      "name": "Assert both nodes agree on node-2 capabilities",
      "type": "json_assert",
      "statements": [
        "json_equal({{node2_caps_view_node1}}, 0)"
      ]
    }
  ]
}
