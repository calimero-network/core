{
  "name": "E2E KV Store - A Founder Who Transfers Ownership Stays An Admin",
  "description": "Node-1's account founds a namespace, makes node-2's account an Admin, and hands the namespace to it. The former owner stays an Admin on both nodes: node-1 still lists the namespace and its members, node-2 sees both accounts as Admins, and node-1 can still leave. Node-1 can no longer transfer the namespace.\n",
  "comment": [
    "Migrated from this file's v1 workflow by `merobox cloud port`.",
    "Each of the original scenario's nodes is an account here; see merobox/cloud_v2/port.py for the mapping.",
    "Dropped (no counterpart in this node):",
    "  assert_api_response x5: v1 admin API",
    "  login (unknown) x2: checks what the dropped steps did",
    "  wait_for_sync x1: replication is synchronous: a read sees every committed write"
  ],
  "cluster": {
    "nodes": 3
  },
  "accounts": [
    "transfer-owner-node-1",
    "transfer-owner-node-2"
  ],
  "steps": [
    {
      "name": "Install application on node-1",
      "type": "upload_bundle",
      "wasm": "{{env.CORE_WASM_DIR}}/scaffolding_e2e.wasm",
      "outputs": {
        "app_id_bundle": "hash"
      },
      "account": "transfer-owner-node-1"
    },
    {
      "type": "set",
      "values": {
        "app_id": "com.calimero.scaffolding-e2e"
      }
    },
    {
      "name": "Get node-1's account",
      "type": "whoami",
      "outputs": {
        "account_node1": "publicKey"
      },
      "account": "transfer-owner-node-1"
    },
    {
      "name": "Create namespace on node-1",
      "type": "create_org",
      "org_name": "Create namespace on node-1",
      "outputs": {
        "namespace_id": "orgId"
      },
      "account": "transfer-owner-node-1"
    },
    {
      "name": "Invite node-2",
      "type": "invite",
      "org": "{{namespace_id}}",
      "role": "member",
      "account": "transfer-owner-node-1",
      "outputs": {
        "invitation": "token"
      }
    },
    {
      "name": "Node-2 joins the namespace",
      "type": "redeem_invite",
      "token": "{{invitation}}",
      "account": "transfer-owner-node-2"
    },
    {
      "type": "whoami",
      "account": "transfer-owner-node-2",
      "outputs": {
        "account_node2": "publicKey"
      }
    },
    {
      "name": "Promote node-2 to Admin",
      "type": "set_role",
      "org": "{{namespace_id}}",
      "member": "{{account_node2}}",
      "role": "admin",
      "account": "transfer-owner-node-1"
    },
    {
      "name": "Node-1 hands the namespace to node-2",
      "type": "set_role",
      "org": "{{namespace_id}}",
      "member": "{{account_node2}}",
      "role": "owner",
      "account": "transfer-owner-node-1"
    },
    {
      "name": "Node-1 is no longer the owner and cannot transfer again",
      "type": "set_role",
      "org": "{{namespace_id}}",
      "member": "{{account_node1}}",
      "role": "owner",
      "account": "transfer-owner-node-1",
      "expected_failure": true
    },
    {
      "name": "Node-1 leaves the namespace",
      "type": "remove_member",
      "org": "{{namespace_id}}",
      "member": "transfer-owner-node-1",
      "account": "transfer-owner-node-1"
    },
    {
      "name": "Wait for the leave to reach node-2",
      "type": "wait",
      "seconds": 10.0
    },
    {
      "name": "Node-2 lists the namespace members",
      "type": "team_list",
      "org": "{{namespace_id}}",
      "account": "transfer-owner-node-2",
      "outputs": {
        "members_after_leave": "members"
      }
    },
    {
      "name": "Assert node-1 left and node-2 stayed",
      "type": "assert",
      "statements": [
        "not_contains({{members_after_leave}}, {{account_node1}})",
        "contains({{members_after_leave}}, {{account_node2}})"
      ]
    }
  ]
}
