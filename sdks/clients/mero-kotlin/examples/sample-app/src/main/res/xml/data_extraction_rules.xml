<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+: nothing leaves the device, neither to a cloud backup nor in a device-to-device
  transfer (which ignores allowBackup="false"). The preferences hold the node URL and the session;
  the session is encrypted under a Keystore key that never moves, so a copy would only be reset.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
