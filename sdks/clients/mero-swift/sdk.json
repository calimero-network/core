{
  "name": "mero-swift",
  "kind": "client",
  "language": "swift",
  "published": [
    {"registry": "swiftpm", "name": "calimero-network/swift-sdk", "note": "read-only mirror: git subtree split of this directory, tagged VERSION"}
  ],
  "version_files": [
    {"path": "README.md", "format": "regex", "pattern": "calimero-network/swift-sdk\", exact: \"([^\"]+)\""},
    {"path": "docs/src/content/docs/get-started/quickstart.mdx", "format": "regex", "pattern": "calimero-network/swift-sdk\", exact: \"([^\"]+)\""}
  ],
  "depends_on": [],
  "inputs": ["docs/public/openapi.json"],
  "generate": "scripts/generate-openapi.sh",
  "generated": ["Sources/MeroAPI/Generated", "Sources/MeroKit/Api/Generated"],
  "workflow": ".github/workflows/sdk-mero-swift.yml"
}
