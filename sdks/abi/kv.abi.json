          "string"
        ],
        [
          "keys",
          "list<string>"
        ]
      ],
      "public": false,
      "returns": "list<option<EntryView>>"
    },
    "grant": {
      "allowSystem": false,
      "confirm": true,
      "doc": "Gives `principal` `right` (`read`, `write` or `admin`) on `bucket`. Bucket admins\nand store admins. `admin` goes only to people; on a `servicesOnly` bucket `read` and\n`write` go only to keys and apps.",
      "kind": "call",
      "params": [
        [
          "bucket",
          "string"
        ],
        [
          "principal",
          "string"
        ],
        [
          "right",
          "string"
        ]
      ],
      "public": false,
      "returns": null
    },
    "grants": {
      "allowApps": [
        "*"
      ],
      "allowSystem": false,
      "confirm": false,
      "doc": "Every grant on `bucket`. Its admins (the instance that created the store, on\n`default`) and store admins.",
      "kind": "view",
      "params": [
        [
          "bucket",
          "string"
        ]
      ],
      "public": false,
      "returns": "list<GrantView>"
    },
    "init": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Creates the `default` bucket with the owner as its admin. Run as a member of an app's\nunit, it also grants that app (`env::unit_of()`) `read`, `write` and `admin` on it.",
      "kind": "init",
      "params": [],
      "public": false,
      "returns": null
    },
