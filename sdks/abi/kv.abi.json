      "allowApps": [
        "*"
      ],
      "allowSystem": false,
      "confirm": false,
      "doc": "The value under `key`, or `null` when it is absent or expired. Needs `read`.",
      "kind": "view",
      "params": [
        [
          "bucket",
          "string"
        ],
        [
          "key",
          "string"
        ]
      ],
      "public": false,
