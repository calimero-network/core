    "delete": {
      "allowApps": [
        "*"
      ],
      "allowSystem": false,
      "confirm": false,
      "doc": "Removes `key`; with `expectedVersion`, only if the entry is at it. Whether a value\nwas removed. Needs `write` (and `read` with `expectedVersion`).",
      "kind": "call",
      "params": [
        [
          "bucket",
          "string"
        ],
        [
          "key",
          "string"
        ],
        [
          "expectedVersion",
          "option<u64>"
        ]
      ],
      "public": false,
      "returns": "bool"
    },
    "deleteBucket": {
      "allowSystem": false,
      "confirm": true,
      "doc": "Removes an empty bucket and its grants. Bucket admins.",
      "kind": "call",
      "params": [
        [
          "name",
          "string"
        ]
      ],
      "public": false,
      "returns": null
    },
    "deleteConfirmed": {
      "allowSystem": false,
      "confirm": true,
      "doc": "`delete` with a passkey. Needs `write` (and `read` with `expectedVersion`).",
