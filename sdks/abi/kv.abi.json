    "set": {
      "allowApps": [
        "*"
      ],
      "allowSystem": false,
      "confirm": false,
      "doc": "Stores `value` under `key`, expiring after `ttlMs` when given. Needs `write`.\nReturns the entry's new version.",
      "kind": "call",
      "params": [
        [
          "bucket",
          "string"
        ],
        [
          "key",
          "string"
        ],
        [
          "value",
          "string"
        ],
        [
          "ttlMs",
          "option<u64>"
        ]
      ],
      "public": false,
      "returns": "u64"
    },
    "setAccess": {
      "allowSystem": false,
      "confirm": true,
      "doc": "Sets `principal`'s rights on `bucket` to exactly `role`'s: `view` is `read`, `edit`\n`read` and `write`, `manage` all three, `none` none. Grants and revokes only what\ndiffers, as `grant` and `revoke` would, all or nothing. On a `servicesOnly` bucket,\n`manage` gives people `admin` alone. Bucket admins and store admins.",
      "kind": "call",
      "params": [
        [
          "bucket",
          "string"
        ],
        [
          "principal",
          "string"
        ],
        [
          "role",
          "Access"
        ]
      ],
      "public": false,
      "returns": null
    },
    "setAppAlone": {
      "allowSystem": false,
      "confirm": true,
      "doc": "Whether an app's grant alone admits it to `bucket`, with no person behind the call.\nBucket admins and store admins.",
      "kind": "call",
      "params": [
        [
          "bucket",
          "string"
        ],
        [
          "appAlone",
          "bool"
        ]
      ],
      "public": false,
      "returns": null
    },
    "setConfirmed": {
      "allowSystem": false,
      "confirm": true,
      "doc": "`set` with a passkey: the only write a `passkeyWrites` bucket takes. Needs `write`;\nwith `expectedVersion`, only if the entry is at it (`\"0\"`: only if absent), and\n`read` too.",
      "kind": "call",
      "params": [
        [
          "bucket",
          "string"
        ],
        [
          "key",
          "string"
        ],
        [
          "value",
          "string"
        ],
        [
          "ttlMs",
          "option<u64>"
        ],
        [
          "expectedVersion",
          "option<u64>"
        ]
      ],
      "public": false,
      "returns": "u64"
    },
    "setIf": {
      "allowApps": [
        "*"
      ],
      "allowSystem": false,
      "confirm": false,
      "doc": "`set` only if the entry is at `expectedVersion` (`\"0\"`: only if absent);\n`Conflict { current }` otherwise. Needs `read` and `write`.",
      "kind": "call",
      "params": [
        [
          "bucket",
          "string"
        ],
        [
          "key",
          "string"
        ],
        [
          "value",
          "string"
        ],
        [
          "expectedVersion",
          "u64"
        ],
        [
          "ttlMs",
          "option<u64>"
        ]
      ],
      "public": false,
      "returns": "u64"
    },
    "setMany": {
      "allowApps": [
        "*"
      ],
      "allowSystem": false,
      "confirm": false,
      "doc": "Stores up to 100 entries, all or none. Needs `write`. Returns the last version.",
      "kind": "call",
      "params": [
        [
          "bucket",
          "string"
        ],
        [
          "entries",
          "list<SetItem>"
        ]
      ],
      "public": false,
      "returns": "u64"
    },
    "sweepExpired": {
      "allowSystem": true,
      "confirm": false,
      "doc": "Deletes up to 500 expired entries, oldest expiry first. A view runs at the time of\nthe last log entry, so an expired entry stays readable until the next write or this\nsweep: at most about ten minutes on a quiet store.",
      "every": "10m",
      "kind": "timer",
      "params": [],
      "public": false,
      "returns": null
    },
