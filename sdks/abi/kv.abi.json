    "addAdmin": {
      "allowSystem": false,
      "confirm": true,
      "doc": "Makes `account` a store admin. The owner only.",
      "kind": "call",
      "params": [
        [
          "account",
          "string"
        ]
      ],
      "public": false,
      "returns": null
