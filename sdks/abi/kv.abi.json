    "audit": {
      "allowApps": [
        "*"
      ],
      "allowSystem": false,
      "confirm": false,
      "doc": "The audit log of `bucket` (`\"\"`: the store's own changes), newest first. A bucket's:\nits admins (the instance that created the store, on `default`) and store admins; the\nstore's: store admins.",
      "kind": "view",
      "params": [
        [
          "bucket",
          "string"
        ],
        [
          "cursor",
          "option<string>"
        ],
        [
          "limit",
          "option<u32>"
        ]
      ],
      "public": false,
      "returns": "AuditPage"
    },
    "buckets": {
      "allowApps": [
        "*"
      ],
      "allowSystem": false,
      "confirm": false,
      "doc": "The buckets the caller holds any right on (every bucket for a store admin), with\nthe caller's rights on each.",
      "kind": "view",
      "params": [],
      "public": false,
      "returns": "list<BucketView>"
    },
    "changesSince": {
      "allowApps": [
        "*"
      ],
      "allowSystem": false,
      "confirm": false,
      "doc": "The writes after version `after` (`\"0\"` for every write still kept), oldest first.\n`ChangesTrimmed` when `after` is older than the bucket keeps: list the bucket again.\nNeeds `read`.",
      "kind": "view",
      "params": [
        [
          "bucket",
          "string"
        ],
        [
          "after",
          "u64"
        ],
        [
          "limit",
          "option<u32>"
        ]
      ],
      "public": false,
      "returns": "ChangesPage"
    },
    "createBucket": {
      "allowSystem": false,
      "confirm": true,
      "doc": "Creates a bucket; the caller becomes its admin. Store admins only.",
      "kind": "call",
      "params": [
        [
          "name",
          "string"
        ],
        [
          "servicesOnly",
          "option<bool>"
        ],
        [
          "passkeyWrites",
          "option<bool>"
        ],
        [
          "maxValueBytes",
          "option<u64>"
        ],
        [
          "maxEntries",
          "option<u64>"
        ],
