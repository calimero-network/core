{
  "name": "calimero-sdks",
  "private": true,
  "description": "The pnpm workspace of the JavaScript SDKs: mero-js (clients/), mero-react and the design-system packages mero-ui, mero-icons, mero-tokens and mero-charts (components/). Not published.",
  "packageManager": "pnpm@10.14.0+sha512.ad27a79641b49c3e481a16a805baa71817a04bbe06a38d17e60e2eaee83f6a146c6a688125f5792e48dd5ba30e7da52a5cda4c3992b9ccf333f9ce223af84748",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r --filter './clients/**' --filter './components/**' run build",
    "test": "pnpm -r --filter './clients/**' --filter './components/**' run test",
    "lint": "pnpm -r --filter './clients/**' --filter './components/**' run lint",
    "typecheck": "pnpm -r --filter './clients/**' --filter './components/**' run typecheck"
  },
  "pnpm": {
    "overrides": {
      "@babel/core@<7.29.6": "^7.29.6",
      "@humanfs/node@<0.16.8": "~0.16.8",
      "baseline-browser-mapping": ">=2.11.0 <3",
      "brace-expansion@<2": ">=1.1.21 <2",
      "brace-expansion@>=2 <3": "^2.1.7",
      "brace-expansion@>=4 <6": "^5.0.12",
      "browserslist": ">=4.28.7 <5",
      "flatted": ">=3.4.2 <4",
      "handlebars": ">=4.7.10 <5",
      "js-yaml@>=4 <5": ">=4.3.2 <5",
      "lodash": ">=4.18.0 <5",
      "lodash-es": ">=4.18.0 <5",
      "minimatch@<3.1.3": ">=3.1.3 <4",
      "nanoid@<4": ">=3.3.12 <4",
      "picomatch@<3": ">=2.3.2 <3",
      "picomatch@>=4 <5": ">=4.0.4 <5",
      "postcss": ">=8.5.23 <9",
      "rollup@>=4 <5": ">=4.59.0 <5",
      "source-map-js": ">=1.2.2 <2",
      "undici@<7": "^6.29.1",
      "undici@>=7 <8": ">=7.30.1 <8",
      "ws@>=8 <9": "^8.21.0"
    }
  }
}
